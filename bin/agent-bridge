#!/usr/bin/env bash
# agent-bridge — 跨 tmux pane 的 agent 任務委派橋（core MVP）
#
# 機制：檔案系統 mailbox（AGENT_BRIDGE_DATA）＋ tmux send-keys 短通知。
# 通知只送一行短指令（agent-bridge receive/read <task-id>），
# 絕不把訊息內容放進 send-keys。
set -euo pipefail

DATA_DIR="${AGENT_BRIDGE_DATA:-$HOME/.local/share/agent-bridge}"
AGENTS_DIR="$DATA_DIR/agents"
TASKS_DIR="$DATA_DIR/tasks"
LOCKS_DIR="$DATA_DIR/locks"

NAME_RE='^[A-Za-z0-9_-]+$'
TASK_ID_RE='^[A-Za-z0-9._-]+$'
# registry 的 pane_id 對本程式是不可信輸入（資料目錄對每個 worker 都可寫），
# 而它會被餵給 tmux。tmux 命令字串裡 `;` 是命令分隔符，
# 一個 pane_id 寫成 `%1 ; kill-server` 就能殺掉整個 server
PANE_RE='^%[0-9]+$'

# worker brief：spawn 出來的 runtime 是一個全新、零脈絡的 session——它不知道
# 自己是 worker，也不知道 pane 裡收到的 `agent-bridge receive <id>` 是要執行的
# 命令而非有人在跟它說話。實測（codex 0.145）會把就緒探針當成對話反覆回覆
# 文字、永遠不 ready。故啟動時把這份守則當 initial prompt 注入。
# 正本是一份檔而不是內嵌字串：人工註冊的 worker 讀同一份，兩邊不會漂移。
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
REPO_ROOT="$(dirname "$(dirname "$SCRIPT_PATH")")"
WORKER_BRIEF="${AGENT_BRIDGE_WORKER_BRIEF:-$REPO_ROOT/share/worker-brief.md}"

err()  { printf 'agent-bridge: %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }
info() { printf '%s\n' "$*" >&2; }

usage() {
  cat >&2 <<'EOF'
用法：
  agent-bridge register <agent> <tmux-target>   註冊 agent 與其 tmux pane
  agent-bridge unregister <agent>               移除 agent 註冊
  agent-bridge list                             列出已註冊 agent（name<TAB>pane_id<TAB>ready）
  agent-bridge send <agent> --from <sender> (--message <text> | --message-file <path>)
                                                委派任務；stdout 只印 task-id
  agent-bridge receive <task-id>                取出任務（標頭走 stderr、request 原文走 stdout）
  agent-bridge start <task-id>                  （worker）標記開工（delivered → running）
  agent-bridge reply <task-id> (--message <text> | --message-file <path>)
                                                回覆任務（delivered/running 可回）
  agent-bridge fail <task-id> (--message <text> | --message-file <path>)
                                                回報任務失敗（delivered/running 可；訊息＝失敗原因）
  agent-bridge cancel <task-id>                 取消任務（queued/delivered/running 可）
  agent-bridge status <task-id>                 印裸狀態字（queued/delivered/running/completed/failed/cancelled）
  agent-bridge read <task-id>                   讀回覆（completed/failed 可；標頭走 stderr、response 原文走 stdout）
  agent-bridge await <task-id> [--timeout <secs>]
                                                阻塞等待 task 到終態，印裸狀態字後 exit 0；逾時非零退出
  agent-bridge spawn <name> --runtime codex [--window]
                                                spawn 一個 worker pane 並註冊；stdout 只印 pane-id
  agent-bridge despawn <name>                   回收 spawn 出身的 worker（kill pane＋除名；人工註冊拒殺）
  agent-bridge ready <name>                     （worker）回報就緒；僅限 spawned agent

--message-file 用 `-` 表示讀 stdin。
資料目錄預設 ~/.local/share/agent-bridge/，可用 AGENT_BRIDGE_DATA 覆蓋。
await 輪詢間隔預設 1 秒，可用 AGENT_BRIDGE_POLL_INTERVAL 覆蓋；--timeout 0（預設）＝不逾時。
spawn 上限 AGENT_BRIDGE_MAX_SPAWN（預設 4）；就緒等待 AGENT_BRIDGE_READY_TIMEOUT
秒（預設 30，0＝不等待），探針重送間隔 AGENT_BRIDGE_READY_PROBE_INTERVAL（預設 2）。
EOF
}

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

rand_suffix() { head -c 2 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

ensure_dirs() { mkdir -p "$AGENTS_DIR" "$TASKS_DIR" "$LOCKS_DIR"; }

# is_spawned <registry-file>：0＝spawn 出身，1＝不是，2＝無法判定（JSON 損壞／讀不到）
# 直接用 `jq -e '.spawned == true'` 會把「條件為 false」與「檔案是壞的」壓成同一個
# 非零，出身判斷因此 fail-open：一份損壞的 registry 會被當成人工註冊而遭覆寫或除名
is_spawned() {
  local f="$1" out
  # 非 object 的合法 JSON（例如字面 null）也算判不出來：那不是一份 registry，
  # 當成「人工註冊」就會被覆寫或除名
  out="$(jq -r 'if type != "object" then "bad" elif .spawned == true then "yes" else "no" end' \
    "$f" 2>/dev/null)" || return 2
  case "$out" in
    yes) return 0 ;;
    no)  return 1 ;;
    *)   return 2 ;;
  esac
}

require_jq() {
  command -v jq >/dev/null 2>&1 \
    || die "缺少硬依賴 jq，請先安裝（例如 pacman -S jq）"
}

# atomic_write <dest>：內容從 stdin，同檔案系統 mktemp + mv 保證原子性
atomic_write() {
  local dest="$1" tmp
  tmp="$(mktemp "$(dirname "$dest")/.tmp.XXXXXX")"
  cat > "$tmp"
  mv "$tmp" "$dest"
}

# ---- 鎖：mkdir lock，短暫重試後報錯 ----
LOCK_DIR=""

release_lock() {
  if [[ -n "$LOCK_DIR" && -d "$LOCK_DIR" ]]; then
    # 解不掉的鎖會擋住之後每一次同類操作。吞掉這個失敗＝留下一把沒人知道
    # 存在的鎖（例如鎖目錄被塞了檔案，rmdir 就會 Directory not empty）
    rmdir "$LOCK_DIR" 2>/dev/null \
      || err "警告：無法釋放鎖目錄 $LOCK_DIR（非空或權限問題），它會擋住後續操作，請手動移除"
  fi
  LOCK_DIR=""
}

acquire_lock() {
  local id="$1" tries=0 lock err
  lock="$LOCKS_DIR/$id.lock"
  until mkdir "$lock" 2>/dev/null; do
    # mkdir 失敗但鎖目錄不存在＝不是佔用，是權限/sandbox/檔案系統問題；
    # 重試無意義，帶出 mkdir 的真正錯誤原因（例：codex sandbox 擋
    # workspace 外寫入時，誤報「佔用中」會把人引去查錯方向）
    if [[ ! -d "$lock" ]]; then
      if err="$(mkdir "$lock" 2>&1)"; then
        break
      fi
      die "無法建立鎖目錄（非鎖佔用，疑似權限或 sandbox 寫入限制）：$err"
    fi
    tries=$((tries + 1))
    if (( tries >= 25 )); then
      die "無法取得鎖（locks/$id.lock 佔用中或殘留），請稍後重試"
    fi
    sleep 0.2
  done
  LOCK_DIR="$lock"
  trap release_lock EXIT
}

# log_event <task-id> <event> [detail]：append-only events.log
log_event() {
  local id="$1" ev="$2" detail="${3:-}" line
  line="$(now_iso) $ev"
  if [[ -n "$detail" ]]; then
    line="$line $detail"
  fi
  printf '%s\n' "$line" >> "$TASKS_DIR/$id/events.log"
}

# update_meta_status <task-dir> <new-status>：同步更新 metadata.json 與 status 檔
update_meta_status() {
  local dir="$1" new="$2" ts updated
  ts="$(now_iso)"
  updated="$(jq --arg s "$new" --arg t "$ts" '.status = $s | .updated_at = $t' "$dir/metadata.json")"
  printf '%s\n' "$updated" | atomic_write "$dir/metadata.json"
  printf '%s\n' "$new" | atomic_write "$dir/status"
}

# write_message <dest> <mode:text|file> <value>；file 模式的 `-` 讀 stdin
write_message() {
  local dest="$1" mode="$2" val="$3"
  if [[ "$mode" == "text" ]]; then
    printf '%s\n' "$val" | atomic_write "$dest"
  elif [[ "$val" == "-" ]]; then
    atomic_write "$dest"
  else
    [[ -f "$val" ]] || die "找不到訊息檔：$val"
    atomic_write "$dest" < "$val"
  fi
}

# notify_pane <pane_id> <one-line-cmd>：先驗證 pane 存活再 send-keys；失敗回非零
# Enter 與文字拆成兩次送並隔一小段延遲：agent REPL（claude/codex 等 TUI）
# 會把同批抵達的文字+Enter 當成貼上，Enter 被吞掉導致指令留在輸入框不送出
notify_pane() {
  local pane="$1" cmd="$2"
  [[ "$pane" =~ $PANE_RE ]] || return 1
  command -v tmux >/dev/null 2>&1 || return 1
  tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -Fx "$pane" >/dev/null || return 1
  tmux send-keys -t "$pane" "$cmd" 2>/dev/null || return 1
  sleep "${AGENT_BRIDGE_NOTIFY_DELAY:-0.3}"
  tmux send-keys -t "$pane" Enter 2>/dev/null
}

check_task_id() {
  local id="$1"
  [[ "$id" =~ $TASK_ID_RE ]] || die "task-id 不合法：$id"
}

# ---- 指令 ----

cmd_register() {
  (( $# == 2 )) || die "用法：agent-bridge register <agent> <tmux-target>"
  local name="$1" target="$2" pane ts doc
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  command -v tmux >/dev/null 2>&1 || die "找不到 tmux，register 需要 tmux"
  if ! pane="$(tmux display -pt "$target" '#{pane_id}' 2>/dev/null)" || [[ -z "$pane" ]]; then
    die "無法解析 tmux target：$target"
  fi
  ts="$(now_iso)"
  doc="$(jq -n --arg name "$name" --arg pane "$pane" --arg ts "$ts" \
    '{name: $name, pane_id: $pane, registered_at: $ts}')"
  # 取 registry 鎖再寫：與 spawn/despawn/ready 互斥。覆寫 spawned agent 會洗掉
  # 出身標記（pane 變成殺不掉的孤兒，且能誘使 despawn 殺到人工 pane），故拒絕
  acquire_lock agents-registry
  if [[ -e "$AGENTS_DIR/$name.json" ]]; then
    local sp_rc=0
    is_spawned "$AGENTS_DIR/$name.json" || sp_rc=$?
    case $sp_rc in
      0) die "agent '$name' 是 spawn 出身的 worker，register 拒絕覆寫（要換 pane 請先 despawn）" ;;
      2) die "agent '$name' 的 registry 無法解析，出身不明，register 拒絕覆寫；請確認 $AGENTS_DIR/$name.json 後手動處理" ;;
    esac
  fi
  printf '%s\n' "$doc" | atomic_write "$AGENTS_DIR/$name.json"
  release_lock
  info "已註冊 agent '$name' → pane $pane"
}

cmd_unregister() {
  (( $# == 1 )) || die "用法：agent-bridge unregister <agent>"
  local name="$1"
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  local f="$AGENTS_DIR/$name.json"
  # 鎖內檢查：單純除名 spawned agent 會留下沒人認領的 pane，且讓 cap 少算一個
  acquire_lock agents-registry
  [[ -f "$f" ]] || die "未註冊的 agent：$name"
  local sp_rc=0
  is_spawned "$f" || sp_rc=$?
  case $sp_rc in
    0) die "agent '$name' 是 spawn 出身的 worker，unregister 拒絕（請用 despawn 一併回收 pane）" ;;
    2) die "agent '$name' 的 registry 無法解析，出身不明，unregister 拒絕（若它其實是 spawned，除名會留下沒人回收的 pane）；請確認 $f 後手動處理" ;;
  esac
  rm -- "$f"
  release_lock
  info "已移除 agent '$name' 的註冊"
}

cmd_list() {
  local f name pane ready
  shopt -s nullglob
  for f in "$AGENTS_DIR"/*.json; do
    name="$(jq -r '.name' "$f")"
    pane="$(jq -r '.pane_id' "$f")"
    # ready 欄：人工註冊 `-`；spawned 依 .ready 顯示 starting/ready
    ready="$(jq -r 'if .spawned == true
                    then (if .ready == true then "ready" else "starting" end)
                    else "-" end' "$f")"
    printf '%s\t%s\t%s\n' "$name" "$pane" "$ready"
  done
}

cmd_send() {
  (( $# >= 1 )) || die "用法：agent-bridge send <agent> --from <sender> (--message <text> | --message-file <path>)"
  local to="$1"; shift
  local from="" mode="" val=""
  while (( $# > 0 )); do
    case "$1" in
      --from)
        shift; (( $# > 0 )) || die "--from 需要參數"
        from="$1" ;;
      --message)
        shift; (( $# > 0 )) || die "--message 需要參數"
        [[ -z "$mode" ]] || die "--message 與 --message-file 只能擇一"
        mode="text"; val="$1" ;;
      --message-file)
        shift; (( $# > 0 )) || die "--message-file 需要參數"
        [[ -z "$mode" ]] || die "--message 與 --message-file 只能擇一"
        mode="file"; val="$1" ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  [[ -n "$from" ]] || die "send 需要 --from <sender>"
  [[ -n "$mode" ]] || die "send 需要 --message 或 --message-file"
  [[ "$to" =~ $NAME_RE ]]   || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$to"
  [[ "$from" =~ $NAME_RE ]] || die "sender 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$from"

  local agent_file="$AGENTS_DIR/$to.json"
  [[ -f "$agent_file" ]] || die "未註冊的 agent：$to（先用 agent-bridge register）"
  if jq -e '.spawned == true and .ready != true' "$agent_file" >/dev/null 2>&1; then
    err "警告：agent '$to' 尚未回報就緒（starting），通知可能延後；訊息已入 mailbox 不會遺失"
  fi
  local pane; pane="$(jq -r '.pane_id' "$agent_file")"

  local task_id dir tries=0
  while :; do
    task_id="$(date -u +%Y%m%dT%H%M%SZ)-$(rand_suffix)"
    dir="$TASKS_DIR/$task_id"
    if mkdir "$dir" 2>/dev/null; then
      break
    fi
    tries=$((tries + 1))
    (( tries < 5 )) || die "無法建立 task 目錄（task-id 連續碰撞）"
  done

  write_message "$dir/request.md" "$mode" "$val"

  local ts wd doc
  ts="$(now_iso)"
  wd="$(pwd)"
  doc="$(jq -n --arg id "$task_id" --arg from "$from" --arg to "$to" \
              --arg ts "$ts" --arg wd "$wd" \
    '{version: 1, task_id: $id, from: $from, to: $to,
      created_at: $ts, updated_at: $ts,
      working_directory: $wd, status: "queued"}')"
  printf '%s\n' "$doc" | atomic_write "$dir/metadata.json"
  printf 'queued\n' | atomic_write "$dir/status"
  log_event "$task_id" created "from=$from to=$to"

  if notify_pane "$pane" "agent-bridge receive $task_id"; then
    log_event "$task_id" notified "pane=$pane cmd=receive"
  else
    log_event "$task_id" notify-failed "pane=$pane cmd=receive"
    err "警告：無法通知 $to（pane $pane）；請手動在對方 session 執行：agent-bridge receive $task_id"
  fi

  printf '%s\n' "$task_id"
}

cmd_receive() {
  (( $# == 1 )) || die "用法：agent-bridge receive <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  acquire_lock "$id"
  local st; st="$(<"$dir/status")"
  case "$st" in
    queued)
      update_meta_status "$dir" delivered
      log_event "$id" delivered
      ;;
    delivered|running)
      log_event "$id" re-receive
      ;;
    *)
      die "task 狀態為 $st，無法 receive（僅 queued/delivered/running 可）"
      ;;
  esac
  release_lock

  local from wd
  from="$(jq -r '.from' "$dir/metadata.json")"
  wd="$(jq -r '.working_directory' "$dir/metadata.json")"
  {
    printf 'task-id: %s\n' "$id"
    printf 'from: %s\n' "$from"
    printf 'working_directory: %s\n' "$wd"
  } >&2
  cat "$dir/request.md"
}

# parse_message_opts <cmd-name> <args...>：解析 --message / --message-file，
# 結果放進 MSG_MODE / MSG_VAL（bash 函式無法回傳多值，走全域）
MSG_MODE=""
MSG_VAL=""
parse_message_opts() {
  local cmdname="$1"; shift
  MSG_MODE=""; MSG_VAL=""
  while (( $# > 0 )); do
    case "$1" in
      --message)
        shift; (( $# > 0 )) || die "--message 需要參數"
        [[ -z "$MSG_MODE" ]] || die "--message 與 --message-file 只能擇一"
        MSG_MODE="text"; MSG_VAL="$1" ;;
      --message-file)
        shift; (( $# > 0 )) || die "--message-file 需要參數"
        [[ -z "$MSG_MODE" ]] || die "--message 與 --message-file 只能擇一"
        MSG_MODE="file"; MSG_VAL="$1" ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  [[ -n "$MSG_MODE" ]] || die "$cmdname 需要 --message 或 --message-file"
}

# respond_task <id> <final-status> <event> <cmd-name>：reply / fail 的共用主體——
# 寫 response.md、轉終態、通知 sender 讀回覆（訊息內容取自 MSG_MODE/MSG_VAL）
respond_task() {
  local id="$1" final="$2" ev="$3" cmdname="$4"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  acquire_lock "$id"
  local st; st="$(<"$dir/status")"
  if [[ "$st" != "delivered" && "$st" != "running" ]]; then
    die "task 狀態為 $st，僅 delivered/running 可 $cmdname（queued 請先 receive；終態不可再變更）"
  fi
  write_message "$dir/response.md" "$MSG_MODE" "$MSG_VAL"
  update_meta_status "$dir" "$final"
  log_event "$id" "$ev"
  release_lock

  local from; from="$(jq -r '.from' "$dir/metadata.json")"
  if [[ -f "$AGENTS_DIR/$from.json" ]]; then
    local pane; pane="$(jq -r '.pane_id' "$AGENTS_DIR/$from.json")"
    if notify_pane "$pane" "agent-bridge read $id"; then
      log_event "$id" notified "pane=$pane cmd=read"
    else
      log_event "$id" notify-failed "pane=$pane cmd=read"
      err "警告：無法通知 $from（pane $pane）；請手動在對方 session 執行：agent-bridge read $id"
    fi
  fi
}

cmd_reply() {
  (( $# >= 1 )) || die "用法：agent-bridge reply <task-id> (--message <text> | --message-file <path>)"
  local id="$1"; shift
  check_task_id "$id"
  parse_message_opts reply "$@"
  respond_task "$id" completed replied reply
  info "已回覆 task $id（completed）"
}

cmd_fail() {
  (( $# >= 1 )) || die "用法：agent-bridge fail <task-id> (--message <text> | --message-file <path>)"
  local id="$1"; shift
  check_task_id "$id"
  parse_message_opts fail "$@"
  respond_task "$id" failed failed fail
  info "已回報 task $id 失敗（failed）"
}

cmd_start() {
  (( $# == 1 )) || die "用法：agent-bridge start <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  acquire_lock "$id"
  local st; st="$(<"$dir/status")"
  if [[ "$st" != "delivered" ]]; then
    die "task 狀態為 $st，僅 delivered 可 start（queued 請先 receive）"
  fi
  update_meta_status "$dir" running
  log_event "$id" started
  release_lock
  info "task $id 開工（running）"
}

cmd_cancel() {
  (( $# == 1 )) || die "用法：agent-bridge cancel <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  acquire_lock "$id"
  local st; st="$(<"$dir/status")"
  case "$st" in
    queued|delivered|running) ;;
    *) die "task 狀態為 $st，無法 cancel（僅 queued/delivered/running 可）" ;;
  esac
  update_meta_status "$dir" cancelled
  log_event "$id" cancelled
  release_lock

  # 通知 worker 查狀態（會看到 cancelled）；通知失敗不影響取消本身
  local to; to="$(jq -r '.to' "$dir/metadata.json")"
  if [[ -f "$AGENTS_DIR/$to.json" ]]; then
    local pane; pane="$(jq -r '.pane_id' "$AGENTS_DIR/$to.json")"
    if notify_pane "$pane" "agent-bridge status $id"; then
      log_event "$id" notified "pane=$pane cmd=status"
    else
      log_event "$id" notify-failed "pane=$pane cmd=status"
      err "警告：無法通知 $to（pane $pane）；對方查 status $id 時會看到 cancelled"
    fi
  fi
  info "已取消 task $id（cancelled）"
}

cmd_status() {
  (( $# == 1 )) || die "用法：agent-bridge status <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"
  printf '%s\n' "$(<"$dir/status")"
}

cmd_read() {
  (( $# == 1 )) || die "用法：agent-bridge read <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  local st; st="$(<"$dir/status")"
  case "$st" in
    completed|failed) ;;
    cancelled)
      die "task $id 已取消（cancelled），沒有回覆可讀"
      ;;
    *)
      die "task $id 尚未回覆（狀態：$st）；查詢進度請用 agent-bridge status $id"
      ;;
  esac

  local from to
  from="$(jq -r '.from' "$dir/metadata.json")"
  to="$(jq -r '.to' "$dir/metadata.json")"
  {
    printf 'task-id: %s\n' "$id"
    printf 'from: %s\n' "$from"
    printf 'to: %s\n' "$to"
  } >&2
  log_event "$id" read
  cat "$dir/response.md"
}

# await：sender 端的等待原語。唯讀輪詢 status 檔（不寫 events、不取鎖），
# 在只讀 sandbox 內也能用；設計給「送出後在背景等回覆」的用法。
cmd_await() {
  (( $# >= 1 )) || die "用法：agent-bridge await <task-id> [--timeout <secs>]"
  local id="$1"; shift
  check_task_id "$id"
  local timeout=0
  while (( $# > 0 )); do
    case "$1" in
      --timeout)
        shift; (( $# > 0 )) || die "--timeout 需要參數"
        # 10# 強制十進位：前導零（08）否則會被 Bash 算術當八進位而爆錯；
        # 位數上限同時擋掉 64 位算術溢位
        [[ "$1" =~ ^[0-9]{1,9}$ ]] || die "--timeout 需為非負整數（秒，至多 9 位），0＝不逾時：$1"
        timeout=$((10#$1)) ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  local interval="${AGENT_BRIDGE_POLL_INTERVAL:-1}" st
  SECONDS=0
  while :; do
    st="$(<"$dir/status")"
    case "$st" in
      completed|failed|cancelled)
        printf '%s\n' "$st"
        return 0
        ;;
    esac
    if (( timeout > 0 && SECONDS >= timeout )); then
      die "await 逾時（${timeout}s）：task $id 目前狀態 $st"
    fi
    sleep "$interval"
  done
}

# ---- spawn / despawn：worker pane 生命週期 ----

# 審計：$DATA_DIR/agents.log 追加 <ts> spawned|despawned <name> <pane> <runtime>
log_agent_event() {
  local action="$1" name="$2" pane="$3" runtime="$4"
  printf '%s %s %s %s %s\n' "$(now_iso)" "$action" "$name" "$pane" "$runtime" \
    >> "$DATA_DIR/agents.log"
}

# spawn 失敗回滾：EXIT trap 讀取。解除回滾靠單一旗標而非逐一清空三個變數——
# 訊號可能落在兩次賦值之間，讓 trap 看到「有 tag、沒有 registry 路徑」這種
# 半清空狀態，於是殺了 pane 卻留下 registry
SPAWN_DONE=0
SPAWN_RB_PANE=""
SPAWN_RB_REG=""
SPAWN_RB_TAG=""
# rb_kill_tagged <pane>：原子地「驗 tag 才殺」，並確認 pane 真的消失。
# 與 cmd_despawn 同一套理由——分成「查一次、再殺一次」的話，中間 tmux server
# 若被替換，第二次呼叫會殺到新 server 上同 id 的人工 pane。回傳 0＝已不存在
# shellcheck disable=SC2329  # 經 spawn_rollback 間接呼叫
rb_kill_tagged() {
  local p="$1" after
  [[ "$p" =~ $PANE_RE ]] || return 1
  tmux if-shell -t "$p" -F "#{m:\"$SPAWN_RB_TAG *,#{pane_start_command}}" \
    "kill-pane -t $p" 2>/dev/null || true
  # 查詢失敗要回報「無法確認」而不是「已消失」：把 tmux 掛掉當成 pane 不見了，
  # 正是 despawn 那條被揪出來的錯誤判斷方向
  after="$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null)" || return 1
  ! grep -Fx "$p" <<< "$after" >/dev/null
}

# shellcheck disable=SC2329  # 經 EXIT trap 間接呼叫
spawn_rollback() {
  # spawn 已完成：單一旗標，讀到就整個 no-op
  (( SPAWN_DONE == 1 )) && return 0
  # 全程容錯：本函式在 EXIT trap 的第一順位，任一步以非零收場都會在 set -e
  # 下吃掉後面的 release_lock，留下鎖殘留
  if [[ -n "$SPAWN_RB_TAG" ]]; then
    if [[ -n "$SPAWN_RB_PANE" ]]; then
      rb_kill_tagged "$SPAWN_RB_PANE" \
        || err "警告：回滾未能關閉 pane $SPAWN_RB_PANE，請手動確認後 tmux kill-pane -t $SPAWN_RB_PANE"
    else
      # pane 已建立但 pane id 沒回到手上（命令替換失敗、輸出遺失、中途被中斷）：
      # 靠啟動指令裡的一次性 tag 掃出孤兒 pane，否則它永遠沒人認領。
      # 比對必須錨在啟動指令**開頭**（tag 是我們自己加的 env 前綴）：無邊界的
      # 子字串比對會誤殺任何參數裡碰巧含這串的別人 pane
      # 查詢失敗不能吞：迴圈跑零次跟「沒有孤兒」長得一模一樣，
      # 靜默下去就是留一個沒人認領的 pane 卻宣稱回滾乾淨
      local pid cmd scan
      if scan="$(tmux list-panes -a -F '#{pane_id} #{pane_start_command}' 2>/dev/null)"; then
        while read -r pid cmd; do
          # tmux 會把整條啟動指令加雙引號存進 pane_start_command（實測 3.7b），
          # 先剝掉前導引號才錨得住開頭
          cmd="${cmd#\"}"
          if [[ "$cmd" == "$SPAWN_RB_TAG "* ]]; then
            rb_kill_tagged "$pid" \
              || err "警告：回滾未能關閉孤兒 pane $pid，請手動確認後 tmux kill-pane -t $pid"
          fi
        done <<< "$scan"
      else
        err "警告：回滾無法查詢 tmux pane，可能殘留一個啟動指令帶 $SPAWN_RB_TAG 的孤兒 pane，請手動確認並關閉"
      fi
    fi
  fi
  if [[ -n "$SPAWN_RB_REG" ]]; then
    # 刪不掉要講出來：靜默吞掉會留下一筆沒有 pane 的殭屍 registry，
    # 它照樣佔 cap、也擋住同名 spawn。不中止 trap（否則吃掉 release_lock）
    rm -f -- "$SPAWN_RB_REG" 2>/dev/null \
      || err "警告：回滾未能刪除 registry $SPAWN_RB_REG，請手動清除（它仍佔用 spawn 名額）"
  fi
  # 回滾只做一次：同樣用單一旗標，不逐一清空（理由同上）
  SPAWN_DONE=1
}

# 就緒自報到：間隔重送探針（agent-bridge ready <name>）直到 registry 翻
# ready 或逾時。REPL 啟動期吃掉的按鍵靠重送覆蓋；逾時不回滾、僅警告，
# pane 留用供人工診斷。
# validate_ready_opts：兩個 readiness 參數必須在建 pane 之前就驗。等到
# spawn_wait_ready 才 die 的話，pane 與 registry 都已落地、回滾也已解除，
# 呼叫端只看到非零退出，卻留下一個佔著 cap 的 worker
validate_ready_opts() {
  local t="${AGENT_BRIDGE_READY_TIMEOUT:-30}" i="${AGENT_BRIDGE_READY_PROBE_INTERVAL:-2}"
  [[ "$t" =~ ^[0-9]{1,9}$ ]] \
    || die "AGENT_BRIDGE_READY_TIMEOUT 需為非負整數（秒，至多 9 位；0＝不等待）：$t"
  [[ "$i" =~ ^([0-9]+|[0-9]*\.[0-9]+)$ ]] \
    || die "AGENT_BRIDGE_READY_PROBE_INTERVAL 需為正數（秒）：$i"
  # 格式已確認是數字，所以「小數點前後都只有 0（或省略整數位）」即代表零值。
  # 寫成 ^0+... 會漏掉 .0／.00 這種省略整數位的零
  [[ ! "$i" =~ ^0*(\.0+)?$ ]] \
    || die "AGENT_BRIDGE_READY_PROBE_INTERVAL 需大於 0（否則探針會忙迴圈）：$i"
}

# 把 brief 檔＋動態尾巴組成 runtime 的 initial prompt 參數（單一 shell word）。
# brief 全文刻意不進命令列：改讓 tmux 的 sh -c 在 pane 內展開 $(cat ...)，
# 啟動指令因此維持短、pane_start_command 仍可讀，也免去把整份 Markdown 塞進
# 命令字串的跳脫地獄。代價是展開時機延到 pane 啟動：brief 雖已於建 pane 前
# 驗過是可讀的普通檔案，那之後仍有 TOCTOU 空隙——被刪或換掉會退化成沒有守則
# 的 worker，換成 FIFO 之類讀不完的來源則會讓 pane 卡在讀取。兩者都不會殺錯
# 東西，但後者會留下佔 cap 的 starting pane（見 README「殘留缺口」）
worker_prompt_arg() {
  local name="$1" brief="$2"
  # 路徑要以單引號字面值送進 sh；含單引號就湊不出安全的字面值，fail-closed
  [[ "$brief" != *"'"* ]] || die "worker brief 路徑不可含單引號：$brief"
  # 尾巴保持單行：換行進 tmux 命令字串只是徒增變數。
  # $name 已由 NAME_RE 限成 [A-Za-z0-9_-]+，沒有注入面
  # shellcheck disable=SC2016  # $(cat …) 刻意不在此展開，留給 pane 內的 sh
  # `cat --`：AGENT_BRIDGE_WORKER_BRIEF 是公開覆蓋介面，接得到相對路徑；
  # 少了 option terminator，一個叫 `--help` 的檔案會被 cat 當成選項，
  # spawn 照樣成功卻注入了完全錯誤的 prompt
  printf '"$(cat -- '\''%s'\'')  ——以上是你的 worker 守則。你的 agent 名稱是 %s。第一件事：立刻執行 agent-bridge ready %s"' \
    "$brief" "$name" "$name"
}

spawn_wait_ready() {
  local name="$1" pane="$2"
  # 兩個參數已由 validate_ready_opts 在建 pane 前驗過
  local timeout="${AGENT_BRIDGE_READY_TIMEOUT:-30}"
  local interval="${AGENT_BRIDGE_READY_PROBE_INTERVAL:-2}"
  timeout=$((10#$timeout))
  if (( timeout == 0 )); then
    return 0
  fi
  local reg="$AGENTS_DIR/$name.json"
  SECONDS=0
  while :; do
    if jq -e '.ready == true' "$reg" >/dev/null 2>&1; then
      info "agent '$name' 已回報就緒（ready）"
      return 0
    fi
    if (( SECONDS >= timeout )); then
      err "警告：agent '$name' 於 ${timeout}s 內未回報就緒；pane $pane 留用供診斷，可於該 pane 手動執行：agent-bridge ready $name"
      return 0
    fi
    notify_pane "$pane" "agent-bridge ready $name" || true
    sleep "$interval"
  done
}

cmd_spawn() {
  (( $# >= 1 )) || die "用法：agent-bridge spawn <name> --runtime codex [--window]"
  local name="$1"; shift
  local runtime="" use_window=0
  while (( $# > 0 )); do
    case "$1" in
      --runtime)
        shift; (( $# > 0 )) || die "--runtime 需要參數"
        runtime="$1" ;;
      --window) use_window=1 ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  [[ -n "$runtime" ]] || die "spawn 需要 --runtime <runtime>（v1 僅支援 codex）"

  # runtime 表：指令 ＋ 守則注入方式。目前每個 runtime 都走「initial prompt
  # 位置參數」（codex/claude/gemini 等 agent CLI 的共通形狀：`cmd [OPTIONS]
  # [PROMPT]`）。新增 runtime 前先實測該 CLI 的位置參數確實會被當第一則 user
  # message 執行；若某個 runtime 只吃 stdin 或需要別的旗標，這裡要一併長出
  # 對應的注入方式，不要硬套。v1 只實作實測過的 codex
  local runtime_cmd
  case "$runtime" in
    codex) runtime_cmd="codex --profile agent-worker" ;;
    *) die "不支援的 runtime：$runtime（v1 僅支援 codex）" ;;
  esac
  command -v tmux >/dev/null 2>&1 || die "找不到 tmux，spawn 需要 tmux"
  command -v "${runtime_cmd%% *}" >/dev/null 2>&1 \
    || die "找不到 runtime 指令：${runtime_cmd%% *}"

  # brief 讀不到就不開 pane：沒有守則的 worker 收到探針只會當成對話回覆，
  # 開出來也是壞的（正是這條路徑當初讓 Phase 4 gate 失敗）。檢查必須在建
  # pane 之前，理由同 validate_ready_opts：pane 落地後才 die 會留下一個
  # 佔著 cap 的 worker
  # 要驗普通檔案，不能只驗可讀：`[[ -r ]]` 對目錄一樣成立，而 pane 內的
  # `cat` 讀目錄會失敗、命令替換卻仍返回空字串，runtime 照樣被 exec 起來——
  # 於是開出一個沒有守則的 worker，正好是這道檢查要擋的東西。-f 一併擋掉
  # FIFO 與裝置檔（cat 會卡住或讀出無關內容）
  [[ -f "$WORKER_BRIEF" && -r "$WORKER_BRIEF" ]] \
    || die "worker brief 不是可讀的普通檔案：$WORKER_BRIEF（可用 AGENT_BRIDGE_WORKER_BRIEF 指定）"

  validate_ready_opts

  local max="${AGENT_BRIDGE_MAX_SPAWN:-4}"
  [[ "$max" =~ ^[0-9]{1,9}$ ]] || die "AGENT_BRIDGE_MAX_SPAWN 需為非負整數：$max"
  max=$((10#$max))

  # cap 檢查、建 pane、註冊全部包在 registry 鎖內，杜絕並行 spawn 繞過 cap；
  # 鎖內任一步失敗 → EXIT trap 回滾（kill 已建 pane＋刪 registry 檔）
  acquire_lock agents-registry
  trap 'spawn_rollback || true; release_lock' EXIT

  if [[ -e "$AGENTS_DIR/$name.json" ]]; then
    die "agent '$name' 已註冊，spawn 不覆蓋（人工註冊請先 unregister；spawned 請先 despawn）"
  fi

  # 無法解析的 registry 保守計入 cap：漏算會讓上限形同虛設，寧可少開一個
  local count=0 f sp_rc
  for f in "$AGENTS_DIR"/*.json; do
    [[ -e "$f" ]] || continue
    sp_rc=0
    is_spawned "$f" || sp_rc=$?
    case $sp_rc in
      0|2) count=$((count + 1)) ;;
    esac
  done
  (( count < max )) \
    || die "已達 spawn 上限（AGENT_BRIDGE_MAX_SPAWN=$max，現有 spawned agent $count 個）；先 despawn 閒置 worker"

  # 一次性 tag 先於建 pane 設好：pane 一旦誕生就認得出是誰的，即使 pane id
  # 沒能回到手上，回滾仍掃得到（見 spawn_rollback）
  # tag 是刪除的依據，熵不能省：PID 會重用，光靠 16 位隨機值在舊 pane 仍留著
  # 啟動指令的情況下有誤中風險，故取 48 位。agent 名字也編進去：registry 位在
  # worker 可寫的資料目錄，若 tag 與名字無關，被注入的 worker A 只要把 B 的
  # tag 抄進自己的 registry，就能讓 orchestrator 的 `despawn A` 殺掉 B 的 pane
  local tag tagged_cmd pane
  tag="ab-spawn-$name-$$-$(rand_suffix)$(rand_suffix)$(rand_suffix)"
  tagged_cmd="AGENT_BRIDGE_SPAWN_TAG=$tag exec $runtime_cmd $(worker_prompt_arg "$name" "$WORKER_BRIEF")"
  # 回滾比對的是「env 前綴＋一個空白」，見 spawn_rollback
  SPAWN_RB_TAG="AGENT_BRIDGE_SPAWN_TAG=$tag"
  if (( use_window == 1 )); then
    pane="$(tmux new-window -dP -F '#{pane_id}' "$tagged_cmd")" \
      || die "tmux new-window 失敗"
  else
    pane="$(tmux split-window -dP -F '#{pane_id}' "$tagged_cmd")" \
      || die "tmux split-window 失敗"
  fi
  [[ -n "$pane" ]] || die "tmux 未回傳 pane id"
  SPAWN_RB_PANE="$pane"

  # 立刻夭折偵測：runtime 指令不存在／啟動即出錯時 pane 會瞬間消失
  sleep 0.3
  if ! tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -Fx "$pane" >/dev/null; then
    die "runtime 啟動即失敗（pane $pane 已消失）：$runtime_cmd"
  fi

  local ts doc
  ts="$(now_iso)"
  # spawn_tag 一併存進 registry：pane id 會被 tmux 重用（不同 server、server
  # 重啟後計數器歸零），光憑 id 無法證明「這個 pane 就是我 spawn 的那一個」。
  # despawn 殺之前用它跟 pane 的啟動指令對得上才動手
  doc="$(jq -n --arg name "$name" --arg pane "$pane" --arg ts "$ts" --arg rt "$runtime" \
              --arg tag "$SPAWN_RB_TAG" \
    '{name: $name, pane_id: $pane, registered_at: $ts,
      spawned: true, runtime: $rt, spawned_at: $ts, ready: false,
      spawn_tag: $tag}')"
  SPAWN_RB_REG="$AGENTS_DIR/$name.json"
  printf '%s\n' "$doc" | atomic_write "$AGENTS_DIR/$name.json"
  log_agent_event spawned "$name" "$pane" "$runtime"

  # 註冊完成即視為 spawn 成功：一次賦值解除回滾，之後就緒逾時只警告不回滾
  SPAWN_DONE=1
  release_lock || true

  # 這之後 worker 已經存在且註冊在案，任何失敗都不該讓呼叫端以為 spawn 失敗
  # ——它會照著「失敗」去重試或放棄，實際卻留著一個佔 cap 的 worker。
  # 輸出寫不出去（stdout/stderr 被關、EPIPE）是最實際的一種
  info "已 spawn agent '$name' → pane $pane（runtime：$runtime）" || true
  printf '%s\n' "$pane" || true
  spawn_wait_ready "$name" "$pane" || true
  return 0
}

cmd_despawn() {
  (( $# == 1 )) || die "用法：agent-bridge despawn <name>"
  local name="$1"
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  local f="$AGENTS_DIR/$name.json"
  # 出身檢查必須在鎖內：檢查與 kill-pane 之間若 registry 被同名 register 換掉，
  # 鎖外檢查會拿舊紀錄放行、卻殺到新的人工 pane（TOCTOU）
  acquire_lock agents-registry
  [[ -f "$f" ]] || die "未註冊的 agent：$name"
  local sp_rc=0
  is_spawned "$f" || sp_rc=$?
  case $sp_rc in
    1) die "agent '$name' 非 spawn 出身，despawn 拒絕（人工註冊請用 unregister）" ;;
    2) die "agent '$name' 的 registry 無法解析，出身不明，despawn 拒絕；請確認 $f 後手動處理" ;;
  esac

  local pane runtime tag
  pane="$(jq -r '.pane_id' "$f")"
  runtime="$(jq -r '.runtime // "-"' "$f")"
  tag="$(jq -r '.spawn_tag // ""' "$f")"
  # pane_id 會被展開進 tmux 命令字串（if-shell 的 kill-pane），而 `;` 在
  # tmux 命令中是分隔符——不驗格式的話 registry 就是一條命令注入通道
  [[ "$pane" =~ $PANE_RE ]] \
    || die "registry 的 pane_id 格式不合法（疑似遭竄改），拒絕操作：$pane"

  command -v tmux >/dev/null 2>&1 || die "找不到 tmux，despawn 無法確認 pane 是否回收"

  # 查詢失敗（tmux server 不可達、sandbox 擋 socket）與「pane 不存在」是兩件事：
  # 前者無從判斷，不能當成 pane 已死而逕自清 registry——那會留下沒人回收的孤兒
  local panes
  panes="$(tmux list-panes -a -F '#{pane_id} #{pane_start_command}' 2>&1)" \
    || die "無法查詢 tmux pane（registry 保留不動，請排除後重試）：$panes"

  local live_cmd=""  found=0
  local pid cmd
  while read -r pid cmd; do
    if [[ "$pid" == "$pane" ]]; then
      found=1
      live_cmd="${cmd#\"}"
      break
    fi
  done <<< "$panes"

  if (( found == 1 )); then
    # pane id 對得上還不夠：id 會被重用，registry 也可能被寫入資料目錄的 worker
    # 竄改。啟動指令帶不帶我們當初埋的 tag，才是這個 pane 的出身證據。
    # tag 本身也要驗格式：否則 registry 裡填個 spawn_tag="bash" 就成了萬用鑰匙，
    # 任何跑 bash 的人工 pane 都會被前綴比對命中。格式含本 agent 的名字，
    # 抄別人的 tag 也對不上
    local tag_re="^AGENT_BRIDGE_SPAWN_TAG=ab-spawn-${name}-[0-9]+-[0-9a-f]{12}\$"
    if [[ ! "$tag" =~ $tag_re || "$live_cmd" != "$tag "* ]]; then
      rm -f -- "$f" \
        || die "pane $pane 已非本 agent 所有，且 registry 刪除失敗，請手動清除 $f"
      log_agent_event despawn-stale "$name" "$pane" "$runtime"
      release_lock
      err "警告：pane $pane 目前的啟動指令不帶 '$name' 的 spawn tag（id 已被別的 pane 佔用，或 registry 遭竄改）；已清除註冊，未動該 pane"
      return 0
    fi
    # 驗證與 kill 分成兩次 tmux 呼叫，中間 server 若死掉重啟、新 server 把同一個
    # %N 發給人工 pane，第二次呼叫就會殺錯人。if-shell 讓「再驗一次 tag」與
    # kill 在同一次 client 連線內完成：換了 server 就判 false，不動手。
    # tmux 會把含空白的啟動指令加上雙引號存（實測 3.7b），故 pattern 帶前導引號；
    # 萬一未來版本改了存法，這裡會判 false → 不殺 → 被下面的存活檢查擋成
    # 「保留 registry 並報錯」，失效方向是漏殺而非誤殺
    tmux if-shell -t "$pane" -F "#{m:\"$tag *,#{pane_start_command}}" \
      "kill-pane -t $pane" 2>/dev/null || true
    local after
    after="$(tmux list-panes -a -F '#{pane_id}' 2>&1)" \
      || die "kill 後無法確認 pane $pane 狀態（registry 保留不動，請排除後重試）：$after"
    if grep -Fx "$pane" <<< "$after" >/dev/null; then
      die "無法關閉 pane $pane（kill 失敗，或 tmux server 在驗證後被替換）；registry 保留不動，請排除後重試"
    fi
  fi

  rm -f -- "$f"
  log_agent_event despawned "$name" "$pane" "$runtime"
  release_lock
  if (( found == 1 )); then
    info "已 despawn agent '$name'（pane $pane）"
  else
    info "已 despawn agent '$name'（pane $pane 已不存在，僅清除註冊）"
  fi
}

cmd_ready() {
  (( $# == 1 )) || die "用法：agent-bridge ready <name>"
  local name="$1"
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  local f="$AGENTS_DIR/$name.json"
  # 同 despawn：出身檢查與寫入之間 registry 可能被換掉，故一律鎖內檢查
  acquire_lock agents-registry
  [[ -f "$f" ]] || die "未註冊的 agent：$name"
  local sp_rc=0
  is_spawned "$f" || sp_rc=$?
  case $sp_rc in
    1) die "agent '$name' 非 spawn 出身，ready 僅限 spawned agent" ;;
    2) die "agent '$name' 的 registry 無法解析，ready 拒絕；請確認 $f 後手動處理" ;;
  esac
  local updated
  updated="$(jq '.ready = true' "$f")"
  printf '%s\n' "$updated" | atomic_write "$f"
  release_lock
  info "agent '$name' 已回報就緒（ready）"
}

main() {
  if (( $# == 0 )); then
    usage
    exit 1
  fi
  local cmd="$1"; shift
  case "$cmd" in
    -h|--help|help)
      usage
      return 0
      ;;
  esac
  require_jq
  ensure_dirs
  case "$cmd" in
    register)   cmd_register "$@" ;;
    unregister) cmd_unregister "$@" ;;
    list)       cmd_list "$@" ;;
    send)       cmd_send "$@" ;;
    receive)    cmd_receive "$@" ;;
    start)      cmd_start "$@" ;;
    reply)      cmd_reply "$@" ;;
    fail)       cmd_fail "$@" ;;
    cancel)     cmd_cancel "$@" ;;
    status)     cmd_status "$@" ;;
    read)       cmd_read "$@" ;;
    await)      cmd_await "$@" ;;
    spawn)      cmd_spawn "$@" ;;
    despawn)    cmd_despawn "$@" ;;
    ready)      cmd_ready "$@" ;;
    *)
      usage
      die "未知指令：$cmd"
      ;;
  esac
}

main "$@"
