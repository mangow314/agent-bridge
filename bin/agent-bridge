#!/usr/bin/env bash
# agent-bridge — 跨 tmux pane 的 agent 任務委派橋（core MVP）
#
# 機制：檔案系統 mailbox（AGENT_BRIDGE_DATA）＋ tmux send-keys 短通知。
# 通知只送一行短指令（agent-bridge receive/read <task-id>），
# 絕不把訊息內容放進 send-keys。
set -euo pipefail

DATA_DIR="${AGENT_BRIDGE_DATA:-$HOME/.local/share/agent-bridge}"
AGENTS_DIR="$DATA_DIR/agents"
TASKS_DIR="$DATA_DIR/tasks"
LOCKS_DIR="$DATA_DIR/locks"
# worker 活動狀態（idle/busy）快取，供 notify_or_defer 判斷是否要送鍵。刻意獨立
# 於 agents/：registry 那條「for f in "$AGENTS_DIR"/*.json」的 glob 迴圈（is_spawned
# 等處）看到副檔名 .json 就會嘗試當註冊檔解析，state 檔混進去會被誤讀。單一寫者
# 是該 worker 自己的 hook（cmd_hook），走 atomic_write、不取 registry 鎖——
# 狀態是「建議非權威」，寫壞了頂多退回 legacy 送鍵，不影響任何狀態機不變量
STATE_DIR="$DATA_DIR/state"

NAME_RE='^[A-Za-z0-9_-]+$'
# task-id 首字元強制英數：純寬鬆字元集會放行 `.` 與 `..`，它們拼進
# "$TASKS_DIR/$id" 後分別 alias 到 tasks/ 自身與整個資料目錄，且 `[[ -d ]]`
# 照樣成立——status/read 會拿目錄當 task 查（獨立複核 2026-07-24 指出）。
# 首字元英數同時擋掉 dotfile 形與 `-` 開頭被當旗標的形；send 生成的 id 以
# 數字起首，不受影響
TASK_ID_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$'
# registry 的 pane_id 對本程式是不可信輸入（資料目錄對每個 worker 都可寫），
# 而它會被餵給 tmux。tmux 命令字串裡 `;` 是命令分隔符，
# 一個 pane_id 寫成 `%1 ; kill-server` 就能殺掉整個 server
PANE_RE='^%[0-9]+$'
# registry 的 worker_window 同樣是不可信輸入且會被餵給 tmux（split-window -t），
# 與 PANE_RE 同一套理由；@id 形式以外一律不採用
WINDOW_RE='^@[0-9]+$'
# --model 的值會被拼進 tagged_cmd（pane 的啟動命令字串），與 brief 路徑同級的
# 暴露面，兩類都要擋：(1) 命令注入——字元集排除空白、引號、`;`、`$` 等 sh 與
# tmux 的分隔符；(2) 旗標走私——首字元強制英數，否則 `--model --bare` 這種值
# 會原樣落進 runtime 的 argv，變成往 worker 啟動旗標裡塞任意開關的後門
MODEL_RE='^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'

# worker brief：spawn 出來的 runtime 是一個全新、零脈絡的 session——它不知道
# 自己是 worker，也不知道 pane 裡收到的 `agent-bridge receive <id>` 是要執行的
# 命令而非有人在跟它說話。實測（codex 0.145）會把就緒探針當成對話反覆回覆
# 文字、永遠不 ready。故啟動時把這份守則當 initial prompt 注入。
# 正本是一份檔而不是內嵌字串：人工註冊的 worker 讀同一份，兩邊不會漂移。
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
REPO_ROOT="$(dirname "$(dirname "$SCRIPT_PATH")")"
WORKER_BRIEF="${AGENT_BRIDGE_WORKER_BRIEF:-$REPO_ROOT/share/worker-brief.md}"
# 接手者守則：relay 注入的是這份而不是 worker 守則。兩者心智相反——worker 等
# 派工、接手者一開始就有交接檔要自己往下做，把 worker 守則注入接手者會讓它
# 空等 receive
SUCCESSOR_BRIEF="${AGENT_BRIDGE_SUCCESSOR_BRIEF:-$REPO_ROOT/share/successor-brief.md}"
# claude worker 專屬 hooks settings（通知原生化 Phase 2）：只含 hooks 一個 key，
# 把 Stop/UserPromptSubmit/Notification 接到 `agent-bridge hook …`（cmd_hook，
# Phase 1 已實作）。用 `--settings <path>` 而非改使用者全域 ~/.claude/settings.json
# 注入：這份設定只該對 worker pane 生效、版本隨 repo 走（改 hooks 邏輯不必手動
# 同步到每台機器的全域設定），且不能因為一次 worker spawn 就讓主 session／人工
# pane 也長出這些 hook。
#
# 這不推翻上面「刻意不加 --settings/--setting-sources」的取捨：hooks 分層是
# 合併不是覆蓋（已於本機查證，見 plan 的「已驗證的外部事實」段）——`--settings`
# 檔案裡的 hooks 與使用者全域 hooks 並存生效，全域安全規則原樣適用，取捨的
# 代價（worker brief 與全域守則並存、可能被全域規則改寫命令形式）不受影響。
# 沒有動、也不會動的是 --setting-sources：那才是真正會改變全域設定「繼承」
# 本身的旗標，本次沒有理由碰它。
#
# --settings 無條件加在 claude 分支，不做開關旗標：多一個「要不要注入 hooks」
# 的旗標面，就多一條要在 spawn 參數解析、注册、審計三處分別想清楚的分岔。
# 要停用 hooks 的使用者把 AGENT_BRIDGE_CLAUDE_HOOKS 指向一份 `{"hooks":{}}`
# 之類的合法空 JSON 即可——state/<name>.json 不會再被寫出，notify_or_defer
# 讀不到新鮮 state 天然退回既有 legacy 送鍵，不需要另開一個功能旗標。
CLAUDE_HOOKS_SETTINGS="${AGENT_BRIDGE_CLAUDE_HOOKS:-$REPO_ROOT/share/claude-worker-hooks.json}"
# relay 模式旗標：非空＝cmd_spawn 走接手者路徑。用全域傳遞是為了讓 relay 共用
# cmd_spawn 而不必改它的簽章（set -u，故必須先初始化）
RELAY_HANDOFF=""
RELAY_PREV=""
# 接力鏈深度：cmd_relay 算出「下一棒是第幾棒」，cmd_spawn 把它拼進 pane 的
# 啟動環境往下傳（同一條全域傳遞的理由）
RELAY_DEPTH_NEXT=0

err()  { printf 'agent-bridge: %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }
info() { printf '%s\n' "$*" >&2; }

usage() {
  cat >&2 <<'EOF'
用法：
  agent-bridge register <agent> <tmux-target>   註冊 agent 與其 tmux pane
  agent-bridge unregister <agent>               移除 agent 註冊
  agent-bridge list                             列出已註冊 agent（name<TAB>pane_id<TAB>ready）
  agent-bridge send <agent> --from <sender> (--message <text> | --message-file <path>)
                                                委派任務；stdout 只印 task-id
  agent-bridge receive <task-id>                取出任務（標頭走 stderr、request 原文走 stdout）
  agent-bridge start <task-id>                  （worker）標記開工（delivered → running）
  agent-bridge reply <task-id> (--message <text> | --message-file <path>)
                                                回覆任務（delivered/running 可回）
  agent-bridge fail <task-id> (--message <text> | --message-file <path>)
                                                回報任務失敗（delivered/running 可；訊息＝失敗原因）
  agent-bridge cancel <task-id>                 取消任務（queued/delivered/running 可）
  agent-bridge status <task-id>                 印裸狀態字（queued/delivered/running/completed/failed/cancelled）
  agent-bridge read <task-id>                   讀回覆（completed/failed 可；標頭走 stderr、response 原文走 stdout）
  agent-bridge await <task-id> [--timeout <secs>]
                                                阻塞等待 task 到終態，印裸狀態字後 exit 0；
                                                逾時以 exit 124 退出（其他錯誤一律非 124，供呼叫端區分）
  agent-bridge spawn <name> --runtime <codex|claude> [--model <model>] [--window]
                                                spawn 一個 worker pane 並註冊；stdout 只印 pane-id
                                                （--model 不給＝該 CLI 的使用者預設模型）
  agent-bridge relay <name> --runtime <codex|claude> [--model <model>] --handoff <path> [--window] [--no-select] [--self-exit <my-name>]
                                                把主導權交給新 session（注入接手者守則＋交接檔）；stdout 只印 pane-id
  agent-bridge despawn <name>                   回收 spawn 出身的 worker（kill pane＋除名；人工註冊拒殺）
  agent-bridge ready <name>                     （worker）回報就緒；僅限 spawned agent
  agent-bridge disposable <name>                （worker）宣告本輪脈絡已無殘值，可即時回收
                                                （預設是保留：沒宣告過的一律視為仍有殘值）
  agent-bridge idle                             worker 池回收決策視圖；唯讀
                                                （name<TAB>ready<TAB>disposable<TAB>idle_secs）
  agent-bridge evict <name> [--timeout <secs>] [--from <sender>]
                                                驅逐 worker：派收尾任務 → 等筆記落地 → despawn
                                                stdout 只印收尾 task-id；逾時仍 despawn（審計記 evicted-timeout）
  agent-bridge gc [--older-than <days>] [--apply] [--include-notes]
                                                清掉夠舊的終態 task（預設 14 天）；未完成的與
                                                evict 收尾筆記一律保留。預設只試算，--apply 才刪
  agent-bridge hook <stop|prompt-submit|notification>
                                                （由 Claude Code 呼叫，非人工手動用）落地 hook
                                                協定：stdin 收事件 JSON，依 AGENT_BRIDGE_SPAWN_TAG
                                                析出的 agent 名更新 state/<name>.json；stop 事件
                                                查到 mailbox 有新任務時輸出 block JSON 續跑，
                                                stdout 只在此時有內容。任何內部錯誤一律 exit 0。

--message-file 用 `-` 表示讀 stdin。
資料目錄預設 ~/.local/share/agent-bridge/，可用 AGENT_BRIDGE_DATA 覆蓋。
await 輪詢間隔預設 1 秒，可用 AGENT_BRIDGE_POLL_INTERVAL 覆蓋；--timeout 0（預設）＝不逾時。
evict 的 --timeout 預設 300 秒、--from 預設 orchestrator；--timeout 0＝無限等，
等於放棄「一定騰得出 cap」這個保證，只在確定 worker 還活著時才用。
spawn 上限 AGENT_BRIDGE_MAX_SPAWN（預設 4）；就緒等待 AGENT_BRIDGE_READY_TIMEOUT
秒（預設 30，0＝不等待），探針重送間隔 AGENT_BRIDGE_READY_PROBE_INTERVAL（預設 2）。
worker 活動狀態新鮮度 AGENT_BRIDGE_STATE_TTL（預設 1800 秒）：send/reply/cancel
通知前若對方 state 檔顯示 busy 且未超過這個秒數，改為完全不送鍵（改由對方
Stop hook 在 turn 結束時自行 receive）；state 檔缺失或已過期一律退回既有的
tmux send-keys 通知路徑。
claude worker 的 hooks settings 預設 share/claude-worker-hooks.json，可用
AGENT_BRIDGE_CLAUDE_HOOKS 覆蓋；停用 hooks 就指向一份 hooks 為空的合法 JSON。
EOF
}

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

rand_suffix() { head -c 2 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

ensure_dirs() { mkdir -p "$AGENTS_DIR" "$TASKS_DIR" "$LOCKS_DIR" "$STATE_DIR"; }

# is_spawned <registry-file>：0＝spawn 出身，1＝不是，2＝無法判定（JSON 損壞／讀不到）
# 直接用 `jq -e '.spawned == true'` 會把「條件為 false」與「檔案是壞的」壓成同一個
# 非零，出身判斷因此 fail-open：一份損壞的 registry 會被當成人工註冊而遭覆寫或除名
is_spawned() {
  local f="$1" out
  # 非 object 的合法 JSON（例如字面 null）也算判不出來：那不是一份 registry，
  # 當成「人工註冊」就會被覆寫或除名
  out="$(jq -r 'if type != "object" then "bad" elif .spawned == true then "yes" else "no" end' \
    "$f" 2>/dev/null)" || return 2
  case "$out" in
    yes) return 0 ;;
    no)  return 1 ;;
    *)   return 2 ;;
  esac
}

require_jq() {
  command -v jq >/dev/null 2>&1 \
    || die "缺少硬依賴 jq，請先安裝（例如 pacman -S jq）"
}

# atomic_write <dest>：內容從 stdin，同檔案系統 mktemp + mv 保證原子性
atomic_write() {
  local dest="$1" tmp
  tmp="$(mktemp "$(dirname "$dest")/.tmp.XXXXXX")"
  cat > "$tmp"
  mv "$tmp" "$dest"
}

# despawn 的 generation 綁定：由 cmd_evict 在呼叫前設成它一開始看到的
# spawn_tag，空字串＝不綁定（直接 despawn 的一般情形）。用全域而非參數，是為了
# 不把這個內部契約暴露成對外的 CLI 參數——despawn 的參數面是安全路徑，多一個
# 未文件化的參數就多一條要防的輸入
DESPAWN_EXPECT_TAG=""

# send 的 pin 標記：由 cmd_evict 在呼叫前設成 1，讓收尾任務的 metadata 帶
# pinned:true，gc 一律跳過。收尾筆記是這一層刻意留下來的脈絡——「上下文不會憑空
# 消失」這個承諾，若筆記會被 GC 靜靜清掉就只是延後兌現。同樣用全域而非參數：
# send 是核心路徑，參數面不該為了內部契約變寬
SEND_PIN=""

# evict 呼叫 despawn 時設 1：表示收尾筆記已經走過流程（落地或已記未落地），
# despawn 不必再記 despawned-unsaved
DESPAWN_NOTES_HANDLED=""

# send 的 task 目錄回滾：mkdir 之後、metadata/status 寫齊之前的任何失敗
# （來源檔在預檢後被刪或不可讀、jq／寫入失敗）都經 EXIT trap 把殘缺目錄
# 收走。沒有 metadata/status 的目錄不屬於任何狀態、gc 又刻意只碰完整形狀，
# 留下就是永久孤兒——預檢只擋得住「一開始就不存在」，涵蓋不了 TOCTOU 殘徑
# （獨立複核 2026-07-24 第二輪指出）
SEND_RB_DIR=""
# shellcheck disable=SC2329  # 經 EXIT trap 間接呼叫
send_rollback() {
  [[ -n "$SEND_RB_DIR" ]] || return 0
  rm -rf -- "$SEND_RB_DIR" 2>/dev/null \
    || err "警告：殘缺 task 目錄清除失敗，請手動移除：$SEND_RB_DIR"
  SEND_RB_DIR=""
}

# cmd_despawn 的結果回報給呼叫者：killed（真的關掉了 pane）／absent（pane 本來
# 就不在，只清註冊）／stale（pane 還在但已不屬於這個 agent，只清註冊）。
# evict 要靠它分辨——stale 代表那個 pane 沒被回收，這時寫 evicted 就是假紀錄
DESPAWN_RESULT=""

# ---- 鎖：mkdir lock，短暫重試後報錯 ----
LOCK_DIR=""

release_lock() {
  if [[ -n "$LOCK_DIR" && -d "$LOCK_DIR" ]]; then
    # 解不掉的鎖會擋住之後每一次同類操作。吞掉這個失敗＝留下一把沒人知道
    # 存在的鎖（例如鎖目錄被塞了檔案，rmdir 就會 Directory not empty）
    rmdir "$LOCK_DIR" 2>/dev/null \
      || err "警告：無法釋放鎖目錄 $LOCK_DIR（非空或權限問題），它會擋住後續操作，請手動移除"
  fi
  LOCK_DIR=""
}

acquire_lock() {
  local id="$1" tries=0 lock err
  lock="$LOCKS_DIR/$id.lock"
  until mkdir "$lock" 2>/dev/null; do
    # mkdir 失敗但鎖目錄不存在＝不是佔用，是權限/sandbox/檔案系統問題；
    # 重試無意義，帶出 mkdir 的真正錯誤原因（例：codex sandbox 擋
    # workspace 外寫入時，誤報「佔用中」會把人引去查錯方向）
    if [[ ! -d "$lock" ]]; then
      if err="$(mkdir "$lock" 2>&1)"; then
        break
      fi
      die "無法建立鎖目錄（非鎖佔用，疑似權限或 sandbox 寫入限制）：$err"
    fi
    tries=$((tries + 1))
    if (( tries >= 25 )); then
      die "無法取得鎖（locks/$id.lock 佔用中或殘留），請稍後重試"
    fi
    sleep 0.2
  done
  LOCK_DIR="$lock"
  trap release_lock EXIT
}

# log_event <task-id> <event> [detail]：append-only events.log
log_event() {
  local id="$1" ev="$2" detail="${3:-}" line
  line="$(now_iso) $ev"
  if [[ -n "$detail" ]]; then
    line="$line $detail"
  fi
  printf '%s\n' "$line" >> "$TASKS_DIR/$id/events.log"
}

# update_meta_status <task-dir> <new-status>：同步更新 metadata.json 與 status 檔
update_meta_status() {
  local dir="$1" new="$2" ts updated
  ts="$(now_iso)"
  updated="$(jq --arg s "$new" --arg t "$ts" '.status = $s | .updated_at = $t' "$dir/metadata.json")"
  # 先寫裸 status、再寫 metadata：兩次寫入之間沒有交易性，中間被 SIGKILL／
  # 斷電就會各說各話（獨立複核 2026-07-24 指出）。狀態機與 await 全數讀裸
  # status，它才是操作上的權威——先落它，殘留的分歧只會是 metadata.status
  # 落後一步的展示性資訊；反過來（metadata 先落）殘留的是「status 停在舊態、
  # 終態轉換可被重放（例如對已 completed 的 task 再 reply 覆寫 response）」，
  # 兩個方向不對等
  printf '%s\n' "$new" | atomic_write "$dir/status"
  printf '%s\n' "$updated" | atomic_write "$dir/metadata.json"
}

# write_message <dest> <mode:text|file> <value>；file 模式的 `-` 讀 stdin
write_message() {
  local dest="$1" mode="$2" val="$3"
  if [[ "$mode" == "text" ]]; then
    printf '%s\n' "$val" | atomic_write "$dest"
  elif [[ "$val" == "-" ]]; then
    atomic_write "$dest"
  else
    [[ -f "$val" ]] || die "找不到訊息檔：$val"
    atomic_write "$dest" < "$val"
  fi
}

# screen_has_prompt <screen-text>：一屏可見文字裡是否有 Claude Code 權限確認對話框
# 的特徵。純字串判斷、不碰 tmux，好讓 notify_pane 自己掌握 capture 的成敗語意。
# 盡力偵測、非防彈：靠固定字串匹配，Claude Code 改對話框文案或本地化都會讓特徵
# 失效。特徵取「Do you want to 」前綴＋底部「Esc to cancel」操作提示，兩者並存：
# 前綴涵蓋各 permission dialog 的實際標題——不只 Bash 的「Do you want to proceed?」，
# 還有檔案 Edit/Write 的「Do you want to make this edit to …／overwrite／create」、
# WebFetch 的「Do you want to allow Claude to fetch this content?」等（形狀以
# claude 2.1.218 的 permission descriptor 為據，獨立複核由可執行檔 strings 佐證）；
# 只認「Do you want to proceed?」會漏掉這些型別、退回會誤觸的行為。codex worker 走
# approval_policy=never（見 ~/.codex/agent-worker.config.toml）不彈此框，故只認 CC 形狀。
# 代價方向：漏判＝那個 Enter 替 worker 按下批准（最壞），偽陽性＝通知降級成
# notify-failed、訊息仍在 mailbox、只是晚一步被取（可復原）。兩者不對等，故 fail-
# closed 偏攔——寧可偶爾偽陽性，也不放行一個可能誤批的 Enter。
# 第二組特徵：plan mode 的退出確認框（2026-07-23 真 UI 實測）。標題整行是
# 「Claude has written up a plan and is ready to execute. Would you like to
# proceed?」——不含「Do you want to 」；footer 是「ctrl+g to edit in …」——不含
# 「Esc to cancel」，第一組特徵完全比對不到。它的 Enter 預設是「1. Yes, and use
# auto mode」：誤觸不只替 worker 批准 plan，還把它切進 auto mode，比權限框更糟；
# 而 worker 的 SessionStart 提醒本來就引導中等任務先進 plan mode，此框對 worker
# 可達（實測）。標題拆成兩個較短片段 AND：整行在窄 pane 會被 tmux 折行，任一片
# 段單獨出現在普通輸出（如引述）則不攔。不取 footer 當特徵是因為它含編輯器名
# （隨 $EDITOR 環境變動）；不取選項行是因為選項文案隨 feature flag 增減。
# API key 框（「Do you want to use this API key?」＋「Esc to cancel」footer）實測
# 落在第一組特徵內，且其 Enter 預設是「No (recommended)」，無需另列。
# 匹配前先把整屏空白（含換行）摺疊成單一空格：TUI 的 word-wrap 硬換行與 tmux
# 軟折行都會把特徵片段拆到兩行，逐行比對必偽陰性——漏判＝放行誤批的 Enter，
# 是最壞方向（獨立複核以 fold 反例證實窄 pane 必漏）。正規化把折行拼回；代價
# 是不相鄰的行可能偽拼接出特徵，那是偽陽性方向，落在既定的 fail-closed 偏攔
# 內。同理，worker 自我檢視含這些字串的源碼／測試／diff 時會自觸發誤攔（兩片
# 段同屏），同屬既定代價：通知降級 notify-failed、訊息仍在 mailbox，可復原。
screen_has_prompt() {
  local screen
  screen="$(tr -s '[:space:]' ' ' <<<"$1")"
  { grep -qF 'Do you want to ' <<<"$screen" \
      && grep -qF 'Esc to cancel' <<<"$screen"; } \
  || { grep -qF 'has written up a plan' <<<"$screen" \
      && grep -qF 'Would you like to proceed' <<<"$screen"; }
}

# notify_pane <pane_id> <one-line-cmd>：先驗證 pane 存活再 send-keys；失敗回非零
# Enter 與文字拆成兩次送並隔一小段延遲：agent REPL（claude/codex 等 TUI）
# 會把同批抵達的文字+Enter 當成貼上，Enter 被吞掉導致指令留在輸入框不送出
notify_pane() {
  local pane="$1" cmd="$2" screen
  [[ "$pane" =~ $PANE_RE ]] || return 1
  command -v tmux >/dev/null 2>&1 || return 1
  tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -Fx "$pane" >/dev/null || return 1
  # 送鍵前確認 pane 沒停在權限確認對話框：那個 Enter 會被對話框當成「確認預設
  # 選項（Yes）」，替一個正等人類決策的 worker 按下批准（實測 2026-07-23：外部
  # 通知的 Enter 誤批了 worker 停著的 ask 對話框）。掃到就降級為通知失敗——訊息
  # 仍在 mailbox，交由呼叫端既有的 notify-failed 路徑處理。
  # capture 失敗＝無法確認 pane 狀態，一律 fail-closed（return 1）而非放行送鍵：
  # live pane 的 capture 可能因暫時性原因失敗、而後續 send-keys 卻成功，那樣防線
  # 就被整個略過（獨立複核以 shim 反例證實這不只是「pane 已死」一種路徑）。
  # -J 把 tmux 軟折行接回原樣，配合 screen_has_prompt 的空白正規化雙保險對付
  # 折行拆散特徵片段的偽陰性
  screen="$(tmux capture-pane -pJ -t "$pane" 2>/dev/null)" || return 1
  ! screen_has_prompt "$screen" || return 1
  tmux send-keys -t "$pane" "$cmd" 2>/dev/null || return 1
  sleep "${AGENT_BRIDGE_NOTIFY_DELAY:-0.3}"
  # 送 Enter 前再掃一次（同樣 fail-closed）：worker 未必只是被動監聽，可能正在跑
  # 別的 turn，第一次掃時還沒彈框、卻在這段延遲內才進入 permission prompt——這次
  # 掃描把那個 Enter 攔下。殘留 race（已知、無法在 tmux 層消除）：這第二次 capture
  # 與下一行 send-keys 之間仍有微小空窗，要完全關掉需判斷與按鍵在同一 pane-side
  # 原子操作內完成，tmux send-keys 給不了這種原子性
  screen="$(tmux capture-pane -pJ -t "$pane" 2>/dev/null)" || return 1
  ! screen_has_prompt "$screen" || return 1
  tmux send-keys -t "$pane" Enter 2>/dev/null
}

# notify_or_defer <agent> <pane> <cmd-line> <task-id> <cmd-tag>：cmd_send／
# respond_task／cmd_cancel 三個通知呼叫點共用的 gate，取代各自重複的
# if notify_pane ... else ... fi。
# state/<agent>.json 的語意是「建議非權威」（同 disposable 既有的用語）：讀不到、
# 解析失敗、或 ts 已超過 AGENT_BRIDGE_STATE_TTL 秒都視為「未知」，直接落回現行
# notify_pane 路徑、逐位元不變（既有 11 個通知測試即證據，測試 8/8a 全數不動）。
# 只有明確讀到 state=busy 且新鮮，才完全不送鍵——queued 任務改由對方的 Stop
# hook 在 turn 結束時自行 receive；hook 掛掉的失效方向是 state 停在 busy，
# TTL 一到自動退回 legacy 送鍵，任務不會因此餓死超過 TTL。
# state=idle 且新鮮時仍照送：idle 代表對方不在 turn 中，畫面上不可能停著權限
# 確認框（框只在 turn 中才會出現），但 notify_pane 既有的雙掃描原樣保留，
# 作為 belt-and-suspenders 與 stale-state 的第二道防線，不因為有了 state 通道
# 就拿掉。
notify_or_defer() {
  local agent="$1" pane="$2" cmdline="$3" task_id="$4" tag="$5"
  local state_file="$STATE_DIR/$agent.json"
  local ttl st ts epoch now fresh_busy=0

  ttl="${AGENT_BRIDGE_STATE_TTL:-1800}"
  # 格式驗證比照 AGENT_BRIDGE_MAX_SPAWN：只認非負整數，其餘視為設定錯誤直接 die
  [[ "$ttl" =~ ^[0-9]{1,9}$ ]] || die "AGENT_BRIDGE_STATE_TTL 需為非負整數：$ttl"
  ttl=$((10#$ttl))

  # ttl=0 比照本檔既有慣例（AGENT_BRIDGE_READY_TIMEOUT 0＝不等待）：0 代表
  # 整條 state 通道關閉，一律當「未知」走 legacy 送鍵。不這樣做的話，沒有
  # 下面的未來時間戳下界時 `now - epoch <= 0` 在 epoch 恰好等於 now 那個
  # 窄縫仍會判成新鮮 busy，「TTL=0＝關閉」就名不符實
  if (( ttl > 0 )) && [[ -f "$state_file" ]]; then
    st="$(jq -r '.state // empty' "$state_file" 2>/dev/null)" || st=""
    ts="$(jq -r '.ts // empty' "$state_file" 2>/dev/null)" || ts=""
    if [[ -n "$st" && -n "$ts" ]]; then
      # ts 是定長 ISO 8601 UTC，date -ud 直接轉 epoch；解析失敗（損壞／
      # 格式不符）一律當無狀態處理，不讓一份壞掉的 state 檔擋住通知
      epoch="$(date -ud "$ts" +%s 2>/dev/null)" || epoch=""
      if [[ -n "$epoch" ]]; then
        now="$(date -u +%s)"
        # 下界：now - epoch 為負代表 ts 落在未來，無論是他 worker 惡意寫入
        # 還是時鐘偏移都不可信——若不擋，未來時間戳會讓 busy 永遠判定為
        # 新鮮，通知因此永久停擺，且沒有 TTL 能救回來。失效方向寧可選
        # 「當作未知、多送一次鍵」（可復原），也不要「誤判成新鮮、餓死
        # 到 TTL 之外」（不可復原）
        if [[ "$st" == "busy" ]] && (( now - epoch >= 0 && now - epoch <= ttl )); then
          fresh_busy=1
        fi
      fi
    fi
  fi

  if (( fresh_busy )); then
    log_event "$task_id" notify-deferred "pane=$pane cmd=$tag"
    err "提示：$agent 目前忙碌中，通知延後——訊息已在 mailbox，對方 turn 結束時會由 hook 自行取件"
    return 0
  fi

  if notify_pane "$pane" "$cmdline"; then
    log_event "$task_id" notified "pane=$pane cmd=$tag"
  else
    log_event "$task_id" notify-failed "pane=$pane cmd=$tag"
    err "警告：無法通知 $agent（pane $pane）；請手動在對方 session 執行：$cmdline"
  fi
}

check_task_id() {
  local id="$1"
  [[ "$id" =~ $TASK_ID_RE ]] || die "task-id 不合法：$id"
}

# last_task_at <agent>：最後一個派給該 agent 的任務建立時間（ISO），從未被派工
# 則回空字串。掃 tasks/ 而不是在 send 時把 last_task_at 記進 registry——send 是
# 核心路徑，加一次「取 registry 鎖＋寫入」會擴大它的失敗面（鎖競爭時 send 會
# 整個失敗），而這個資訊只有回收決策要用。代價是 O(task 數)，task GC 是已知
# backlog。
# ISO 8601 UTC 定長字串可直接字典序比大小，不必轉 epoch。
# disposable_effective <agent> <registry-file>：這個 agent 的「無殘值」宣告
# 現在還算不算數。0＝仍有效（可即時回收）／1＝無效（沒宣告過，或宣告後又被
# 派了新任務、已累積新脈絡）。
#
# 抽成共用函式是因為兩個地方要問同一個問題：idle 決定第三欄印 yes 還是
# expired，despawn 決定審計記 despawned 還是 despawned-unsaved。這兩處若各寫
# 一份，遲早漂移成兩套語意，而它們的錯誤方向都是「把有殘值的當成沒殘值」。
#
# 同秒也算過期（`>=` 而非 `>`）：時間戳是秒精度，worker 宣告後 orchestrator
# 立刻派工就會落在同一秒。用嚴格大於的話那一秒內仍報 yes，於是一個剛拿到新
# 任務、正在累積新脈絡的 worker 會被直接回收，不走 evict、不留筆記。兩個方向
# 的代價不對等——判太嚴只是多派一輪收尾（多佔 cap），判太鬆是殺掉還有用的
# 脈絡。（bash 無字串 `>=`，故寫成「不小於」。獨立複核 2026-07-22 抓出）
disposable_effective() {
  local name="$1" f="$2" disp_at last_at
  disp_at="$(jq -r 'if .disposable == true then (.disposable_at // "?") else "" end' "$f" 2>/dev/null)" \
    || return 1
  [[ -n "$disp_at" ]] || return 1
  # 宣告了但沒有時間戳：無從判斷是否被後續任務推翻，當成無效（偏保守那邊）
  [[ "$disp_at" != "?" ]] || return 1
  last_at="$(last_task_at "$name")"
  [[ -n "$last_at" ]] || return 0
  [[ "$last_at" < "$disp_at" ]] || return 1
  return 0
}

last_task_at() {
  local who="$1" d latest="" ts to
  shopt -s nullglob
  for d in "$TASKS_DIR"/*/; do
    [[ -f "$d/metadata.json" ]] || continue
    # 單一損壞的 metadata 不該讓整份報表消失：跳過它，繼續看其他任務
    to="$(jq -r '.to // ""' "$d/metadata.json" 2>/dev/null)" || continue
    [[ "$to" == "$who" ]] || continue
    ts="$(jq -r '.created_at // ""' "$d/metadata.json" 2>/dev/null)" || continue
    [[ -n "$ts" ]] || continue
    if [[ -z "$latest" || "$ts" > "$latest" ]]; then
      latest="$ts"
    fi
  done
  printf '%s' "$latest"
}

# ---- 指令 ----

cmd_register() {
  (( $# == 2 )) || die "用法：agent-bridge register <agent> <tmux-target>"
  local name="$1" target="$2" pane ts doc
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  command -v tmux >/dev/null 2>&1 || die "找不到 tmux，register 需要 tmux"
  if ! pane="$(tmux display -pt "$target" '#{pane_id}' 2>/dev/null)" || [[ -z "$pane" ]]; then
    die "無法解析 tmux target：$target"
  fi
  ts="$(now_iso)"
  doc="$(jq -n --arg name "$name" --arg pane "$pane" --arg ts "$ts" \
    '{name: $name, pane_id: $pane, registered_at: $ts}')"
  # 取 registry 鎖再寫：與 spawn/despawn/ready 互斥。覆寫 spawned agent 會洗掉
  # 出身標記（pane 變成殺不掉的孤兒，且能誘使 despawn 殺到人工 pane），故拒絕
  acquire_lock agents-registry
  if [[ -e "$AGENTS_DIR/$name.json" ]]; then
    local sp_rc=0
    is_spawned "$AGENTS_DIR/$name.json" || sp_rc=$?
    case $sp_rc in
      0) die "agent '$name' 是 spawn 出身的 worker，register 拒絕覆寫（要換 pane 請先 despawn）" ;;
      2) die "agent '$name' 的 registry 無法解析，出身不明，register 拒絕覆寫；請確認 $AGENTS_DIR/$name.json 後手動處理" ;;
    esac
  fi
  printf '%s\n' "$doc" | atomic_write "$AGENTS_DIR/$name.json"
  release_lock
  info "已註冊 agent '$name' → pane $pane"
}

cmd_unregister() {
  (( $# == 1 )) || die "用法：agent-bridge unregister <agent>"
  local name="$1"
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  local f="$AGENTS_DIR/$name.json"
  # 鎖內檢查：單純除名 spawned agent 會留下沒人認領的 pane，且讓 cap 少算一個
  acquire_lock agents-registry
  [[ -f "$f" ]] || die "未註冊的 agent：$name"
  local sp_rc=0
  is_spawned "$f" || sp_rc=$?
  case $sp_rc in
    0) die "agent '$name' 是 spawn 出身的 worker，unregister 拒絕（請用 despawn 一併回收 pane）" ;;
    2) die "agent '$name' 的 registry 無法解析，出身不明，unregister 拒絕（若它其實是 spawned，除名會留下沒人回收的 pane）；請確認 $f 後手動處理" ;;
  esac
  rm -- "$f"
  release_lock
  info "已移除 agent '$name' 的註冊"
}

cmd_list() {
  local f name pane ready
  shopt -s nullglob
  for f in "$AGENTS_DIR"/*.json; do
    name="$(jq -r '.name' "$f")"
    pane="$(jq -r '.pane_id' "$f")"
    # ready 欄：人工註冊 `-`；spawned 依 .ready 顯示 starting/ready
    ready="$(jq -r 'if .spawned == true
                    then (if .ready == true then "ready" else "starting" end)
                    else "-" end' "$f")"
    printf '%s\t%s\t%s\n' "$name" "$pane" "$ready"
  done
}

cmd_send() {
  (( $# >= 1 )) || die "用法：agent-bridge send <agent> --from <sender> (--message <text> | --message-file <path>)"
  local to="$1"; shift
  local from="" mode="" val=""
  while (( $# > 0 )); do
    case "$1" in
      --from)
        shift; (( $# > 0 )) || die "--from 需要參數"
        from="$1" ;;
      --message)
        shift; (( $# > 0 )) || die "--message 需要參數"
        [[ -z "$mode" ]] || die "--message 與 --message-file 只能擇一"
        mode="text"; val="$1" ;;
      --message-file)
        shift; (( $# > 0 )) || die "--message-file 需要參數"
        [[ -z "$mode" ]] || die "--message 與 --message-file 只能擇一"
        mode="file"; val="$1" ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  [[ -n "$from" ]] || die "send 需要 --from <sender>"
  [[ -n "$mode" ]] || die "send 需要 --message 或 --message-file"
  # 訊息來源先驗再建 task 目錄：來源檔不存在時，原本會先留下一個沒有
  # metadata/status 的殘缺目錄才 die，而 gc 刻意只清完整形狀的目錄，
  # 等於永久孤兒（獨立複核 2026-07-24 指出）。write_message 內的檢查保留
  # 作為第二道（TOCTOU 空隙內被刪仍會擋）
  if [[ "$mode" == "file" && "$val" != "-" ]]; then
    [[ -f "$val" ]] || die "找不到訊息檔：$val"
  fi
  [[ "$to" =~ $NAME_RE ]]   || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$to"
  [[ "$from" =~ $NAME_RE ]] || die "sender 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$from"

  local agent_file="$AGENTS_DIR/$to.json"
  [[ -f "$agent_file" ]] || die "未註冊的 agent：$to（先用 agent-bridge register）"
  if jq -e '.spawned == true and .ready != true' "$agent_file" >/dev/null 2>&1; then
    err "警告：agent '$to' 尚未回報就緒（starting），通知可能延後；訊息已入 mailbox 不會遺失"
  fi
  local pane; pane="$(jq -r '.pane_id' "$agent_file")"

  local task_id dir tries=0
  while :; do
    task_id="$(date -u +%Y%m%dT%H%M%SZ)-$(rand_suffix)"
    dir="$TASKS_DIR/$task_id"
    if mkdir "$dir" 2>/dev/null; then
      break
    fi
    tries=$((tries + 1))
    (( tries < 5 )) || die "無法建立 task 目錄（task-id 連續碰撞）"
  done

  # 目錄一落地就掛回滾，直到 status 寫齊、成為完整形狀才解除（見 send_rollback）。
  # 以下各步顯式 die、不倚賴 errexit：cmd_send 會被 evict 以 `||` 呼叫端形式
  # 使用，該語境下 Bash 抑制 errexit（見 cmd_await 同款註記），裸失敗會靜靜
  # 做出缺 request 或缺 status 的殘缺 task
  SEND_RB_DIR="$dir"
  trap send_rollback EXIT
  write_message "$dir/request.md" "$mode" "$val" \
    || die "send 無法寫入 request（殘缺目錄已回滾）"

  local ts wd doc
  ts="$(now_iso)"
  wd="$(pwd)"
  doc="$(jq -n --arg id "$task_id" --arg from "$from" --arg to "$to" \
              --arg ts "$ts" --arg wd "$wd" --arg pin "$SEND_PIN" \
    '{version: 1, task_id: $id, from: $from, to: $to,
      created_at: $ts, updated_at: $ts,
      working_directory: $wd, status: "queued"}
     + (if $pin == "1" then {pinned: true} else {} end)')" \
    || die "send 無法生成 metadata（殘缺目錄已回滾）"
  printf '%s\n' "$doc" | atomic_write "$dir/metadata.json" \
    || die "send 無法寫入 metadata（殘缺目錄已回滾）"
  printf 'queued\n' | atomic_write "$dir/status" \
    || die "send 無法寫入 status（殘缺目錄已回滾）"
  SEND_RB_DIR=""
  log_event "$task_id" created "from=$from to=$to"

  # 通知前重讀 pane：從上面首讀到這裡隔著建目錄＋三次寫檔，期間同名 agent
  # 可能被 unregister＋register 換到別的 pane——舊 pane 若已屬別人的 session，
  # 這行 command＋Enter 就打進無辜視窗（獨立複核 2026-07-24 指出）。重讀把
  # 窗口縮到次毫秒級；徹底關閉需要「讀 registry 與 send-keys」原子化，tmux
  # 給不了（殘留窗口見 README 已知限制）。registry 消失／損壞時 pane 為空，
  # notify_pane 的 PANE_RE 會擋下、走既有 notify-failed 降級
  pane="$(jq -r '.pane_id' "$agent_file" 2>/dev/null)" || pane=""

  notify_or_defer "$to" "$pane" "agent-bridge receive $task_id" "$task_id" receive

  printf '%s\n' "$task_id"
}

cmd_receive() {
  (( $# == 1 )) || die "用法：agent-bridge receive <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  acquire_lock "$id"
  local st; st="$(<"$dir/status")"
  case "$st" in
    queued)
      update_meta_status "$dir" delivered
      log_event "$id" delivered
      ;;
    delivered|running)
      log_event "$id" re-receive
      ;;
    *)
      die "task 狀態為 $st，無法 receive（僅 queued/delivered/running 可）"
      ;;
  esac
  release_lock

  local from wd
  from="$(jq -r '.from' "$dir/metadata.json")"
  wd="$(jq -r '.working_directory' "$dir/metadata.json")"
  {
    printf 'task-id: %s\n' "$id"
    printf 'from: %s\n' "$from"
    printf 'working_directory: %s\n' "$wd"
  } >&2
  cat "$dir/request.md"
}

# parse_message_opts <cmd-name> <args...>：解析 --message / --message-file，
# 結果放進 MSG_MODE / MSG_VAL（bash 函式無法回傳多值，走全域）
MSG_MODE=""
MSG_VAL=""
parse_message_opts() {
  local cmdname="$1"; shift
  MSG_MODE=""; MSG_VAL=""
  while (( $# > 0 )); do
    case "$1" in
      --message)
        shift; (( $# > 0 )) || die "--message 需要參數"
        [[ -z "$MSG_MODE" ]] || die "--message 與 --message-file 只能擇一"
        MSG_MODE="text"; MSG_VAL="$1" ;;
      --message-file)
        shift; (( $# > 0 )) || die "--message-file 需要參數"
        [[ -z "$MSG_MODE" ]] || die "--message 與 --message-file 只能擇一"
        MSG_MODE="file"; MSG_VAL="$1" ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  [[ -n "$MSG_MODE" ]] || die "$cmdname 需要 --message 或 --message-file"
}

# respond_task <id> <final-status> <event> <cmd-name>：reply / fail 的共用主體——
# 寫 response.md、轉終態、通知 sender 讀回覆（訊息內容取自 MSG_MODE/MSG_VAL）
respond_task() {
  local id="$1" final="$2" ev="$3" cmdname="$4"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  acquire_lock "$id"
  local st; st="$(<"$dir/status")"
  if [[ "$st" != "delivered" && "$st" != "running" ]]; then
    die "task 狀態為 $st，僅 delivered/running 可 $cmdname（queued 請先 receive；終態不可再變更）"
  fi
  write_message "$dir/response.md" "$MSG_MODE" "$MSG_VAL"
  update_meta_status "$dir" "$final"
  log_event "$id" "$ev"
  release_lock

  local from; from="$(jq -r '.from' "$dir/metadata.json")"
  if [[ -f "$AGENTS_DIR/$from.json" ]]; then
    local pane; pane="$(jq -r '.pane_id' "$AGENTS_DIR/$from.json")"
    notify_or_defer "$from" "$pane" "agent-bridge read $id" "$id" read
  fi
}

cmd_reply() {
  (( $# >= 1 )) || die "用法：agent-bridge reply <task-id> (--message <text> | --message-file <path>)"
  local id="$1"; shift
  check_task_id "$id"
  parse_message_opts reply "$@"
  respond_task "$id" completed replied reply
  info "已回覆 task $id（completed）"
}

cmd_fail() {
  (( $# >= 1 )) || die "用法：agent-bridge fail <task-id> (--message <text> | --message-file <path>)"
  local id="$1"; shift
  check_task_id "$id"
  parse_message_opts fail "$@"
  respond_task "$id" failed failed fail
  info "已回報 task $id 失敗（failed）"
}

cmd_start() {
  (( $# == 1 )) || die "用法：agent-bridge start <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  acquire_lock "$id"
  local st; st="$(<"$dir/status")"
  if [[ "$st" != "delivered" ]]; then
    die "task 狀態為 $st，僅 delivered 可 start（queued 請先 receive）"
  fi
  update_meta_status "$dir" running
  log_event "$id" started
  release_lock
  info "task $id 開工（running）"
}

cmd_cancel() {
  (( $# == 1 )) || die "用法：agent-bridge cancel <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  acquire_lock "$id"
  local st; st="$(<"$dir/status")"
  case "$st" in
    queued|delivered|running) ;;
    *) die "task 狀態為 $st，無法 cancel（僅 queued/delivered/running 可）" ;;
  esac
  update_meta_status "$dir" cancelled
  log_event "$id" cancelled
  release_lock

  # 通知 worker 查狀態（會看到 cancelled）；通知失敗不影響取消本身
  local to; to="$(jq -r '.to' "$dir/metadata.json")"
  if [[ -f "$AGENTS_DIR/$to.json" ]]; then
    local pane; pane="$(jq -r '.pane_id' "$AGENTS_DIR/$to.json")"
    notify_or_defer "$to" "$pane" "agent-bridge status $id" "$id" status
  fi
  info "已取消 task $id（cancelled）"
}

cmd_status() {
  (( $# == 1 )) || die "用法：agent-bridge status <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"
  # 讀取走賦值再印，不內嵌在 printf 參數裡：內嵌時 $(<) 的讀取失敗只上
  # stderr、printf 本身照樣成功，缺 status 檔的損壞 task 會以 rc=0＋空輸出
  # 蒙混過監控（獨立複核 2026-07-24 指出）；賦值形式的失敗會傳導 rc
  local st
  st="$(<"$dir/status")" || die "task $id 的 status 檔讀取失敗（資料損壞），請檢查 $dir"
  printf '%s\n' "$st"
}

cmd_read() {
  (( $# == 1 )) || die "用法：agent-bridge read <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  # 取 task 鎖到 cat 完為止：gc --apply 刪目錄前取的就是這把鎖，read 不取的
  # 話，從驗完狀態到 cat response 之間目錄可被整個抽走（獨立複核 2026-07-24
  # 指出）。read 本就要寫 events.log，不是唯讀路徑，取鎖不改變它對 sandbox
  # 的要求；真正唯讀的 status／await 維持無鎖。鎖內任何 die 由 EXIT trap 釋鎖
  acquire_lock "$id"
  local st; st="$(<"$dir/status")"
  case "$st" in
    completed|failed) ;;
    cancelled)
      die "task $id 已取消（cancelled），沒有回覆可讀"
      ;;
    *)
      die "task $id 尚未回覆（狀態：$st）；查詢進度請用 agent-bridge status $id"
      ;;
  esac

  local from to
  from="$(jq -r '.from' "$dir/metadata.json")"
  to="$(jq -r '.to' "$dir/metadata.json")"
  {
    printf 'task-id: %s\n' "$id"
    printf 'from: %s\n' "$from"
    printf 'to: %s\n' "$to"
  } >&2
  log_event "$id" read
  cat "$dir/response.md"
  release_lock
}

# await：sender 端的等待原語。唯讀輪詢 status 檔（不寫 events、不取鎖），
# 在只讀 sandbox 內也能用；設計給「送出後在背景等回覆」的用法。
cmd_await() {
  (( $# >= 1 )) || die "用法：agent-bridge await <task-id> [--timeout <secs>]"
  local id="$1"; shift
  check_task_id "$id"
  local timeout=0
  while (( $# > 0 )); do
    case "$1" in
      --timeout)
        shift; (( $# > 0 )) || die "--timeout 需要參數"
        # 10# 強制十進位：前導零（08）否則會被 Bash 算術當八進位而爆錯；
        # 位數上限同時擋掉 64 位算術溢位
        [[ "$1" =~ ^[0-9]{1,9}$ ]] || die "--timeout 需為非負整數（秒，至多 9 位），0＝不逾時：$1"
        timeout=$((10#$1)) ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  # 輪詢間隔在進迴圈前就驗：壞值會讓 sleep 立刻報錯，set -e 下 await 毫秒級
  # 非零退出——呼叫端若把這種操作性失敗當成逾時（evict 曾如此），會殺掉還
  # 活著的 worker（獨立複核 2026-07-24 指出，實測 10ms 即死）。格式與非零
  # 檢查同 validate_ready_opts 的理由
  local interval="${AGENT_BRIDGE_POLL_INTERVAL:-1}" st
  [[ "$interval" =~ ^([0-9]+|[0-9]*\.[0-9]+)$ ]] \
    || die "AGENT_BRIDGE_POLL_INTERVAL 需為正數（秒）：$interval"
  [[ ! "$interval" =~ ^0*(\.0+)?$ ]] \
    || die "AGENT_BRIDGE_POLL_INTERVAL 需大於 0（否則輪詢忙迴圈）：$interval"
  SECONDS=0
  while :; do
    # 迴圈內的讀取與 sleep 都顯式 die、不倚賴 errexit：本函式被 evict 以
    # `||` 呼叫端包住，Bash 在該語境抑制整段 errexit——裸失敗（status 檔被
    # 移走、sleep 出錯）不會終止函式，會被靜靜輪詢到期限、誤分類成逾時
    # 124；--timeout 0 則變成無限輪詢（獨立複核 2026-07-24 第二輪以最小
    # 重現證實）。顯式 die 維持「124 只等於真逾時」的對外契約
    st="$(<"$dir/status")" \
      || die "await 無法讀取 task $id 的 status 檔（任務目錄被移走？）"
    case "$st" in
      completed|failed|cancelled)
        printf '%s\n' "$st"
        return 0
        ;;
    esac
    if (( timeout > 0 && SECONDS >= timeout )); then
      # 逾時用專屬 exit 124（同 timeout(1) 慣例）：呼叫端要能把「等到期限」
      # 與「await 自己壞掉」分開處置——前者是預期分支，後者不該觸發任何
      # 不可逆動作
      err "await 逾時（${timeout}s）：task $id 目前狀態 $st"
      exit 124
    fi
    sleep "$interval" \
      || die "await 的 sleep 失敗（interval=$interval）"
  done
}

# ---- spawn / despawn：worker pane 生命週期 ----

# 呼叫者定位："session_name:@window_id"。spawn 用它決定 worker 落點（owner），
# 審計用它記行為者（actor）。只認 TMUX 與 TMUX_PANE 同時存在、且 display-message
# 真的查得到的情況——TMUX_PANE 可能是繼承自已死 pane 或別台 server 的殘留值，
# 查不到就視同 tmux 外
caller_owner() {
  [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] || return 1
  local out
  out="$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}:#{window_id}' 2>/dev/null)" \
    || return 1
  [[ "$out" == *":@"* ]] || return 1
  printf '%s\n' "$out"
}

# 審計：$DATA_DIR/agents.log 追加 <ts> <action> <name> <pane> <runtime> <actor>
# disposable 也記一筆：它是回收決策的依據，日後若有「不該收的被收了」的爭議，
# 審計線要能還原「誰在什麼時候宣告自己可拋」
# actor＝動作執行者的呼叫者定位（tmux 外為 -）：despawn/evict 是公開指令，多
# orchestrator 並用時審計線要能還原「誰收的」。第 5 參數省略時就地解析
log_agent_event() {
  local action="$1" name="$2" pane="$3" runtime="$4" actor="${5:-}"
  if [[ -z "$actor" ]]; then
    actor="$(caller_owner)" || actor="-"
  fi
  # audit 行是空白分隔的固定 6 欄，但 name 以外的欄位可能取自 worker 可寫
  # 的 registry（disposable/despawn 讀出的 pane、runtime）或可偽造的環境
  # （actor 的 TMUX_PANE 指向誰、session 名含空白）。欄位安全在這個唯一
  # 咽喉點保證：全欄摺空白、空值補 -，不靠上游自律（獨立複核 2026-07-25
  # 兩輪：actor 7 欄、pane/runtime 8 欄實例）。identity 維持 best-effort：
  # actor 是 provenance，不是認證
  name="${name//[[:space:]]/_}";       [[ -n "$name" ]] || name="-"
  pane="${pane//[[:space:]]/_}";       [[ -n "$pane" ]] || pane="-"
  runtime="${runtime//[[:space:]]/_}"; [[ -n "$runtime" ]] || runtime="-"
  actor="${actor//[[:space:]]/_}";     [[ -n "$actor" ]] || actor="-"
  printf '%s %s %s %s %s %s\n' "$(now_iso)" "$action" "$name" "$pane" "$runtime" "$actor" \
    >> "$DATA_DIR/agents.log"
}

# spawn 失敗回滾：EXIT trap 讀取。解除回滾靠單一旗標而非逐一清空三個變數——
# 訊號可能落在兩次賦值之間，讓 trap 看到「有 tag、沒有 registry 路徑」這種
# 半清空狀態，於是殺了 pane 卻留下 registry
SPAWN_DONE=0
SPAWN_RB_PANE=""
SPAWN_RB_REG=""
SPAWN_RB_TAG=""
# rb_kill_tagged <pane>：原子地「驗 tag 才殺」，並確認 pane 真的消失。
# 與 cmd_despawn 同一套理由——分成「查一次、再殺一次」的話，中間 tmux server
# 若被替換，第二次呼叫會殺到新 server 上同 id 的人工 pane。回傳 0＝已不存在
# shellcheck disable=SC2329  # 經 spawn_rollback 間接呼叫
rb_kill_tagged() {
  local p="$1" after
  [[ "$p" =~ $PANE_RE ]] || return 1
  tmux if-shell -t "$p" -F "#{m:\"$SPAWN_RB_TAG *,#{pane_start_command}}" \
    "kill-pane -t $p" 2>/dev/null || true
  # 查詢失敗要回報「無法確認」而不是「已消失」：把 tmux 掛掉當成 pane 不見了，
  # 正是 despawn 那條被揪出來的錯誤判斷方向
  after="$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null)" || return 1
  ! grep -Fx "$p" <<< "$after" >/dev/null
}

# shellcheck disable=SC2329  # 經 EXIT trap 間接呼叫
spawn_rollback() {
  # spawn 已完成：單一旗標，讀到就整個 no-op
  (( SPAWN_DONE == 1 )) && return 0
  # 全程容錯：本函式在 EXIT trap 的第一順位，任一步以非零收場都會在 set -e
  # 下吃掉後面的 release_lock，留下鎖殘留
  if [[ -n "$SPAWN_RB_TAG" ]]; then
    if [[ -n "$SPAWN_RB_PANE" ]]; then
      rb_kill_tagged "$SPAWN_RB_PANE" \
        || err "警告：回滾未能關閉 pane $SPAWN_RB_PANE，請手動確認後 tmux kill-pane -t $SPAWN_RB_PANE"
    else
      # pane 已建立但 pane id 沒回到手上（命令替換失敗、輸出遺失、中途被中斷）：
      # 靠啟動指令裡的一次性 tag 掃出孤兒 pane，否則它永遠沒人認領。
      # 比對必須錨在啟動指令**開頭**（tag 是我們自己加的 env 前綴）：無邊界的
      # 子字串比對會誤殺任何參數裡碰巧含這串的別人 pane
      # 查詢失敗不能吞：迴圈跑零次跟「沒有孤兒」長得一模一樣，
      # 靜默下去就是留一個沒人認領的 pane 卻宣稱回滾乾淨
      local pid cmd scan
      if scan="$(tmux list-panes -a -F '#{pane_id} #{pane_start_command}' 2>/dev/null)"; then
        while read -r pid cmd; do
          # tmux 會把整條啟動指令加雙引號存進 pane_start_command（實測 3.7b），
          # 先剝掉前導引號才錨得住開頭
          cmd="${cmd#\"}"
          if [[ "$cmd" == "$SPAWN_RB_TAG "* ]]; then
            rb_kill_tagged "$pid" \
              || err "警告：回滾未能關閉孤兒 pane $pid，請手動確認後 tmux kill-pane -t $pid"
          fi
        done <<< "$scan"
      else
        err "警告：回滾無法查詢 tmux pane，可能殘留一個啟動指令帶 $SPAWN_RB_TAG 的孤兒 pane，請手動確認並關閉"
      fi
    fi
  fi
  if [[ -n "$SPAWN_RB_REG" ]]; then
    # 刪不掉要講出來：靜默吞掉會留下一筆沒有 pane 的殭屍 registry，
    # 它照樣佔 cap、也擋住同名 spawn。不中止 trap（否則吃掉 release_lock）
    rm -f -- "$SPAWN_RB_REG" 2>/dev/null \
      || err "警告：回滾未能刪除 registry $SPAWN_RB_REG，請手動清除（它仍佔用 spawn 名額）"
  fi
  # 回滾只做一次：同樣用單一旗標，不逐一清空（理由同上）
  SPAWN_DONE=1
}

# 就緒自報到：間隔重送探針（agent-bridge ready <name>）直到 registry 翻
# ready 或逾時。REPL 啟動期吃掉的按鍵靠重送覆蓋；逾時不回滾、僅警告，
# pane 留用供人工診斷。
# validate_ready_opts：兩個 readiness 參數必須在建 pane 之前就驗。等到
# spawn_wait_ready 才 die 的話，pane 與 registry 都已落地、回滾也已解除，
# 呼叫端只看到非零退出，卻留下一個佔著 cap 的 worker
validate_ready_opts() {
  local t="${AGENT_BRIDGE_READY_TIMEOUT:-30}" i="${AGENT_BRIDGE_READY_PROBE_INTERVAL:-2}"
  [[ "$t" =~ ^[0-9]{1,9}$ ]] \
    || die "AGENT_BRIDGE_READY_TIMEOUT 需為非負整數（秒，至多 9 位；0＝不等待）：$t"
  [[ "$i" =~ ^([0-9]+|[0-9]*\.[0-9]+)$ ]] \
    || die "AGENT_BRIDGE_READY_PROBE_INTERVAL 需為正數（秒）：$i"
  # 格式已確認是數字，所以「小數點前後都只有 0（或省略整數位）」即代表零值。
  # 寫成 ^0+... 會漏掉 .0／.00 這種省略整數位的零
  [[ ! "$i" =~ ^0*(\.0+)?$ ]] \
    || die "AGENT_BRIDGE_READY_PROBE_INTERVAL 需大於 0（否則探針會忙迴圈）：$i"
}

# 把 brief 檔＋動態尾巴組成 runtime 的 initial prompt 參數（單一 shell word）。
# brief 全文刻意不進命令列：改讓 tmux 的 sh -c 在 pane 內展開 $(cat ...)，
# 啟動指令因此維持短、pane_start_command 仍可讀，也免去把整份 Markdown 塞進
# 命令字串的跳脫地獄。代價是展開時機延到 pane 啟動：brief 雖已於建 pane 前
# 驗過是可讀的普通檔案，那之後仍有 TOCTOU 空隙——被刪或換掉會退化成沒有守則
# 的 worker，換成 FIFO 之類讀不完的來源則會讓 pane 卡在讀取。兩者都不會殺錯
# 東西，但後者會留下佔 cap 的 starting pane（見 README.zh-TW.md「殘留缺口」）
worker_prompt_arg() {
  local name="$1" brief="$2"
  # 路徑要以單引號字面值送進 sh；含單引號就湊不出安全的字面值，fail-closed
  [[ "$brief" != *"'"* ]] || die "worker brief 路徑不可含單引號：$brief"
  # 尾巴保持單行：換行進 tmux 命令字串只是徒增變數。
  # $name 已由 NAME_RE 限成 [A-Za-z0-9_-]+，沒有注入面
  # shellcheck disable=SC2016  # $(cat …) 刻意不在此展開，留給 pane 內的 sh
  # `cat --`：AGENT_BRIDGE_WORKER_BRIEF 是公開覆蓋介面，接得到相對路徑；
  # 少了 option terminator，一個叫 `--help` 的檔案會被 cat 當成選項，
  # spawn 照樣成功卻注入了完全錯誤的 prompt
  printf '"$(cat -- '\''%s'\'')  -- The above is your worker brief. Your agent name is %s. First action: immediately run agent-bridge ready %s"' \
    "$brief" "$name" "$name"
}

# relay 版的 initial prompt：接手者守則 ＋ 交接檔路徑 ＋（可選）要回收的前一棒。
# 與 worker_prompt_arg 的三道防線相同，但這裡更要緊：handoff 路徑來自使用者
# 命令列，不像 WORKER_BRIEF 是內部常數，暴露面大一級
relay_prompt_arg() {
  local name="$1" brief="$2" handoff="$3" prev="$4"
  [[ "$brief" != *"'"* ]] || die "接手者 brief 路徑不可含單引號：$brief"
  [[ "$handoff" != *"'"* ]] || die "交接檔路徑不可含單引號：$handoff"
  # prev 已由呼叫端以 NAME_RE 驗過，這裡不再展開成 shell 字面值以外的東西
  local tail=""
  if [[ -n "$prev" ]]; then
    tail="After taking over, reclaim your predecessor: run agent-bridge despawn $prev (if it was a manually started session the command is refused — that is normal; keep working)."
  fi
  # shellcheck disable=SC2016  # $(cat …) 刻意不在此展開，留給 pane 內的 sh
  printf '"$(cat -- '\''%s'\'')  -- The above is your successor brief. Your agent name is %s. Handoff file to continue from: %s. First action: immediately run agent-bridge ready %s, then read that handoff and start on its next steps. %s"' \
    "$brief" "$name" "$handoff" "$name" "$tail"
}

spawn_wait_ready() {
  local name="$1" pane="$2"
  # 兩個參數已由 validate_ready_opts 在建 pane 前驗過
  local timeout="${AGENT_BRIDGE_READY_TIMEOUT:-30}"
  local interval="${AGENT_BRIDGE_READY_PROBE_INTERVAL:-2}"
  timeout=$((10#$timeout))
  if (( timeout == 0 )); then
    return 0
  fi
  local reg="$AGENTS_DIR/$name.json"
  SECONDS=0
  while :; do
    if jq -e '.ready == true' "$reg" >/dev/null 2>&1; then
      info "agent '$name' 已回報就緒（ready）"
      return 0
    fi
    if (( SECONDS >= timeout )); then
      err "警告：agent '$name' 於 ${timeout}s 內未回報就緒；pane $pane 留用供診斷，可於該 pane 手動執行：agent-bridge ready $name"
      return 0
    fi
    notify_pane "$pane" "agent-bridge ready $name" || true
    sleep "$interval"
  done
}

cmd_spawn() {
  (( $# >= 1 )) || die "用法：agent-bridge spawn <name> --runtime <codex|claude> [--model <model>] [--window]"
  local name="$1"; shift
  local runtime="" model="" use_window=0
  while (( $# > 0 )); do
    case "$1" in
      --runtime)
        shift; (( $# > 0 )) || die "--runtime 需要參數"
        runtime="$1" ;;
      --model)
        shift; (( $# > 0 )) || die "--model 需要參數"
        model="$1"
        # 在解析點就驗、不等到用時：這個值會進 pane 啟動命令字串（見 MODEL_RE
        # 的註解），不合法就必須在建 pane 之前死掉
        [[ "$model" =~ $MODEL_RE ]] \
          || die "model 名稱不合法（僅允許英數起首的 [A-Za-z0-9._-]{1,64}）：$model" ;;
      --window) use_window=1 ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  [[ -n "$runtime" ]] || die "spawn 需要 --runtime <runtime>（支援 codex、claude）"

  # runtime 表：指令 ＋ 守則注入方式。目前每個 runtime 都走「initial prompt
  # 位置參數」（codex/claude/gemini 等 agent CLI 的共通形狀：`cmd [OPTIONS]
  # [PROMPT]`）。新增 runtime 前先實測該 CLI 的位置參數確實會被當第一則 user
  # message 執行；若某個 runtime 只吃 stdin 或需要別的旗標，這裡要一併長出
  # 對應的注入方式，不要硬套。
  #
  # claude 的取捨（實測 Claude Code，形狀 `claude [options] [command] [prompt]`）：
  #   - `--permission-mode auto`：worker 必須零人工介入執行探針命令。auto 雖已是
  #     此機器的預設，仍明寫——runtime 表不該依賴使用者哪天改掉 defaultMode。
  #     刻意不用 bypassPermissions。理由只取官方文件明載的部分，不臆測機制：
  #     官方把該模式定位為「Isolated containers and VMs only」，而 worker pane
  #     就跑在使用者本機、與主 session 共用檔案系統與憑證，不是隔離環境；
  #     auto 則是「Everything, with background safety checks」，保留那層背景
  #     檢查，且 protected paths 的寫入在除 bypass 外的所有模式都不會被自動
  #     核准。（注意：bypassPermissions 並不停用 hooks——停用 hooks 的是
  #     --bare；deny 與 explicit ask 規則在該模式下也仍然適用。早期版本的這段
  #     註解兩度寫錯這個因果，由獨立複核對照官方文件糾正）
  #   - `--settings <CLAUDE_HOOKS_SETTINGS>`（通知原生化 Phase 2 新增）：worker
  #     仍繼承使用者全域設定，與主 session 同一套安全規則——hooks 分層是合併
  #     不是覆蓋，這條「不加 --setting-sources」的取捨沒被推翻。完整理由見
  #     CLAUDE_HOOKS_SETTINGS 常數處的註解，不在此重複。代價（worker brief 與
  #     全域守則並存、可能被全域規則改寫命令形式）與上一版一致，不受影響：
  #     `agent-bridge` 是外部 CLI、沒有等價工具，不受那條影響
  #   - 不可用 -p/--print：那是 headless，跑完即退出，pane 不會留下來收探針
  local runtime_cmd
  case "$runtime" in
    codex) runtime_cmd="codex --profile agent-worker" ;;
    claude) runtime_cmd="claude --permission-mode auto --settings $(printf %q "$CLAUDE_HOOKS_SETTINGS")" ;;
    *) die "不支援的 runtime：$runtime（支援 codex、claude）" ;;
  esac
  # --model：兩個 runtime 都吃 `--model` 長旗標（實測 claude --help 與
  # codex --help，2026-07-23）。不指定＝繼承該 CLI 的使用者預設——注意主
  # session 預設模型換到高階層級時，這裡的預設會跟著變貴；派工建議見
  # share/orchestrator-brief.md
  [[ -n "$model" ]] && runtime_cmd+=" --model $model"
  command -v tmux >/dev/null 2>&1 || die "找不到 tmux，spawn 需要 tmux"
  command -v "${runtime_cmd%% *}" >/dev/null 2>&1 \
    || die "找不到 runtime 指令：${runtime_cmd%% *}"

  # claude hooks settings 存在性預檢：只在 runtime=claude 檢查——codex 分支
  # 不吃 --settings，不該因為這份 claude 專屬檔缺失而 spawn 失敗。理由同
  # WORKER_BRIEF 的預檢（下面 brief_path 那段）：必須在建 pane 之前 die，
  # pane 落地後才死會留下一個佔 cap 的孤兒 worker。讀不到這份檔不是 exec
  # 階段才會發現的失敗——claude CLI 對指到不存在路徑的 --settings 如何反應
  # 未經查證，寧可在 spawn 這層就把它當硬性前提擋下，不去賭 CLI 那端的容錯。
  # 同樣要求普通檔案（-f）而非只驗可讀（-r）：理由與 brief 預檢一致，見那段
  # 註解，不重複
  if [[ "$runtime" == claude ]]; then
    [[ -f "$CLAUDE_HOOKS_SETTINGS" && -r "$CLAUDE_HOOKS_SETTINGS" ]] \
      || die "claude hooks settings 不是可讀的普通檔案：$CLAUDE_HOOKS_SETTINGS（可用 AGENT_BRIDGE_CLAUDE_HOOKS 指定）"
  fi

  # owner 定位：worker 的落點跟著 orchestrator 走，不跟著使用者的眼睛走。
  # tmux 對不帶 -t 的 split/new-window 解析到「attached client 的 active
  # window」——orchestrator 放在背景 window 跑時，worker 會切進使用者正在
  # 作業的視窗（實際故障回報 2026-07-25）。tmux 外呼叫或 TMUX_PANE 已失效
  # 則 owner 為空，落點維持舊行為
  # owner_win 另存 @window_id：new-window 的 -t 是 target-window、拒收 pane id
  # （實測 "can't specify pane here"），錨點必須用 window 形式。session 名稱
  # 理論上可含冒號，取尾段後再驗 WINDOW_RE，格式不對就整組放棄 owner
  local owner="" owner_win="" owner_winname=""
  if owner="$(caller_owner)"; then
    owner_win="${owner##*:}"
    if [[ "$owner_win" =~ $WINDOW_RE ]]; then
      owner_winname="$(tmux display-message -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null)" \
        || owner_winname=""
    else
      owner="" owner_win=""
    fi
  else
    owner=""
  fi

  # brief 讀不到就不開 pane：沒有守則的 worker 收到探針只會當成對話回覆，
  # 開出來也是壞的（正是這條路徑當初讓 Phase 4 gate 失敗）。檢查必須在建
  # pane 之前，理由同 validate_ready_opts：pane 落地後才 die 會留下一個
  # 佔著 cap 的 worker
  # 要驗普通檔案，不能只驗可讀：`[[ -r ]]` 對目錄一樣成立，而 pane 內的
  # `cat` 讀目錄會失敗、命令替換卻仍返回空字串，runtime 照樣被 exec 起來——
  # 於是開出一個沒有守則的 worker，正好是這道檢查要擋的東西。-f 一併擋掉
  # FIFO 與裝置檔（cat 會卡住或讀出無關內容）
  # relay 模式注入接手者守則，其餘（cap、tag、回滾、夭折偵測、registry）完全
  # 共用——那條路徑的安全不變量經過九輪複核，不複製第二份
  local brief_path="$WORKER_BRIEF" brief_kind="worker brief" brief_env="AGENT_BRIDGE_WORKER_BRIEF"
  if [[ -n "$RELAY_HANDOFF" ]]; then
    brief_path="$SUCCESSOR_BRIEF"; brief_kind="接手者 brief"; brief_env="AGENT_BRIDGE_SUCCESSOR_BRIEF"
  fi
  [[ -f "$brief_path" && -r "$brief_path" ]] \
    || die "$brief_kind 不是可讀的普通檔案：$brief_path（可用 $brief_env 指定）"

  validate_ready_opts

  local max="${AGENT_BRIDGE_MAX_SPAWN:-4}"
  [[ "$max" =~ ^[0-9]{1,9}$ ]] || die "AGENT_BRIDGE_MAX_SPAWN 需為非負整數：$max"
  max=$((10#$max))

  # cap 檢查、建 pane、註冊全部包在 registry 鎖內，杜絕並行 spawn 繞過 cap；
  # 鎖內任一步失敗 → EXIT trap 回滾（kill 已建 pane＋刪 registry 檔）
  acquire_lock agents-registry
  trap 'spawn_rollback || true; release_lock' EXIT

  if [[ -e "$AGENTS_DIR/$name.json" ]]; then
    die "agent '$name' 已註冊，spawn 不覆蓋（人工註冊請先 unregister；spawned 請先 despawn）"
  fi

  # 無法解析的 registry 保守計入 cap：漏算會讓上限形同虛設，寧可少開一個
  local count=0 f sp_rc
  for f in "$AGENTS_DIR"/*.json; do
    [[ -e "$f" ]] || continue
    sp_rc=0
    is_spawned "$f" || sp_rc=$?
    case $sp_rc in
      0|2) count=$((count + 1)) ;;
    esac
  done
  (( count < max )) \
    || die "已達 spawn 上限（AGENT_BRIDGE_MAX_SPAWN=$max，現有 spawned agent $count 個）；先 despawn 閒置 worker"

  # 一次性 tag 先於建 pane 設好：pane 一旦誕生就認得出是誰的，即使 pane id
  # 沒能回到手上，回滾仍掃得到（見 spawn_rollback）
  # tag 是刪除的依據，熵不能省：PID 會重用，光靠 16 位隨機值在舊 pane 仍留著
  # 啟動指令的情況下有誤中風險，故取 48 位。agent 名字也編進去：registry 位在
  # worker 可寫的資料目錄，若 tag 與名字無關，被注入的 worker A 只要把 B 的
  # tag 抄進自己的 registry，就能讓 orchestrator 的 `despawn A` 殺掉 B 的 pane
  local tag tagged_cmd pane
  tag="ab-spawn-$name-$$-$(rand_suffix)$(rand_suffix)$(rand_suffix)"
  local prompt_arg
  if [[ -n "$RELAY_HANDOFF" ]]; then
    prompt_arg="$(relay_prompt_arg "$name" "$brief_path" "$RELAY_HANDOFF" "$RELAY_PREV")"
  else
    prompt_arg="$(worker_prompt_arg "$name" "$brief_path")"
  fi
  # proxy 環境穿透：pane 的環境繼承自 tmux server，不是 spawn 呼叫者——
  # orchestrator shell 才有的 proxy 變數（profile/alias 注入）到不了 worker，
  # 在強制走 proxy 的網路裡 runtime 會直連而死（受限網路實測：MITM 憑證
  # 過期，SSL 錯誤）。故把呼叫者環境裡的標準 proxy 變數拼進啟動指令。
  # 值以 printf %q 逐個跳脫（值來自 orchestrator 自己的環境，與執行 spawn 的
  # 人同一信任域，跳脫是防意外拆詞，不是防注入）；空值照傳（保持與呼叫者
  # 環境等價）。tag 必須維持第一個 token：rollback 與 despawn 都以
  # 「tag＋空白」做 pane_start_command 前綴比對
  local proxy_env="" pv
  for pv in http_proxy https_proxy all_proxy no_proxy \
            HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY; do
    [[ -n "${!pv+x}" ]] && proxy_env+="$pv=$(printf %q "${!pv}") "
  done
  # 同一條穿透路徑的白名單延伸：呼叫端用 AGENT_BRIDGE_PASS_ENV（逗號分隔）指名
  # 還要帶哪些變數過去。典型用途是 headless 姿態旗標（例如 CLAUDE_UNATTENDED）：
  # 那類變數若留在呼叫者身上，接手者 pane 會靜默退回有人值守的寬鬆姿態——靜默
  # 降級比明確失敗難察覺得多。只帶「已設」的變數（未設就跳過，不塞空值）；變數
  # 名逐個驗格式，擋掉往啟動指令拼接的意外詞。用 read -ra 而非未引號展開，免得
  # 變數名裡的 glob 字元被 cwd 的檔名撐開。
  local pass_env="" pe
  local -a pass_list=()
  IFS=',' read -ra pass_list <<<"${AGENT_BRIDGE_PASS_ENV:-}"
  for pe in "${pass_list[@]}"; do
    [[ -n "$pe" ]] || continue
    [[ "$pe" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] \
      || die "AGENT_BRIDGE_PASS_ENV 含不合法的變數名：$pe"
    [[ -n "${!pe+x}" ]] && pass_env+="$pe=$(printf %q "${!pe}") "
  done
  # 接力鏈深度只在 relay 路徑下傳：spawn 出來的 worker 不是接力鏈的一環。
  # 用 if 而非 `[[ ]] &&`——後者作為函數體的獨立語句，條件不成立時會讓
  # set -e 收掉整支（迴圈末句不觸發，獨立語句會）
  local depth_env=""
  if [[ -n "$RELAY_HANDOFF" ]]; then
    depth_env="AGENT_BRIDGE_RELAY_DEPTH=$RELAY_DEPTH_NEXT "
  fi
  tagged_cmd="AGENT_BRIDGE_SPAWN_TAG=$tag ${proxy_env}${pass_env}${depth_env}exec $runtime_cmd $prompt_arg"
  # 回滾比對的是「env 前綴＋一個空白」，見 spawn_rollback
  SPAWN_RB_TAG="AGENT_BRIDGE_SPAWN_TAG=$tag"
  # per-owner worker window：同 owner 先前的 worker window 還活著就沿用（split
  # 進去＋tiled 重排），否則新建一個緊鄰 orchestrator window 之後。回查走
  # registry 的 worker_window @id，不比對 window 名字——名字可改可撞，@id 在
  # server 存活期間唯一。--window 的專屬視窗不寫 worker_window，不會被撿去
  # 共用。查表在 registry 鎖內：兩個並行 spawn 不會為同一 owner 各開一窗
  local worker_win="" wf ww
  if [[ -n "$owner" ]] && (( use_window == 0 )); then
    for wf in "$AGENTS_DIR"/*.json; do
      [[ -e "$wf" ]] || continue
      ww="$(jq -r --arg o "$owner" \
        'select((.owner // "") == $o) | .worker_window // empty' "$wf" 2>/dev/null)" \
        || continue
      [[ "$ww" =~ $WINDOW_RE ]] || continue
      tmux list-windows -a -F '#{window_id}' 2>/dev/null | grep -Fx "$ww" >/dev/null \
        || continue
      # 反 confused-deputy（獨立複核 2026-07-25 兩輪收斂）：registry 對每個
      # worker 可寫，@id 語法合法、window 存在都冒充得了；第一版 gate 驗
      # 「同 session＋ab: 名稱」仍被第二輪反例擊穿——同 session 冒用他 owner
      # 的合法 worker window。信任根源必須放在攻擊面之外：建窗時把 owner 印
      # 記寫進 tmux 視窗選項 @ab_owner，沿用前驗證其值等於「本次 live 解析」
      # 的 owner——只能寫 registry 的攻擊者碰不到 tmux 選項。未設選項時
      # show-options 以非零收場（實測 tmux 3.7b），一樣走 continue。有 tmux
      # 權限的敵意 agent 仍可繞（tmux 無隔離，見 README 已知限制），不在此
      # 層防禦範圍
      local ww_owner
      ww_owner="$(tmux show-options -wv -t "$ww" '@ab_owner' 2>/dev/null)" \
        || continue
      [[ "$ww_owner" == "$owner" ]] || continue
      worker_win="$ww"
      break
    done
  fi
  if (( use_window == 1 )); then
    if [[ -n "$owner" ]]; then
      # 錨定在 orchestrator window 之後；不帶 -t 的落點跟著 client 焦點走
      pane="$(tmux new-window -dP -a -t "$owner_win" -F '#{pane_id}' "$tagged_cmd")" \
        || die "tmux new-window 失敗"
    else
      pane="$(tmux new-window -dP -F '#{pane_id}' "$tagged_cmd")" \
        || die "tmux new-window 失敗"
    fi
  elif [[ -n "$worker_win" ]]; then
    pane="$(tmux split-window -dP -t "$worker_win" -F '#{pane_id}' "$tagged_cmd")" \
      || die "tmux split-window 失敗"
    tmux select-layout -t "$worker_win" tiled >/dev/null 2>&1 || true
  elif [[ -n "$owner" ]]; then
    pane="$(tmux new-window -dP -a -t "$owner_win" -n "ab:${owner_winname:-workers}" -F '#{pane_id}' "$tagged_cmd")" \
      || die "tmux new-window 失敗"
  else
    # tmux 外呼叫（腳本、CI、測試）：無從得知 owner，維持舊行為切在目前視窗
    pane="$(tmux split-window -dP -F '#{pane_id}' "$tagged_cmd")" \
      || die "tmux split-window 失敗"
  fi
  [[ -n "$pane" ]] || die "tmux 未回傳 pane id"
  SPAWN_RB_PANE="$pane"

  # 立刻夭折偵測：runtime 指令不存在／啟動即出錯時 pane 會瞬間消失
  sleep 0.3
  if ! tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -Fx "$pane" >/dev/null; then
    die "runtime 啟動即失敗（pane $pane 已消失）：$runtime_cmd"
  fi

  # 落點記錄與身分標示：worker_window 供同 owner 後續 spawn 沿用（--window 的
  # 專屬視窗不共用故不寫）；pane 標題讓多 worker 同窗時邊框直接可辨識。標示
  # 失敗不致命——pane 已活著，裝飾性操作不該讓 spawn 翻盤
  local placed_win="" reg_win=""
  placed_win="$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null)" \
    || placed_win=""
  [[ "$placed_win" =~ $WINDOW_RE ]] || placed_win=""
  if [[ -n "$owner" ]] && (( use_window == 0 )); then
    reg_win="$placed_win"
  fi
  if [[ -n "$reg_win" ]]; then
    if [[ -n "$worker_win" ]]; then
      # 沿用：印記已驗證存在且正確才走得進來，重寫只是冪等，失敗無害
      tmux set-option -w -t "$reg_win" '@ab_owner' "$owner" 2>/dev/null || true
    else
      # 新建：這筆寫入是 trust root 的建立，失敗必須翻盤——靜默吞掉會做出
      # 「spawn 成功但永不可沿用」的窗，違反「同 owner 沿用同一窗」的文件化
      # 行為且無任何警告（獨立複核第三輪指出）。此點在 SPAWN_RB_PANE 之後、
      # SPAWN_DONE 之前，die 由 EXIT trap 回滾（sole-pane window 隨 pane
      # 一同消失）
      tmux set-option -w -t "$reg_win" '@ab_owner' "$owner" 2>/dev/null \
        || die "worker window 所有權印記（@ab_owner）寫入失敗，回滾 spawn"
    fi
  fi
  tmux select-pane -t "$pane" -T "$name (${runtime}${model:+/$model})" 2>/dev/null || true
  if [[ -n "$owner" ]]; then
    tmux set-option -w -t "$pane" pane-border-status top 2>/dev/null || true
  fi

  local ts doc
  ts="$(now_iso)"
  # spawn_tag 一併存進 registry：pane id 會被 tmux 重用（不同 server、server
  # 重啟後計數器歸零），光憑 id 無法證明「這個 pane 就是我 spawn 的那一個」。
  # despawn 殺之前用它跟 pane 的啟動指令對得上才動手
  # model 一併入 registry：空字串＝沿用 runtime CLI 的預設。回收決策（挑誰
  # evict）與事後追查（這個 worker 當時跑什麼模型）都用得到
  # owner／worker_window 一併入 registry：owner 是 per-owner window 回查與審計
  # 行為者的依據；空字串＝tmux 外 spawn（舊行為落點，無主）
  doc="$(jq -n --arg name "$name" --arg pane "$pane" --arg ts "$ts" --arg rt "$runtime" \
              --arg tag "$SPAWN_RB_TAG" --arg model "$model" \
              --arg owner "$owner" --arg wwin "$reg_win" \
    '{name: $name, pane_id: $pane, registered_at: $ts,
      spawned: true, runtime: $rt, model: $model, spawned_at: $ts, ready: false,
      spawn_tag: $tag, owner: $owner, worker_window: $wwin}')"
  SPAWN_RB_REG="$AGENTS_DIR/$name.json"
  printf '%s\n' "$doc" | atomic_write "$AGENTS_DIR/$name.json"
  log_agent_event spawned "$name" "$pane" "$runtime" "${owner:--}"

  # 註冊完成即視為 spawn 成功：一次賦值解除回滾，之後就緒逾時只警告不回滾
  SPAWN_DONE=1
  release_lock || true

  # 這之後 worker 已經存在且註冊在案，任何失敗都不該讓呼叫端以為 spawn 失敗
  # ——它會照著「失敗」去重試或放棄，實際卻留著一個佔 cap 的 worker。
  # 輸出寫不出去（stdout/stderr 被關、EPIPE）是最實際的一種
  info "已 spawn agent '$name' → pane $pane（runtime：$runtime）" || true
  printf '%s\n' "$pane" || true
  spawn_wait_ready "$name" "$pane" || true
  return 0
}

# relay：把主導權交給一個新 session。與 spawn 的差別只有兩處——注入接手者
# 守則（而非 worker 守則）、以及把焦點切過去；cap／tag／回滾／夭折偵測／
# registry 全部共用 cmd_spawn。
#
# --self-exit <my-name> 不是「自殺」：它把回收工作寫進接手者的 prompt，由 B
# 在 ready 之後 `despawn A`。這樣做不是繞路，是因為既有 despawn 的順序是
# 「kill pane → 確認已死 → 清 registry → 寫審計」（見 cmd_despawn），A 若殺
# 自己的 pane，執行中的 process 會被 SIGHUP 帶走，永遠走不到後兩步——registry
# 殘留、審計線斷掉。交給活著的 B 執行，順序不變量原封不動。
# 附帶好處：接力鏈第一棒是人工 pane，B 去 despawn 它會被既有的「非 spawn 出身，
# despawn 拒絕」擋下，第一棒的人工閘門不需要另寫檢查就成立。
cmd_relay() {
  (( $# >= 1 )) || die "用法：agent-bridge relay <name> --runtime <codex|claude> [--model <model>] --handoff <path> [--window] [--no-select] [--self-exit <my-name>]"
  local name="$1"; shift
  local runtime="" model="" use_window=0 handoff="" prev="" no_select=0
  while (( $# > 0 )); do
    case "$1" in
      --runtime)
        shift; (( $# > 0 )) || die "--runtime 需要參數"
        runtime="$1" ;;
      --model)
        # 只收值、不在這裡驗：驗證的正本在 cmd_spawn 的解析點（同一條
        # MODEL_RE），relay 直通即可，抄第二份遲早漂移
        shift; (( $# > 0 )) || die "--model 需要參數"
        model="$1" ;;
      --handoff)
        shift; (( $# > 0 )) || die "--handoff 需要參數"
        handoff="$1" ;;
      --self-exit)
        shift; (( $# > 0 )) || die "--self-exit 需要參數（你自己的 agent 名稱）"
        prev="$1" ;;
      --window) use_window=1 ;;
      --no-select) no_select=1 ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  [[ -n "$handoff" ]] || die "relay 需要 --handoff <path>（要交棒的交接檔）"
  [[ -z "$prev" || "$prev" =~ $NAME_RE ]] \
    || die "--self-exit 的 agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$prev"
  # 交接檔的兩道檢查都必須在建 pane 之前，理由同 brief：pane 落地後才 die 會
  # 留下佔 cap 的孤兒。-f 一併擋掉目錄與 FIFO（cat 讀目錄會失敗但命令替換仍
  # 回空字串，接手者會拿到一份沒有交接內容的 prompt；FIFO 則讓 pane 卡在讀取）
  [[ "$handoff" != *"'"* ]] || die "交接檔路徑不可含單引號：$handoff"
  [[ -f "$handoff" && -r "$handoff" ]] \
    || die "交接檔不是可讀的普通檔案：$handoff"

  # 接力鏈深度上限。這條鏈設計上鼓勵「context 吃緊就再交棒」（接手者守則末段），
  # 沒有上界就是無界遞迴：無人值守時一路接下去，燒掉的額度沒有天花板。深度靠
  # AGENT_BRIDGE_RELAY_DEPTH 在鏈上逐棒下傳（見 cmd_spawn 拼 tagged_cmd 處）——
  # 人工起的第一棒沒有這個變數＝深度 0，其後每 relay 一次 +1。
  # 檢查必須在建 pane 之前，理由同上面兩道交接檔檢查。
  # 已知限制：pane 內可以自行改寫這個變數繞過（與 registry 同屬 worker 可寫面，
  # 見 README 已知限制）。這道 cap 擋的是失控迴圈，不是蓄意繞過。
  # 展開用 ${VAR-default} 而非 ${VAR:-default}：後者把「已設但為空」也吃成預設，
  # 於是 AGENT_BRIDGE_RELAY_DEPTH='' 會在驗證前就變成 0——鏈深度被靜默重置，cap
  # 形同虛設（獨立複核 2026-07-25 對抗重跑抓到）。用 `-` 則空值會落進下面的格式
  # 檢查並被拒，未設才走預設。
  local depth="${AGENT_BRIDGE_RELAY_DEPTH-0}"
  [[ "$depth" =~ ^[0-9]{1,9}$ ]] \
    || die "AGENT_BRIDGE_RELAY_DEPTH 需為非負整數（空值也不接受，避免靜默重置鏈深度）：$depth"
  depth=$((10#$depth))
  local max_depth="${AGENT_BRIDGE_MAX_RELAY_DEPTH-10}"
  [[ "$max_depth" =~ ^[0-9]{1,9}$ ]] \
    || die "AGENT_BRIDGE_MAX_RELAY_DEPTH 需為非負整數（空值也不接受）：$max_depth"
  max_depth=$((10#$max_depth))
  if (( max_depth > 0 )) && (( depth >= max_depth )); then
    die "已達接力上限（AGENT_BRIDGE_MAX_RELAY_DEPTH=$max_depth，本 session 是第 $depth 棒）：這條鏈需要人介入確認後才該繼續。確認後可調高上限，或設 0 解除限制。"
  fi

  RELAY_HANDOFF="$handoff"
  RELAY_PREV="$prev"
  RELAY_DEPTH_NEXT=$((depth + 1))

  # 直接呼叫而非命令替換：cmd_spawn 的 die 必須終止整個 relay，包進 $( ) 會被
  # subshell 吃掉、外層照常往下跑
  local args=("$name" --runtime "$runtime")
  [[ -n "$model" ]] && args+=(--model "$model")
  (( use_window == 1 )) && args+=(--window)
  cmd_spawn "${args[@]}"

  # pane id 借自 cmd_spawn 的回滾變數（成功後仍保留），避免為了取值而開 subshell
  local pane="$SPAWN_RB_PANE"
  # 切焦點：orchestrator 驅動時沒有人在看畫面，--no-select 是那條路徑的常態。
  # 失敗不致命——relay 主體（pane＋registry＋審計）此時已經成功落地
  if (( no_select == 0 )); then
    tmux select-window -t "$pane" 2>/dev/null || true
    tmux select-pane -t "$pane" 2>/dev/null || true
  fi
  if [[ -n "$prev" ]]; then
    info "已交棒給 '$name'；'$prev' 將由對方在接手後回收" || true
  else
    info "已交棒給 '$name'（前一棒未指定自動回收，請自行收尾）" || true
  fi
}

cmd_despawn() {
  (( $# == 1 )) || die "用法：agent-bridge despawn <name>"
  local name="$1"
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  local f="$AGENTS_DIR/$name.json"
  # 出身檢查必須在鎖內：檢查與 kill-pane 之間若 registry 被同名 register 換掉，
  # 鎖外檢查會拿舊紀錄放行、卻殺到新的人工 pane（TOCTOU）
  acquire_lock agents-registry
  [[ -f "$f" ]] || die "未註冊的 agent：$name"
  local sp_rc=0
  is_spawned "$f" || sp_rc=$?
  case $sp_rc in
    1) die "agent '$name' 非 spawn 出身，despawn 拒絕（人工註冊請用 unregister）" ;;
    2) die "agent '$name' 的 registry 無法解析，出身不明，despawn 拒絕；請確認 $f 後手動處理" ;;
  esac

  local pane runtime tag
  pane="$(jq -r '.pane_id' "$f")"
  runtime="$(jq -r '.runtime // "-"' "$f")"
  tag="$(jq -r '.spawn_tag // ""' "$f")"

  # generation 綁定（evict 專用；比對必須在這把鎖內，鎖外驗完到 kill 之間仍可
  # 能被換掉）。evict 是三段式的：send → await → despawn。await 與 despawn 之間
  # 同名 agent 可能已經換了一代（另一次 evict、或 despawn＋重 spawn）。只憑名字
  # 就殺，會殺掉一個沒收過收尾任務、也沒宣告 disposable 的新 worker——那正是這
  # 一層唯一不可接受的失效（順帶讓審計說謊：despawned 記新 pane、evicted 記舊）。
  # 拒絕後 pane 留著，失效方向是多佔一個 cap。（獨立複核 2026-07-22 指出）
  if [[ -n "$DESPAWN_EXPECT_TAG" && "$tag" != "$DESPAWN_EXPECT_TAG" ]]; then
    die "agent '$name' 已不是 evict 當初鎖定的那一個（spawn tag 不符，期間被換過一代）；拒絕回收以免殺掉未收尾的 worker"
  fi
  # pane_id 會被展開進 tmux 命令字串（if-shell 的 kill-pane），而 `;` 在
  # tmux 命令中是分隔符——不驗格式的話 registry 就是一條命令注入通道
  [[ "$pane" =~ $PANE_RE ]] \
    || die "registry 的 pane_id 格式不合法（疑似遭竄改），拒絕操作：$pane"

  command -v tmux >/dev/null 2>&1 || die "找不到 tmux，despawn 無法確認 pane 是否回收"

  # 審計先驗可寫再動手：kill pane 與刪 registry 都不可逆，事後 agents.log
  # append 失敗的話，set -e 讓整支非零收場——pane 已死、registry 已刪、審計
  # 沒落地，呼叫端卻以為 despawn 失敗而去重試（獨立複核 2026-07-24 指出）。
  # 以 append 模式實開一次 fd 驗證（不寫入位元組）；失敗時 pane 未動，安全方向
  : >> "$DATA_DIR/agents.log" 2>/dev/null \
    || die "agents.log 不可寫（審計無法落地），despawn 拒絕動手：$DATA_DIR/agents.log"

  # 查詢失敗（tmux server 不可達、sandbox 擋 socket）與「pane 不存在」是兩件事：
  # 前者無從判斷，不能當成 pane 已死而逕自清 registry——那會留下沒人回收的孤兒
  local panes
  panes="$(tmux list-panes -a -F '#{pane_id} #{pane_start_command}' 2>&1)" \
    || die "無法查詢 tmux pane（registry 保留不動，請排除後重試）：$panes"

  local live_cmd=""  found=0
  local pid cmd
  while read -r pid cmd; do
    if [[ "$pid" == "$pane" ]]; then
      found=1
      live_cmd="${cmd#\"}"
      break
    fi
  done <<< "$panes"

  if (( found == 1 )); then
    # pane id 對得上還不夠：id 會被重用，registry 也可能被寫入資料目錄的 worker
    # 竄改。啟動指令帶不帶我們當初埋的 tag，才是這個 pane 的出身證據。
    # tag 本身也要驗格式：否則 registry 裡填個 spawn_tag="bash" 就成了萬用鑰匙，
    # 任何跑 bash 的人工 pane 都會被前綴比對命中。格式含本 agent 的名字，
    # 抄別人的 tag 也對不上
    local tag_re="^AGENT_BRIDGE_SPAWN_TAG=ab-spawn-${name}-[0-9]+-[0-9a-f]{12}\$"
    if [[ ! "$tag" =~ $tag_re || "$live_cmd" != "$tag "* ]]; then
      rm -f -- "$f" \
        || die "pane $pane 已非本 agent 所有，且 registry 刪除失敗，請手動清除 $f"
      # 預檢之後 append 仍可能失敗（ENOSPC 等）：不可逆動作已完成，這時只能
      # 誠實揭露，不能讓 set -e 以非零收場誤導呼叫端重試
      log_agent_event despawn-stale "$name" "$pane" "$runtime" \
        || err "警告：registry 已清除，但審計未落地（agents.log append 失敗）"
      DESPAWN_RESULT=stale
      release_lock
      err "警告：pane $pane 目前的啟動指令不帶 '$name' 的 spawn tag（id 已被別的 pane 佔用，或 registry 遭竄改）；已清除註冊，未動該 pane"
      return 0
    fi
    # 驗證與 kill 分成兩次 tmux 呼叫，中間 server 若死掉重啟、新 server 把同一個
    # %N 發給人工 pane，第二次呼叫就會殺錯人。if-shell 讓「再驗一次 tag」與
    # kill 在同一次 client 連線內完成：換了 server 就判 false，不動手。
    # tmux 會把含空白的啟動指令加上雙引號存（實測 3.7b），故 pattern 帶前導引號；
    # 萬一未來版本改了存法，這裡會判 false → 不殺 → 被下面的存活檢查擋成
    # 「保留 registry 並報錯」，失效方向是漏殺而非誤殺
    tmux if-shell -t "$pane" -F "#{m:\"$tag *,#{pane_start_command}}" \
      "kill-pane -t $pane" 2>/dev/null || true
    local after
    after="$(tmux list-panes -a -F '#{pane_id}' 2>&1)" \
      || die "kill 後無法確認 pane $pane 狀態（registry 保留不動，請排除後重試）：$after"
    if grep -Fx "$pane" <<< "$after" >/dev/null; then
      die "無法關閉 pane $pane（kill 失敗，或 tmux server 在驗證後被替換）；registry 保留不動，請排除後重試"
    fi
  fi

  # 審計要看得出「這次回收有沒有丟掉東西」。despawn 是公開指令，任何人都能繞過
  # evict 直接收掉一個沒宣告 disposable、也就是仍被視為有殘值的 worker——機制上
  # 不擋（擋了會逼出 --force，而習慣性加旗標等於防線不存在），但不能讓審計線看
  # 起來跟一次乾淨的回收一模一樣。evict 走過收尾流程，筆記已經處理過，由它設
  # DESPAWN_NOTES_HANDLED 說明，不必記 unsaved。（獨立複核 2026-07-23 指出）
  local ev=despawned
  if [[ -z "$DESPAWN_NOTES_HANDLED" ]] && ! disposable_effective "$name" "$f"; then
    ev=despawned-unsaved
  fi
  rm -f -- "$f"
  # 同 stale 分支：預檢後 append 仍可能失敗，此時 pane 已回收、registry 已刪，
  # 只能誠實揭露；以非零收場會讓呼叫端（含 evict）誤判 despawn 失敗
  log_agent_event "$ev" "$name" "$pane" "$runtime" \
    || err "警告：pane 已回收、registry 已刪，但審計未落地（agents.log append 失敗）"
  if (( found == 1 )); then DESPAWN_RESULT=killed; else DESPAWN_RESULT=absent; fi
  release_lock
  if (( found == 1 )); then
    info "已 despawn agent '$name'（pane $pane）"
  else
    info "已 despawn agent '$name'（pane $pane 已不存在，僅清除註冊）"
  fi
}

cmd_ready() {
  (( $# == 1 )) || die "用法：agent-bridge ready <name>"
  local name="$1"
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  local f="$AGENTS_DIR/$name.json"
  # 同 despawn：出身檢查與寫入之間 registry 可能被換掉，故一律鎖內檢查
  acquire_lock agents-registry
  [[ -f "$f" ]] || die "未註冊的 agent：$name"
  local sp_rc=0
  is_spawned "$f" || sp_rc=$?
  case $sp_rc in
    1) die "agent '$name' 非 spawn 出身，ready 僅限 spawned agent" ;;
    2) die "agent '$name' 的 registry 無法解析，ready 拒絕；請確認 $f 後手動處理" ;;
  esac
  local updated
  updated="$(jq '.ready = true' "$f")"
  printf '%s\n' "$updated" | atomic_write "$f"
  release_lock
  info "agent '$name' 已回報就緒（ready）"
}

# disposable：worker 宣告「本輪脈絡已無殘值，做完可以直接收」。
#
# 語意刻意是單向宣告而非雙向旗標：**預設保留**。沒宣告過的 worker 一律當成
# 還有殘值，orchestrator 不該即時回收它。失效方向因此是安全的——worker 忘記
# 宣告＝留著，最壞是多佔一個 cap（可由 evict 騰出），而不是把還有用的脈絡殺掉。
#
# 這個欄位是給 orchestrator 看的**建議，不是保護**。registry 位在每個 worker
# 都可寫的資料目錄，worker 大可自己把它改掉賴著不走；但 despawn 認的是
# spawn_tag 而不是這個欄位，所以賴不掉。不要把它當成權限機制使用。
#
# 一併寫 disposable_at 時間戳，是為了讓宣告能「過期」：worker 宣告後若又被派
# 新任務，它就有了新脈絡，但標記還留著——此時 idle 比對「最後一個任務的時間
# 晚於宣告時間」即可判定宣告失效。這樣不必在 send/receive 裡加清除邏輯，
# 那兩條是核心路徑，能不動就不動。
cmd_disposable() {
  (( $# == 1 )) || die "用法：agent-bridge disposable <name>"
  local name="$1"
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  local f="$AGENTS_DIR/$name.json"
  # 同 ready：出身檢查與寫入之間 registry 可能被換掉，故一律鎖內檢查
  acquire_lock agents-registry
  [[ -f "$f" ]] || die "未註冊的 agent：$name"
  local sp_rc=0
  is_spawned "$f" || sp_rc=$?
  case $sp_rc in
    1) die "agent '$name' 非 spawn 出身，disposable 僅限 spawned agent（人工 pane 的生命週期不歸 bridge 管）" ;;
    2) die "agent '$name' 的 registry 無法解析，disposable 拒絕；請確認 $f 後手動處理" ;;
  esac
  # pane/runtime 在鎖內取：出鎖後 registry 可能已被換掉，審計就記到別人頭上了
  local pane runtime ts updated
  pane="$(jq -r '.pane_id // "-"' "$f")"
  runtime="$(jq -r '.runtime // "-"' "$f")"
  ts="$(now_iso)"
  updated="$(jq --arg ts "$ts" '.disposable = true | .disposable_at = $ts' "$f")"
  printf '%s\n' "$updated" | atomic_write "$f"
  release_lock
  # 宣告已落進 registry，審計 append 失敗只揭露不翻盤：以非零收場會讓 worker
  # 誤以為宣告沒成立而重試或困惑，實際上 idle 已看得到 yes
  log_agent_event disposable "$name" "$pane" "$runtime" \
    || err "警告：disposable 已寫入 registry，但審計未落地（agents.log append 失敗）"
  info "agent '$name' 已宣告可回收（disposable）"
}

# idle：worker 池的回收決策視圖。**唯讀**——不取鎖、不寫任何檔案，理由同
# cmd_await：orchestrator 可能跑在只讀 sandbox 裡，一個查詢命令不該需要寫權限。
#
# 輸出四欄 TSV：name / ready / disposable / idle_secs
#
# disposable 欄的三種值就是回收決策本身：
#   yes      有效宣告 → 可即時回收
#   expired  宣告過，但之後又被派了新任務——worker 已累積新脈絡，宣告失效
#   -        沒宣告過（預設保留），或人工註冊（生命週期不歸 bridge 管）
#
# 「宣告會過期」刻意在**讀取端**判斷，而不是在 send/receive 裡清掉欄位：
# 那兩條是核心路徑，能不動就不動。讀取端判斷的代價只是這裡多一次比對。
#
# idle_secs 取「最後一個派給它的任務建立時間」與現在的差；從未被派工過就用
# registry 的登記時間。無法解析時間時印 `-` 而不是 0——0 會被誤讀成「剛剛才
# 用過」，正好是驅逐決策最不該搞錯的方向。
# gc：清掉夠舊的終態 task 目錄。tasks/ 原本只增不減，這不只是磁碟問題——
# idle 的回收決策直接吃 tasks/ 的內容（last_task_at 掃全目錄），資料越髒決策越
# 不可信，而且那是 O(task 數) 的掃描。名稱重用那個 bug 的根因就是這裡。
#
# 三道保留線，失效方向一律是「留著」而不是「刪掉」：
#   1. 非終態（queued/delivered/running）一律不動——那是還在進行的任務
#   2. pinned（evict 的收尾筆記）一律不動，除非明確 --include-notes
#   3. 預設 dry-run，要 --apply 才真的刪
# 刪除不可逆，而這個工具的整層語意都建立在「寧可多佔空間也不要弄丟脈絡」上。
cmd_gc() {
  local days=14 apply=0 include_notes=0
  while (( $# > 0 )); do
    case "$1" in
      --older-than)
        shift; (( $# > 0 )) || die "--older-than 需要參數"
        [[ "$1" =~ ^[0-9]{1,5}$ ]] || die "--older-than 需為 0-99999 的整數天：$1"
        days="$((10#$1))" ;;
      --apply) apply=1 ;;
      --include-notes) include_notes=1 ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done

  local now cutoff kept_live=0 kept_pin=0 kept_young=0 kept_proof=0 removed=0 failed=0
  now="$(date -u +%s)"
  cutoff=$(( now - days * 86400 ))

  # 「宣告已失效」的證據不能刪。idle 判斷一個 disposable 宣告是否被後續任務推翻，
  # 靠的是掃 tasks/ 找晚於 disposable_at 的任務；那個任務一旦被 gc 清掉，證據就
  # 消失，宣告會從 expired 復活成 yes，orchestrator 據此直接回收一個其實已有新
  # 脈絡的 worker。收集現存 registry 裡還掛著宣告的 agent 與其時間戳，晚於它的
  # 任務一律保留。（獨立複核 2026-07-23 以隔離實測抓出：GC 前 expired、GC 後 yes）
  declare -A pledge=()
  local af aname adisp
  shopt -s nullglob
  for af in "$AGENTS_DIR"/*.json; do
    jq -e 'type == "object" and .disposable == true' "$af" >/dev/null 2>&1 || continue
    aname="$(jq -r '.name // ""' "$af" 2>/dev/null)" || continue
    adisp="$(jq -r '.disposable_at // ""' "$af" 2>/dev/null)" || continue
    [[ -n "$aname" && -n "$adisp" ]] || continue
    pledge["$aname"]="$adisp"
  done

  local d id st pinned ts epoch
  shopt -s nullglob
  for d in "$TASKS_DIR"/*/; do
    id="$(basename "$d")"
    # 只碰 send 生出來的形狀（UTC 時間戳 ＋ 4 hex），不是寬鬆的 TASK_ID_RE。
    # 這裡是唯一會刪東西的地方：公開驗證用的 TASK_ID_RE 連 `foo` 都算合法，
    # 拿它當刪除門檻，等於把任何人放進 tasks/ 的目錄都納入清理範圍。
    # 寧可漏掉幾個手工目錄，也不要讓一個不是我們生成的名字走進 rm 的參數。
    # （獨立複核 2026-07-23 指出契約定義不一致）
    [[ "$id" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$ ]] || continue
    [[ -f "$d/metadata.json" && -f "$d/status" ]] || continue

    st="$(<"$d/status")"
    case "$st" in
      completed|failed|cancelled) ;;
      *) kept_live=$((kept_live + 1)); continue ;;
    esac

    if (( include_notes == 0 )); then
      pinned="$(jq -r '.pinned // false' "$d/metadata.json" 2>/dev/null)" || pinned=true
      if [[ "$pinned" == true ]]; then
        kept_pin=$((kept_pin + 1)); continue
      fi
    fi

    # 用 metadata 的 created_at 而不是目錄 mtime：mtime 會被備份、rsync、
    # 檔案系統操作改掉，created_at 是這個任務自己的事實
    # 這個任務是不是某個現存宣告的「已失效證據」？是的話留著（見上方 pledge）
    local to_who
    to_who="$(jq -r '.to // ""' "$d/metadata.json" 2>/dev/null)" || to_who=""
    if [[ -n "$to_who" && -n "${pledge[$to_who]:-}" ]]; then
      local tts
      tts="$(jq -r '.created_at // ""' "$d/metadata.json" 2>/dev/null)" || tts=""
      if [[ -n "$tts" ]] && ! [[ "$tts" < "${pledge[$to_who]}" ]]; then
        kept_proof=$((kept_proof + 1)); continue
      fi
    fi

    ts="$(jq -r '.created_at // ""' "$d/metadata.json" 2>/dev/null)" || ts=""
    # 讀不到時間就當它還年輕：判不出年紀的東西不刪
    if [[ -z "$ts" ]] || ! epoch="$(date -u -d "$ts" +%s 2>/dev/null)"; then
      kept_young=$((kept_young + 1)); continue
    fi
    if (( epoch >= cutoff )); then
      kept_young=$((kept_young + 1)); continue
    fi

    if (( apply == 0 )); then
      printf '%s\t%s\t%s\n' "$id" "$st" "$ts"
      removed=$((removed + 1))
      continue
    fi

    # 取這個 task 的鎖再刪：狀態轉換都在同一把鎖下，不取就可能在 reply 寫到一半
    # 時把目錄抽走。整段包 subshell 有兩個理由：acquire_lock 取不到鎖是 die，
    # 直接呼叫會讓 gc 整支退出、剩下的目錄全不處理；而 subshell 內的 EXIT trap
    # 會自動釋放它自己那把鎖，不碰外層的 LOCK_DIR（單值，見 acquire_lock）
    local rc2=0
    (
      acquire_lock "$id" 2>/dev/null
      # 拿到鎖後重驗狀態：等鎖那段時間裡它可能已經被 receive／reply 動過
      case "$(<"$d/status")" in
        completed|failed|cancelled) rm -rf -- "$d" ;;
        *) exit 2 ;;
      esac
    ) || rc2=$?
    case $rc2 in
      0) removed=$((removed + 1)) ;;
      2) kept_live=$((kept_live + 1)) ;;
      *) failed=$((failed + 1)) ;;
    esac
  done

  if (( apply == 0 )); then
    info "gc（試算）：可刪 $removed 個；保留 未完成 $kept_live／收尾筆記 $kept_pin／宣告失效證據 $kept_proof／未滿 ${days} 天 $kept_young"
    info "確認無誤後加 --apply 才會真的刪除"
  else
    info "gc：已刪 $removed 個；保留 未完成 $kept_live／收尾筆記 $kept_pin／宣告失效證據 $kept_proof／未滿 ${days} 天 $kept_young"
    (( failed == 0 )) || err "警告：$failed 個目錄未能刪除（鎖被佔用或權限問題），下次再試"
  fi
}

cmd_idle() {
  (( $# == 0 )) || die "用法：agent-bridge idle（不接參數）"
  local now f base_name name spawned ready disp disp_at last_at ref base secs base_epoch
  now="$(date -u +%s)"
  shopt -s nullglob
  for f in "$AGENTS_DIR"/*.json; do
    base_name="$(basename "$f" .json)"
    # 損壞的 registry 不讓整份報表掛掉，但也不能靜靜跳過：它照樣佔著 cap，
    # orchestrator 必須看得到「這裡有個判不出狀態的東西」
    if ! jq -e 'type == "object"' "$f" >/dev/null 2>&1; then
      printf '%s\t%s\t%s\t%s\n' "$base_name" '?' '?' '-'
      continue
    fi
    name="$(jq -r '.name // ""' "$f")"
    [[ -n "$name" ]] || name="$base_name"
    spawned="$(jq -r 'if .spawned == true then "y" else "n" end' "$f")"
    ready="$(jq -r 'if .spawned == true
                    then (if .ready == true then "ready" else "starting" end)
                    else "-" end' "$f")"
    disp_at="$(jq -r 'if .disposable == true then (.disposable_at // "?") else "" end' "$f")"
    ref="$(jq -r '.spawned_at // .registered_at // ""' "$f")"
    last_at="$(last_task_at "$name")"

    # 人工註冊的 pane 不歸 bridge 管生命週期，一律 `-`：即使有人手動塞了
    # disposable 欄位，也不該讓它看起來可回收
    if [[ "$spawned" != y || -z "$disp_at" ]]; then
      disp="-"
    elif disposable_effective "$name" "$f"; then
      disp="yes"
    else
      disp="expired"
    fi

    # 取「最後任務」與「這個 pane 誕生」兩者較晚者。agent 名稱可以重用，而
    # last_task_at 只認名字不認 pane 實例：tasks/ 裡若留著同名前一個 worker 的
    # 任務，剛 spawn 的 worker 會繼承那個時間，在 idle 報表上看起來閒置了好幾
    # 小時，於是 LRU 優先驅逐一個其實還沒做過事的新 pane。閒置時間不該早於
    # 誕生時間。（真鏈驗收 2026-07-22 實地踩到）
    base="$last_at"
    if [[ -z "$base" || ( -n "$ref" && "$ref" > "$base" ) ]]; then
      base="$ref"
    fi
    secs="-"
    if [[ -n "$base" ]] && base_epoch="$(date -u -d "$base" +%s 2>/dev/null)"; then
      secs=$(( now - base_epoch ))
      (( secs < 0 )) && secs=0
    fi
    printf '%s\t%s\t%s\t%s\n' "$name" "$ready" "$disp" "$secs"
  done
}

# evict：撞 cap 時的驅逐，但**不是直接殺**——先派一輪收尾任務，讓 worker 把
# 只存在於它 context 裡、response 之外的關鍵事實寫下來，落地之後才 despawn。
# 上下文不會憑空消失，這是「預設保留」語意在 cap 壓力下的補償機制。
#
# 三步（send → await → despawn）刻意**不包在一把鎖裡**：LOCK_DIR 是單值
# （見 acquire_lock），同時持有兩把鎖時 release_lock 只會放掉一把，留下一把
# 沒人知道存在的鎖擋住之後每一次同類操作。分段的代價是每段之間都可能被中斷，
# 失效方向分別是：
#   send 後中斷  → 多一個沒人收的收尾 task（status 看得見），pane 仍在
#   await 後中斷 → 筆記已落地、pane 沒收掉，最壞多佔一個 cap（可再 evict）
# 兩個方向都不會刪掉還沒落地的脈絡——這是分段時唯一不可接受的失效。
#
# **逾時仍然 despawn**：否則一個不回話的 worker 會把 cap 永久卡死，驅逐機制
# 直接失效。代價是筆記沒落地，所以審計線一定要看得出來（evicted-timeout），
# 而不是混在正常的 evicted 裡。
cmd_evict() {
  (( $# >= 1 )) || die "用法：agent-bridge evict <name> [--timeout <secs>] [--from <sender>]"
  local name="$1"; shift
  local timeout=300 from="orchestrator"
  while (( $# > 0 )); do
    case "$1" in
      --timeout)
        shift; (( $# > 0 )) || die "--timeout 需要參數"
        # 同 await：10# 強制十進位，位數上限擋 64 位算術溢位
        [[ "$1" =~ ^[0-9]{1,9}$ ]] || die "--timeout 需為非負整數（秒，至多 9 位），0＝不逾時：$1"
        timeout=$((10#$1)) ;;
      --from)
        shift; (( $# > 0 )) || die "--from 需要參數"
        from="$1" ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  [[ "$from" =~ $NAME_RE ]] || die "sender 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$from"

  # 出身快檢（不取鎖）：純 fail-fast，避免對人工註冊的 agent 送出一個之後
  # 必定被 despawn 拒絕、沒人回收的孤兒收尾任務。權威判定仍在 cmd_despawn 的
  # 鎖內（TOCTOU 歸它負責）——這裡放行不代表最後一定收得掉
  local f="$AGENTS_DIR/$name.json"
  [[ -f "$f" ]] || die "未註冊的 agent：$name"
  local sp_rc=0
  is_spawned "$f" || sp_rc=$?
  case $sp_rc in
    1) die "agent '$name' 非 spawn 出身，evict 拒絕（人工 pane 的生命週期不歸 bridge 管，請用 unregister）" ;;
    2) die "agent '$name' 的 registry 無法解析，出身不明，evict 拒絕；請確認 $f 後手動處理" ;;
  esac

  # pane/runtime 在 despawn 前取：despawn 會刪掉 registry，之後就讀不到了
  local pane runtime
  pane="$(jq -r '.pane_id // "-"' "$f")"
  runtime="$(jq -r '.runtime // "-"' "$f")"
  # 記下這一代的 spawn_tag，最後 despawn 時綁定比對（見 cmd_despawn 的
  # DESPAWN_EXPECT_TAG 段）：收尾任務是派給「這一代」的，回收也只能收這一代
  # tag 空的話 despawn 那邊的 generation 比對會整條被跳過（見 DESPAWN_EXPECT_TAG），
  # 綁定等於沒有。正常 spawn 一定寫得出 tag，取不到代表 registry 被動過——這時
  # 拒絕動作，而不是帶著一個失效的綁定往下走。（獨立複核 2026-07-23 指出）
  local gen_tag
  gen_tag="$(jq -r '.spawn_tag // ""' "$f")"
  [[ -n "$gen_tag" ]] \
    || die "agent '$name' 的 registry 沒有 spawn_tag，無法鎖定世代，evict 拒絕；請確認 $f 後手動處理"

  # 收尾任務的文案硬編在這裡而不是抽到 share/：它是機制的一部分（「把只存在於
  # 你 context 裡的事實寫下來」），不是可調策略。抽成檔案會多一條「檔案不存在
  # 怎麼辦」的失敗路徑，而那條路徑一旦失敗，等於整個筆記機制悄悄消失
  local msg
  msg="$(cat <<'EOF'
[Wrap-up task — your final round before this pane is reclaimed]

This pane is about to be reclaimed and your context vanishes with it.
Use reply to hand back a note with the key facts that exist only in your
context and never made it into earlier responses.

Write:
- facts you found but never put into a reply (file:line, commands, measured numbers)
- dead ends you walked and why they failed (so the next runner skips them)
- open questions, the assumptions you held, and which conclusions were
  actually conjecture rather than verified

Do not write:
- restatements of what is already in your responses
- new work: this round is consolidation only — start no new investigation

When done, run agent-bridge reply <task-id> --message-file <path> (or --message).
Even with nothing worth keeping, reply anyway with the single line
"no residual value" — a missing reply is recorded as notes-never-landed.
EOF
)"

  # 收尾任務 pin 住：它裝的是「只存在 worker context 裡」的事實，被 gc 清掉的話
  # 這一層對「上下文不會憑空消失」的承諾就只是延後兌現
  local task_id
  SEND_PIN=1
  task_id="$(cmd_send "$name" --from "$from" --message "$msg")" \
    || { SEND_PIN=""; die "evict 中止：收尾任務送不出去，未動 pane（agent '$name' 仍在）"; }
  SEND_PIN=""
  info "evict：收尾任務 $task_id 已派給 '$name'，等待筆記落地（timeout ${timeout}s）"

  # cmd_await 逾時是 exit 124。直接呼叫會讓 evict 整支跟著退出、跳過 despawn，
  # cap 就被一個不回話的 worker 永久卡死。包 subshell 讓退出只殺得掉那一層
  local final_st="" await_rc=0
  final_st="$( cmd_await "$task_id" --timeout "$timeout" )" || await_rc=$?

  # 只有真正的逾時（124）才走「筆記沒落地仍回收」；其他非零是 await 自己的
  # 操作性失敗（壞輪詢間隔、status 檔消失等），worker 可能還活著、根本沒等
  # 到期限——這時 despawn 等於把活的 context 當逾時殺掉，審計還記成 timeout
  # （獨立複核 2026-07-24 指出，實測壞 interval 10ms 即觸發）。中止並保留
  # pane，失效方向退回已文件化的「send 後中斷」：多一個看得見的收尾任務
  if (( await_rc != 0 && await_rc != 124 )); then
    die "evict 中止：await 操作性失敗（rc=$await_rc，非逾時），pane 未動（agent '$name' 仍在）；收尾任務 $task_id 留存可查"
  fi

  local outcome
  case "$final_st" in
    completed) outcome=evicted ;;
    # failed/cancelled 也是 await 的正常返回，不是逾時。全記成 evicted-timeout
    # 會讓審計線說謊——「筆記沒落地」的原因不同，追查方向也不同
    failed|cancelled) outcome=evicted-unfinished ;;
    *) outcome=evicted-timeout ;;
  esac

  DESPAWN_EXPECT_TAG="$gen_tag"
  DESPAWN_NOTES_HANDLED=1
  DESPAWN_RESULT=""
  cmd_despawn "$name"
  DESPAWN_EXPECT_TAG=""
  DESPAWN_NOTES_HANDLED=""

  # stale＝registry 清掉了，但那個 pane 還活著、已經不屬於這個 agent。它沒有被
  # 回收，所以不能記 evicted*——despawn 自己已經記過 despawn-stale，再補一筆
  # evicted 只會讓審計線宣稱發生過一次沒發生的回收。（獨立複核 2026-07-23 指出）
  if [[ "$DESPAWN_RESULT" == stale ]]; then
    err "警告：agent '$name' 的註冊已清除，但 pane $pane 已不屬於它、未被回收；收尾任務 $task_id（$final_st）請自行判讀"
    printf '%s\n' "$task_id"
    return 0
  fi
  # 記在 despawn 成功之後：despawn 失敗代表 pane 還在、根本沒被驅逐，
  # 這時寫一筆 evicted 進審計線就是假紀錄。append 失敗只揭露不改 rc——
  # 驅逐本身已完成（despawn 有自己的預檢與揭露）
  log_agent_event "$outcome" "$name" "$pane" "$runtime" \
    || err "警告：evict 已完成，但審計未落地（agents.log append 失敗）"
  case "$outcome" in
    evicted)
      info "已 evict agent '$name'；收尾筆記可用：agent-bridge read $task_id" ;;
    evicted-unfinished)
      err "警告：收尾任務 $task_id 以 $final_st 結束，筆記未落地；agent '$name' 仍已回收" ;;
    *)
      err "警告：收尾任務 $task_id 逾時（${timeout}s）未回覆，筆記未落地；agent '$name' 仍已回收（避免 cap 卡死）" ;;
  esac
  printf '%s\n' "$task_id"
}

# hook_agent_name：從 AGENT_BRIDGE_SPAWN_TAG 環境變數析出「我是誰」。
# tag 格式見 cmd_spawn 的生成處：ab-spawn-<name>-<pid>-<12hex 隨機>。name 本身
# 允許連字號與底線（NAME_RE），故不能用第一個 `-` 切；用錨定尾綴（-數字-12 hex）
# 的正則反推、貪婪比對讓中間帶連字號的名字也能正確還原。
# 無此變數、格式不符、或還原出的名字未過 NAME_RE 一律 return 1（呼叫端視為
# 「不是 spawn 出身的 hook 呼叫」，靜默 no-op）——主 session／人工註冊 pane
# 的環境本來就沒有這個變數，天然不受影響。
hook_agent_name() {
  local tag="${AGENT_BRIDGE_SPAWN_TAG:-}" rest name
  [[ -n "$tag" ]] || return 1
  rest="${tag#ab-spawn-}"
  [[ "$rest" != "$tag" ]] || return 1
  if [[ "$rest" =~ ^(.+)-[0-9]+-[0-9a-f]{12}$ ]]; then
    name="${BASH_REMATCH[1]}"
  else
    return 1
  fi
  [[ "$name" =~ $NAME_RE ]] || return 1
  printf '%s' "$name"
}

# hook_write_state <state-file> <state> <last_delivered|__KEEP__>：state 通道的
# 單一寫者操作（呼叫者是 worker 自己的 hook，不取 registry 鎖，見 STATE_DIR
# 註記）。__KEEP__ 表示保留既有 last_delivered 不動——prompt-submit 與
# notification 的 idle 標記都不該動它：last_delivered 是 Stop hook 用來辨識
# 「同一個仍待處理的任務是否已經被擋過一輪」的依據，若被其他事件中途沖掉，
# 防無限迴圈的判斷就會失準（見 cmd_hook 的 stop 分支）。
# 任何一步失敗（jq 壞、atomic_write 失敗）一律吞掉：hook 的失效方向是
# state 停在舊值、TTL 到期後退回 legacy 送鍵，不是讓呼叫端跟著非零收場。
hook_write_state() {
  local file="$1" state="$2" ld="$3" ts
  ts="$(now_iso)"
  if [[ "$ld" == "__KEEP__" ]]; then
    ld=""
    if [[ -f "$file" ]]; then
      ld="$(jq -r '.last_delivered // empty' "$file" 2>/dev/null)" || ld=""
    fi
  fi
  jq -n --arg s "$state" --arg t "$ts" --arg ld "$ld" \
    '{state: $s, ts: $t, last_delivered: $ld}' 2>/dev/null \
    | atomic_write "$file" 2>/dev/null || true
}

# hook_oldest_queued <to>：查最舊一筆 to=<to> 且狀態為 queued 的 task-id，
# 查無回空字串。task-id 以 UTC 時間戳起首（見 cmd_send），字典序即時間序，
# 不必轉 epoch 排序。狀態一律讀裸 status 檔而非 metadata 的 status 欄——
# status 檔是狀態機的權威（見 update_meta_status 的註記），兩者短暫不一致時
# 這裡不能算錯。
hook_oldest_queued() {
  local to="$1" f dir id t st oldest=""
  for f in "$TASKS_DIR"/*/metadata.json; do
    [[ -e "$f" ]] || continue
    dir="$(dirname "$f")"
    id="$(basename "$dir")"
    # tasks/ 是同互信域內每個 worker 都可寫的目錄，目錄名（basename）未經
    # check_task_id 這道關卡就直接餵給下面 block reason 裡的
    # "agent-bridge receive <id>"，會進到另一個 worker 模型看到的指令語意
    # 空間。惡意或壞掉的目錄名（例如夾帶 shell metacharacter）在此就地跳過、
    # 不得進入候選——與 check_task_id 同級把關，只是把關點挪到「取得 id 後
    # 立刻擋」，不是 die：hook 鐵律是任何異常都不得中止，跳過這筆繼續掃下一筆
    [[ "$id" =~ $TASK_ID_RE ]] || continue
    t="$(jq -r '.to // empty' "$f" 2>/dev/null)" || continue
    [[ "$t" == "$to" ]] || continue
    st="$(cat "$dir/status" 2>/dev/null)" || continue
    [[ "$st" == "queued" ]] || continue
    if [[ -z "$oldest" || "$id" < "$oldest" ]]; then
      oldest="$id"
    fi
  done
  printf '%s' "$oldest"
}

# cmd_hook <stop|prompt-submit|notification>：Claude Code hook 協定的落地端
# （stdin 收一份事件 JSON）。
#
# 失效方向鐵律：這支函式任何一步出錯（stdin 非 JSON、jq 失敗、state 寫入失敗、
# 環境變數缺失或格式不符）一律以 exit 0 收場，絕不 exit 2、絕不非零——exit 2
# 會被 Claude Code 當成「block」訊號，hook 故障不得干擾 worker 的正常運作。
# 因此函式內每一步失敗路徑都走 if/||/case 顯式收斂，不讓 set -e 在函式中途把
# 整支腳本帶出非零退出碼——那樣就繞過了每個分支末尾的 `exit 0`。
# 只有 stop 事件確實要 block 續跑時才印 stdout；其餘路徑一律無 stdout 輸出。
cmd_hook() {
  local event="${1:-}"
  case "$event" in
    stop|prompt-submit|notification) ;;
    *) exit 0 ;;  # 未知事件：靜默放行，避免 Claude Code 日後新增事件把 worker 卡住
  esac

  local name
  name="$(hook_agent_name)" || exit 0
  [[ -n "$name" ]] || exit 0

  command -v jq >/dev/null 2>&1 || exit 0
  mkdir -p "$STATE_DIR" 2>/dev/null || exit 0
  local state_file="$STATE_DIR/$name.json"

  # stdin 讀不到就當空字串；後續每個 jq 查詢都掛 || 保底，空字串／非 JSON
  # 一律落到查詢失敗的分支，不會讓腳本中止。
  # 讀取本身要設上限：裸 `cat` 沒有逾時，fd 0 已關閉或管線開著卻不送資料的
  # 兩種情形實測都會讓程序卡住不返回（Claude Code 的 Stop hook 呼叫端因此
  # 被無限期擋住，worker 的 turn 永遠結束不了）——這裡是「hook 故障不得干擾
  # worker」這條鐵律唯一沒有 TTL 能救的一段，只能靠讀取本身設上限。
  # 用 timeout 包，讀不到系統工具就退回原本裸 cat（不得因缺工具而讓 hook
  # die）；逾時或讀不到一律當空字串繼續，維持 exit 0 鐵律
  local stdin_json
  if command -v timeout >/dev/null 2>&1; then
    stdin_json="$(timeout 2 cat 2>/dev/null)" || stdin_json=""
  else
    stdin_json="$(cat 2>/dev/null)" || stdin_json=""
  fi

  case "$event" in
    prompt-submit)
      hook_write_state "$state_file" busy "__KEEP__"
      ;;
    notification)
      # 判別欄位查證（本次 2026-07-28 WebFetch＋WebSearch 交叉比對）：
      # - code.claude.com/docs/en/hooks：Notification 的 matcher 可選值含
      #   idle_prompt（等輸入）／permission_prompt 等，但該頁 stdin JSON 範例
      #   段落在擷取時被截斷，未直接給出對應的欄位名。
      # - @anthropic-ai/claude-agent-sdk 的 NotificationHookInput 型別以
      #   `notification_type` 承載這個值（實例見社群文章 alexop.dev/posts/
      #   claude-code-notification-hooks，其 hook 腳本讀 input.notification_type
      #   並 switch 比對 'idle_prompt'/'permission_prompt'，與官方 matcher 列舉
      #   一致）。
      # - 已知可靠性缺口：github.com/anthropics/claude-code issue #12048 回報
      #   實際 payload 有時完全缺這個欄位（關聯 bug #11964）。本實作對此
      #   fail-safe：缺欄位時 jq 回空字串、不等於 idle_prompt，落入「其他
      #   型別不動 state」分支——不是誤判成 idle，代價可接受（state 停舊值，
      #   TTL 到期後仍會退回 legacy 送鍵，不會永久卡住）。
      local ntype
      ntype="$(printf '%s' "$stdin_json" | jq -r '.notification_type // empty' 2>/dev/null)" || ntype=""
      if [[ "$ntype" == "idle_prompt" ]]; then
        hook_write_state "$state_file" idle "__KEEP__"
      fi
      ;;
    stop)
      # stop_hook_active 查證：code.claude.com/docs/en/hooks 官方文件與社群
      # 引用的 hook JSON schema（gist.github.com/FrancisBourre/
      # 50dca37124ecc43eaf08328cdcccdb34）一致列為 Stop 事件 stdin 的 boolean
      # 欄位，供呼叫端防無限迴圈；本實作依此判斷。
      local stop_active
      stop_active="$(printf '%s' "$stdin_json" | jq -r '.stop_hook_active // false' 2>/dev/null)" || stop_active="false"

      local pending
      pending="$(hook_oldest_queued "$name")" || pending=""

      if [[ -z "$pending" ]]; then
        hook_write_state "$state_file" idle "__KEEP__"
      else
        local last_delivered=""
        if [[ -f "$state_file" ]]; then
          last_delivered="$(jq -r '.last_delivered // empty' "$state_file" 2>/dev/null)" || last_delivered=""
        fi
        if [[ "$stop_active" == "true" && "$pending" == "$last_delivered" ]]; then
          # 同一個仍待處理的 task 已經被擋過一輪、模型還是選擇停下：這才是
          # 真迴圈的訊號（模型不理會 reason），一輪就放行，不再無限擋。
          # 多任務合法連鎖的情形下 pending 會是「下一個」不同 id，走 else
          # 分支繼續擋，worker 可以一路把 mailbox 清空
          hook_write_state "$state_file" idle "__KEEP__"
        else
          hook_write_state "$state_file" busy "$pending"
          jq -n --arg id "$pending" \
            '{decision: "block",
              reason: ("New task " + $id + " is in your agent-bridge mailbox. Run: agent-bridge receive " + $id + " and handle it per your worker brief.")}' \
            2>/dev/null || true
        fi
      fi
      ;;
  esac
  exit 0
}

main() {
  if (( $# == 0 )); then
    usage
    exit 1
  fi
  local cmd="$1"; shift
  case "$cmd" in
    -h|--help|help)
      usage
      return 0
      ;;
  esac
  # 查詢命令的「唯讀」宣稱要落到實作（獨立複核 2026-07-24 指出）：
  # status/await 純讀檔、全程不用 jq；idle/list 只讀不寫。這四個不建目錄——
  # 嚴格只讀 sandbox 下查詢不該因 mkdir 失敗而死，資料目錄不存在時也不該
  # 無中生有（目錄缺失時 glob 走 nullglob 得空集、task 查詢以「找不到」收場，
  # 都是正確的唯讀行為）
  # hook 自成一格：它必須「任何錯誤都 exit 0」（見 cmd_hook 開頭的鐵律註記），
  # 借用 require_jq／ensure_dirs 的 die 語意會違反這條鐵律（缺 jq 或 mkdir 失敗
  # 都會讓 die/errexit 把腳本帶出非零）。jq 存在性與 STATE_DIR 建立改由
  # cmd_hook 自己做、失敗一律吞掉
  case "$cmd" in
    status|await|hook) ;;
    *) require_jq ;;
  esac
  case "$cmd" in
    status|await|idle|list|hook) ;;
    *) ensure_dirs ;;
  esac
  case "$cmd" in
    register)   cmd_register "$@" ;;
    unregister) cmd_unregister "$@" ;;
    list)       cmd_list "$@" ;;
    send)       cmd_send "$@" ;;
    receive)    cmd_receive "$@" ;;
    start)      cmd_start "$@" ;;
    reply)      cmd_reply "$@" ;;
    fail)       cmd_fail "$@" ;;
    cancel)     cmd_cancel "$@" ;;
    status)     cmd_status "$@" ;;
    read)       cmd_read "$@" ;;
    await)      cmd_await "$@" ;;
    hook)       cmd_hook "$@" ;;
    spawn)      cmd_spawn "$@" ;;
    relay)      cmd_relay "$@" ;;
    despawn)    cmd_despawn "$@" ;;
    ready)      cmd_ready "$@" ;;
    disposable) cmd_disposable "$@" ;;
    idle)       cmd_idle "$@" ;;
    evict)      cmd_evict "$@" ;;
    gc)         cmd_gc "$@" ;;
    *)
      usage
      die "未知指令：$cmd"
      ;;
  esac
}

main "$@"
