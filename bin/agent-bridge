#!/usr/bin/env bash
# agent-bridge — 跨 tmux pane 的 agent 任務委派橋（core MVP）
#
# 機制：檔案系統 mailbox（AGENT_BRIDGE_DATA）＋ tmux send-keys 短通知。
# 通知只送一行短指令（agent-bridge receive/read <task-id>），
# 絕不把訊息內容放進 send-keys。
set -euo pipefail

DATA_DIR="${AGENT_BRIDGE_DATA:-$HOME/.local/share/agent-bridge}"
AGENTS_DIR="$DATA_DIR/agents"
TASKS_DIR="$DATA_DIR/tasks"
LOCKS_DIR="$DATA_DIR/locks"

NAME_RE='^[A-Za-z0-9_-]+$'
TASK_ID_RE='^[A-Za-z0-9._-]+$'
# registry 的 pane_id 對本程式是不可信輸入（資料目錄對每個 worker 都可寫），
# 而它會被餵給 tmux。tmux 命令字串裡 `;` 是命令分隔符，
# 一個 pane_id 寫成 `%1 ; kill-server` 就能殺掉整個 server
PANE_RE='^%[0-9]+$'

# worker brief：spawn 出來的 runtime 是一個全新、零脈絡的 session——它不知道
# 自己是 worker，也不知道 pane 裡收到的 `agent-bridge receive <id>` 是要執行的
# 命令而非有人在跟它說話。實測（codex 0.145）會把就緒探針當成對話反覆回覆
# 文字、永遠不 ready。故啟動時把這份守則當 initial prompt 注入。
# 正本是一份檔而不是內嵌字串：人工註冊的 worker 讀同一份，兩邊不會漂移。
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
REPO_ROOT="$(dirname "$(dirname "$SCRIPT_PATH")")"
WORKER_BRIEF="${AGENT_BRIDGE_WORKER_BRIEF:-$REPO_ROOT/share/worker-brief.md}"
# 接手者守則：relay 注入的是這份而不是 worker 守則。兩者心智相反——worker 等
# 派工、接手者一開始就有交接檔要自己往下做，把 worker 守則注入接手者會讓它
# 空等 receive
SUCCESSOR_BRIEF="${AGENT_BRIDGE_SUCCESSOR_BRIEF:-$REPO_ROOT/share/successor-brief.md}"
# relay 模式旗標：非空＝cmd_spawn 走接手者路徑。用全域傳遞是為了讓 relay 共用
# cmd_spawn 而不必改它的簽章（set -u，故必須先初始化）
RELAY_HANDOFF=""
RELAY_PREV=""

err()  { printf 'agent-bridge: %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }
info() { printf '%s\n' "$*" >&2; }

usage() {
  cat >&2 <<'EOF'
用法：
  agent-bridge register <agent> <tmux-target>   註冊 agent 與其 tmux pane
  agent-bridge unregister <agent>               移除 agent 註冊
  agent-bridge list                             列出已註冊 agent（name<TAB>pane_id<TAB>ready）
  agent-bridge send <agent> --from <sender> (--message <text> | --message-file <path>)
                                                委派任務；stdout 只印 task-id
  agent-bridge receive <task-id>                取出任務（標頭走 stderr、request 原文走 stdout）
  agent-bridge start <task-id>                  （worker）標記開工（delivered → running）
  agent-bridge reply <task-id> (--message <text> | --message-file <path>)
                                                回覆任務（delivered/running 可回）
  agent-bridge fail <task-id> (--message <text> | --message-file <path>)
                                                回報任務失敗（delivered/running 可；訊息＝失敗原因）
  agent-bridge cancel <task-id>                 取消任務（queued/delivered/running 可）
  agent-bridge status <task-id>                 印裸狀態字（queued/delivered/running/completed/failed/cancelled）
  agent-bridge read <task-id>                   讀回覆（completed/failed 可；標頭走 stderr、response 原文走 stdout）
  agent-bridge await <task-id> [--timeout <secs>]
                                                阻塞等待 task 到終態，印裸狀態字後 exit 0；逾時非零退出
  agent-bridge spawn <name> --runtime <codex|claude> [--window]
                                                spawn 一個 worker pane 並註冊；stdout 只印 pane-id
  agent-bridge relay <name> --runtime <codex|claude> --handoff <path> [--window] [--no-select] [--self-exit <my-name>]
                                                把主導權交給新 session（注入接手者守則＋交接檔）；stdout 只印 pane-id
  agent-bridge despawn <name>                   回收 spawn 出身的 worker（kill pane＋除名；人工註冊拒殺）
  agent-bridge ready <name>                     （worker）回報就緒；僅限 spawned agent
  agent-bridge disposable <name>                （worker）宣告本輪脈絡已無殘值，可即時回收
                                                （預設是保留：沒宣告過的一律視為仍有殘值）
  agent-bridge idle                             worker 池回收決策視圖；唯讀
                                                （name<TAB>ready<TAB>disposable<TAB>idle_secs）
  agent-bridge evict <name> [--timeout <secs>] [--from <sender>]
                                                驅逐 worker：派收尾任務 → 等筆記落地 → despawn
                                                stdout 只印收尾 task-id；逾時仍 despawn（審計記 evicted-timeout）
  agent-bridge gc [--older-than <days>] [--apply] [--include-notes]
                                                清掉夠舊的終態 task（預設 14 天）；未完成的與
                                                evict 收尾筆記一律保留。預設只試算，--apply 才刪

--message-file 用 `-` 表示讀 stdin。
資料目錄預設 ~/.local/share/agent-bridge/，可用 AGENT_BRIDGE_DATA 覆蓋。
await 輪詢間隔預設 1 秒，可用 AGENT_BRIDGE_POLL_INTERVAL 覆蓋；--timeout 0（預設）＝不逾時。
evict 的 --timeout 預設 300 秒、--from 預設 orchestrator；--timeout 0＝無限等，
等於放棄「一定騰得出 cap」這個保證，只在確定 worker 還活著時才用。
spawn 上限 AGENT_BRIDGE_MAX_SPAWN（預設 4）；就緒等待 AGENT_BRIDGE_READY_TIMEOUT
秒（預設 30，0＝不等待），探針重送間隔 AGENT_BRIDGE_READY_PROBE_INTERVAL（預設 2）。
EOF
}

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

rand_suffix() { head -c 2 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

ensure_dirs() { mkdir -p "$AGENTS_DIR" "$TASKS_DIR" "$LOCKS_DIR"; }

# is_spawned <registry-file>：0＝spawn 出身，1＝不是，2＝無法判定（JSON 損壞／讀不到）
# 直接用 `jq -e '.spawned == true'` 會把「條件為 false」與「檔案是壞的」壓成同一個
# 非零，出身判斷因此 fail-open：一份損壞的 registry 會被當成人工註冊而遭覆寫或除名
is_spawned() {
  local f="$1" out
  # 非 object 的合法 JSON（例如字面 null）也算判不出來：那不是一份 registry，
  # 當成「人工註冊」就會被覆寫或除名
  out="$(jq -r 'if type != "object" then "bad" elif .spawned == true then "yes" else "no" end' \
    "$f" 2>/dev/null)" || return 2
  case "$out" in
    yes) return 0 ;;
    no)  return 1 ;;
    *)   return 2 ;;
  esac
}

require_jq() {
  command -v jq >/dev/null 2>&1 \
    || die "缺少硬依賴 jq，請先安裝（例如 pacman -S jq）"
}

# atomic_write <dest>：內容從 stdin，同檔案系統 mktemp + mv 保證原子性
atomic_write() {
  local dest="$1" tmp
  tmp="$(mktemp "$(dirname "$dest")/.tmp.XXXXXX")"
  cat > "$tmp"
  mv "$tmp" "$dest"
}

# despawn 的 generation 綁定：由 cmd_evict 在呼叫前設成它一開始看到的
# spawn_tag，空字串＝不綁定（直接 despawn 的一般情形）。用全域而非參數，是為了
# 不把這個內部契約暴露成對外的 CLI 參數——despawn 的參數面是安全路徑，多一個
# 未文件化的參數就多一條要防的輸入
DESPAWN_EXPECT_TAG=""

# send 的 pin 標記：由 cmd_evict 在呼叫前設成 1，讓收尾任務的 metadata 帶
# pinned:true，gc 一律跳過。收尾筆記是這一層刻意留下來的脈絡——「上下文不會憑空
# 消失」這個承諾，若筆記會被 GC 靜靜清掉就只是延後兌現。同樣用全域而非參數：
# send 是核心路徑，參數面不該為了內部契約變寬
SEND_PIN=""

# evict 呼叫 despawn 時設 1：表示收尾筆記已經走過流程（落地或已記未落地），
# despawn 不必再記 despawned-unsaved
DESPAWN_NOTES_HANDLED=""

# cmd_despawn 的結果回報給呼叫者：killed（真的關掉了 pane）／absent（pane 本來
# 就不在，只清註冊）／stale（pane 還在但已不屬於這個 agent，只清註冊）。
# evict 要靠它分辨——stale 代表那個 pane 沒被回收，這時寫 evicted 就是假紀錄
DESPAWN_RESULT=""

# ---- 鎖：mkdir lock，短暫重試後報錯 ----
LOCK_DIR=""

release_lock() {
  if [[ -n "$LOCK_DIR" && -d "$LOCK_DIR" ]]; then
    # 解不掉的鎖會擋住之後每一次同類操作。吞掉這個失敗＝留下一把沒人知道
    # 存在的鎖（例如鎖目錄被塞了檔案，rmdir 就會 Directory not empty）
    rmdir "$LOCK_DIR" 2>/dev/null \
      || err "警告：無法釋放鎖目錄 $LOCK_DIR（非空或權限問題），它會擋住後續操作，請手動移除"
  fi
  LOCK_DIR=""
}

acquire_lock() {
  local id="$1" tries=0 lock err
  lock="$LOCKS_DIR/$id.lock"
  until mkdir "$lock" 2>/dev/null; do
    # mkdir 失敗但鎖目錄不存在＝不是佔用，是權限/sandbox/檔案系統問題；
    # 重試無意義，帶出 mkdir 的真正錯誤原因（例：codex sandbox 擋
    # workspace 外寫入時，誤報「佔用中」會把人引去查錯方向）
    if [[ ! -d "$lock" ]]; then
      if err="$(mkdir "$lock" 2>&1)"; then
        break
      fi
      die "無法建立鎖目錄（非鎖佔用，疑似權限或 sandbox 寫入限制）：$err"
    fi
    tries=$((tries + 1))
    if (( tries >= 25 )); then
      die "無法取得鎖（locks/$id.lock 佔用中或殘留），請稍後重試"
    fi
    sleep 0.2
  done
  LOCK_DIR="$lock"
  trap release_lock EXIT
}

# log_event <task-id> <event> [detail]：append-only events.log
log_event() {
  local id="$1" ev="$2" detail="${3:-}" line
  line="$(now_iso) $ev"
  if [[ -n "$detail" ]]; then
    line="$line $detail"
  fi
  printf '%s\n' "$line" >> "$TASKS_DIR/$id/events.log"
}

# update_meta_status <task-dir> <new-status>：同步更新 metadata.json 與 status 檔
update_meta_status() {
  local dir="$1" new="$2" ts updated
  ts="$(now_iso)"
  updated="$(jq --arg s "$new" --arg t "$ts" '.status = $s | .updated_at = $t' "$dir/metadata.json")"
  printf '%s\n' "$updated" | atomic_write "$dir/metadata.json"
  printf '%s\n' "$new" | atomic_write "$dir/status"
}

# write_message <dest> <mode:text|file> <value>；file 模式的 `-` 讀 stdin
write_message() {
  local dest="$1" mode="$2" val="$3"
  if [[ "$mode" == "text" ]]; then
    printf '%s\n' "$val" | atomic_write "$dest"
  elif [[ "$val" == "-" ]]; then
    atomic_write "$dest"
  else
    [[ -f "$val" ]] || die "找不到訊息檔：$val"
    atomic_write "$dest" < "$val"
  fi
}

# notify_pane <pane_id> <one-line-cmd>：先驗證 pane 存活再 send-keys；失敗回非零
# Enter 與文字拆成兩次送並隔一小段延遲：agent REPL（claude/codex 等 TUI）
# 會把同批抵達的文字+Enter 當成貼上，Enter 被吞掉導致指令留在輸入框不送出
notify_pane() {
  local pane="$1" cmd="$2"
  [[ "$pane" =~ $PANE_RE ]] || return 1
  command -v tmux >/dev/null 2>&1 || return 1
  tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -Fx "$pane" >/dev/null || return 1
  tmux send-keys -t "$pane" "$cmd" 2>/dev/null || return 1
  sleep "${AGENT_BRIDGE_NOTIFY_DELAY:-0.3}"
  tmux send-keys -t "$pane" Enter 2>/dev/null
}

check_task_id() {
  local id="$1"
  [[ "$id" =~ $TASK_ID_RE ]] || die "task-id 不合法：$id"
}

# last_task_at <agent>：最後一個派給該 agent 的任務建立時間（ISO），從未被派工
# 則回空字串。掃 tasks/ 而不是在 send 時把 last_task_at 記進 registry——send 是
# 核心路徑，加一次「取 registry 鎖＋寫入」會擴大它的失敗面（鎖競爭時 send 會
# 整個失敗），而這個資訊只有回收決策要用。代價是 O(task 數)，task GC 是已知
# backlog。
# ISO 8601 UTC 定長字串可直接字典序比大小，不必轉 epoch。
# disposable_effective <agent> <registry-file>：這個 agent 的「無殘值」宣告
# 現在還算不算數。0＝仍有效（可即時回收）／1＝無效（沒宣告過，或宣告後又被
# 派了新任務、已累積新脈絡）。
#
# 抽成共用函式是因為兩個地方要問同一個問題：idle 決定第三欄印 yes 還是
# expired，despawn 決定審計記 despawned 還是 despawned-unsaved。這兩處若各寫
# 一份，遲早漂移成兩套語意，而它們的錯誤方向都是「把有殘值的當成沒殘值」。
#
# 同秒也算過期（`>=` 而非 `>`）：時間戳是秒精度，worker 宣告後 orchestrator
# 立刻派工就會落在同一秒。用嚴格大於的話那一秒內仍報 yes，於是一個剛拿到新
# 任務、正在累積新脈絡的 worker 會被直接回收，不走 evict、不留筆記。兩個方向
# 的代價不對等——判太嚴只是多派一輪收尾（多佔 cap），判太鬆是殺掉還有用的
# 脈絡。（bash 無字串 `>=`，故寫成「不小於」。獨立複核 2026-07-22 抓出）
disposable_effective() {
  local name="$1" f="$2" disp_at last_at
  disp_at="$(jq -r 'if .disposable == true then (.disposable_at // "?") else "" end' "$f" 2>/dev/null)" \
    || return 1
  [[ -n "$disp_at" ]] || return 1
  # 宣告了但沒有時間戳：無從判斷是否被後續任務推翻，當成無效（偏保守那邊）
  [[ "$disp_at" != "?" ]] || return 1
  last_at="$(last_task_at "$name")"
  [[ -n "$last_at" ]] || return 0
  [[ "$last_at" < "$disp_at" ]] || return 1
  return 0
}

last_task_at() {
  local who="$1" d latest="" ts to
  shopt -s nullglob
  for d in "$TASKS_DIR"/*/; do
    [[ -f "$d/metadata.json" ]] || continue
    # 單一損壞的 metadata 不該讓整份報表消失：跳過它，繼續看其他任務
    to="$(jq -r '.to // ""' "$d/metadata.json" 2>/dev/null)" || continue
    [[ "$to" == "$who" ]] || continue
    ts="$(jq -r '.created_at // ""' "$d/metadata.json" 2>/dev/null)" || continue
    [[ -n "$ts" ]] || continue
    if [[ -z "$latest" || "$ts" > "$latest" ]]; then
      latest="$ts"
    fi
  done
  printf '%s' "$latest"
}

# ---- 指令 ----

cmd_register() {
  (( $# == 2 )) || die "用法：agent-bridge register <agent> <tmux-target>"
  local name="$1" target="$2" pane ts doc
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  command -v tmux >/dev/null 2>&1 || die "找不到 tmux，register 需要 tmux"
  if ! pane="$(tmux display -pt "$target" '#{pane_id}' 2>/dev/null)" || [[ -z "$pane" ]]; then
    die "無法解析 tmux target：$target"
  fi
  ts="$(now_iso)"
  doc="$(jq -n --arg name "$name" --arg pane "$pane" --arg ts "$ts" \
    '{name: $name, pane_id: $pane, registered_at: $ts}')"
  # 取 registry 鎖再寫：與 spawn/despawn/ready 互斥。覆寫 spawned agent 會洗掉
  # 出身標記（pane 變成殺不掉的孤兒，且能誘使 despawn 殺到人工 pane），故拒絕
  acquire_lock agents-registry
  if [[ -e "$AGENTS_DIR/$name.json" ]]; then
    local sp_rc=0
    is_spawned "$AGENTS_DIR/$name.json" || sp_rc=$?
    case $sp_rc in
      0) die "agent '$name' 是 spawn 出身的 worker，register 拒絕覆寫（要換 pane 請先 despawn）" ;;
      2) die "agent '$name' 的 registry 無法解析，出身不明，register 拒絕覆寫；請確認 $AGENTS_DIR/$name.json 後手動處理" ;;
    esac
  fi
  printf '%s\n' "$doc" | atomic_write "$AGENTS_DIR/$name.json"
  release_lock
  info "已註冊 agent '$name' → pane $pane"
}

cmd_unregister() {
  (( $# == 1 )) || die "用法：agent-bridge unregister <agent>"
  local name="$1"
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  local f="$AGENTS_DIR/$name.json"
  # 鎖內檢查：單純除名 spawned agent 會留下沒人認領的 pane，且讓 cap 少算一個
  acquire_lock agents-registry
  [[ -f "$f" ]] || die "未註冊的 agent：$name"
  local sp_rc=0
  is_spawned "$f" || sp_rc=$?
  case $sp_rc in
    0) die "agent '$name' 是 spawn 出身的 worker，unregister 拒絕（請用 despawn 一併回收 pane）" ;;
    2) die "agent '$name' 的 registry 無法解析，出身不明，unregister 拒絕（若它其實是 spawned，除名會留下沒人回收的 pane）；請確認 $f 後手動處理" ;;
  esac
  rm -- "$f"
  release_lock
  info "已移除 agent '$name' 的註冊"
}

cmd_list() {
  local f name pane ready
  shopt -s nullglob
  for f in "$AGENTS_DIR"/*.json; do
    name="$(jq -r '.name' "$f")"
    pane="$(jq -r '.pane_id' "$f")"
    # ready 欄：人工註冊 `-`；spawned 依 .ready 顯示 starting/ready
    ready="$(jq -r 'if .spawned == true
                    then (if .ready == true then "ready" else "starting" end)
                    else "-" end' "$f")"
    printf '%s\t%s\t%s\n' "$name" "$pane" "$ready"
  done
}

cmd_send() {
  (( $# >= 1 )) || die "用法：agent-bridge send <agent> --from <sender> (--message <text> | --message-file <path>)"
  local to="$1"; shift
  local from="" mode="" val=""
  while (( $# > 0 )); do
    case "$1" in
      --from)
        shift; (( $# > 0 )) || die "--from 需要參數"
        from="$1" ;;
      --message)
        shift; (( $# > 0 )) || die "--message 需要參數"
        [[ -z "$mode" ]] || die "--message 與 --message-file 只能擇一"
        mode="text"; val="$1" ;;
      --message-file)
        shift; (( $# > 0 )) || die "--message-file 需要參數"
        [[ -z "$mode" ]] || die "--message 與 --message-file 只能擇一"
        mode="file"; val="$1" ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  [[ -n "$from" ]] || die "send 需要 --from <sender>"
  [[ -n "$mode" ]] || die "send 需要 --message 或 --message-file"
  [[ "$to" =~ $NAME_RE ]]   || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$to"
  [[ "$from" =~ $NAME_RE ]] || die "sender 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$from"

  local agent_file="$AGENTS_DIR/$to.json"
  [[ -f "$agent_file" ]] || die "未註冊的 agent：$to（先用 agent-bridge register）"
  if jq -e '.spawned == true and .ready != true' "$agent_file" >/dev/null 2>&1; then
    err "警告：agent '$to' 尚未回報就緒（starting），通知可能延後；訊息已入 mailbox 不會遺失"
  fi
  local pane; pane="$(jq -r '.pane_id' "$agent_file")"

  local task_id dir tries=0
  while :; do
    task_id="$(date -u +%Y%m%dT%H%M%SZ)-$(rand_suffix)"
    dir="$TASKS_DIR/$task_id"
    if mkdir "$dir" 2>/dev/null; then
      break
    fi
    tries=$((tries + 1))
    (( tries < 5 )) || die "無法建立 task 目錄（task-id 連續碰撞）"
  done

  write_message "$dir/request.md" "$mode" "$val"

  local ts wd doc
  ts="$(now_iso)"
  wd="$(pwd)"
  doc="$(jq -n --arg id "$task_id" --arg from "$from" --arg to "$to" \
              --arg ts "$ts" --arg wd "$wd" --arg pin "$SEND_PIN" \
    '{version: 1, task_id: $id, from: $from, to: $to,
      created_at: $ts, updated_at: $ts,
      working_directory: $wd, status: "queued"}
     + (if $pin == "1" then {pinned: true} else {} end)')"
  printf '%s\n' "$doc" | atomic_write "$dir/metadata.json"
  printf 'queued\n' | atomic_write "$dir/status"
  log_event "$task_id" created "from=$from to=$to"

  if notify_pane "$pane" "agent-bridge receive $task_id"; then
    log_event "$task_id" notified "pane=$pane cmd=receive"
  else
    log_event "$task_id" notify-failed "pane=$pane cmd=receive"
    err "警告：無法通知 $to（pane $pane）；請手動在對方 session 執行：agent-bridge receive $task_id"
  fi

  printf '%s\n' "$task_id"
}

cmd_receive() {
  (( $# == 1 )) || die "用法：agent-bridge receive <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  acquire_lock "$id"
  local st; st="$(<"$dir/status")"
  case "$st" in
    queued)
      update_meta_status "$dir" delivered
      log_event "$id" delivered
      ;;
    delivered|running)
      log_event "$id" re-receive
      ;;
    *)
      die "task 狀態為 $st，無法 receive（僅 queued/delivered/running 可）"
      ;;
  esac
  release_lock

  local from wd
  from="$(jq -r '.from' "$dir/metadata.json")"
  wd="$(jq -r '.working_directory' "$dir/metadata.json")"
  {
    printf 'task-id: %s\n' "$id"
    printf 'from: %s\n' "$from"
    printf 'working_directory: %s\n' "$wd"
  } >&2
  cat "$dir/request.md"
}

# parse_message_opts <cmd-name> <args...>：解析 --message / --message-file，
# 結果放進 MSG_MODE / MSG_VAL（bash 函式無法回傳多值，走全域）
MSG_MODE=""
MSG_VAL=""
parse_message_opts() {
  local cmdname="$1"; shift
  MSG_MODE=""; MSG_VAL=""
  while (( $# > 0 )); do
    case "$1" in
      --message)
        shift; (( $# > 0 )) || die "--message 需要參數"
        [[ -z "$MSG_MODE" ]] || die "--message 與 --message-file 只能擇一"
        MSG_MODE="text"; MSG_VAL="$1" ;;
      --message-file)
        shift; (( $# > 0 )) || die "--message-file 需要參數"
        [[ -z "$MSG_MODE" ]] || die "--message 與 --message-file 只能擇一"
        MSG_MODE="file"; MSG_VAL="$1" ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  [[ -n "$MSG_MODE" ]] || die "$cmdname 需要 --message 或 --message-file"
}

# respond_task <id> <final-status> <event> <cmd-name>：reply / fail 的共用主體——
# 寫 response.md、轉終態、通知 sender 讀回覆（訊息內容取自 MSG_MODE/MSG_VAL）
respond_task() {
  local id="$1" final="$2" ev="$3" cmdname="$4"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  acquire_lock "$id"
  local st; st="$(<"$dir/status")"
  if [[ "$st" != "delivered" && "$st" != "running" ]]; then
    die "task 狀態為 $st，僅 delivered/running 可 $cmdname（queued 請先 receive；終態不可再變更）"
  fi
  write_message "$dir/response.md" "$MSG_MODE" "$MSG_VAL"
  update_meta_status "$dir" "$final"
  log_event "$id" "$ev"
  release_lock

  local from; from="$(jq -r '.from' "$dir/metadata.json")"
  if [[ -f "$AGENTS_DIR/$from.json" ]]; then
    local pane; pane="$(jq -r '.pane_id' "$AGENTS_DIR/$from.json")"
    if notify_pane "$pane" "agent-bridge read $id"; then
      log_event "$id" notified "pane=$pane cmd=read"
    else
      log_event "$id" notify-failed "pane=$pane cmd=read"
      err "警告：無法通知 $from（pane $pane）；請手動在對方 session 執行：agent-bridge read $id"
    fi
  fi
}

cmd_reply() {
  (( $# >= 1 )) || die "用法：agent-bridge reply <task-id> (--message <text> | --message-file <path>)"
  local id="$1"; shift
  check_task_id "$id"
  parse_message_opts reply "$@"
  respond_task "$id" completed replied reply
  info "已回覆 task $id（completed）"
}

cmd_fail() {
  (( $# >= 1 )) || die "用法：agent-bridge fail <task-id> (--message <text> | --message-file <path>)"
  local id="$1"; shift
  check_task_id "$id"
  parse_message_opts fail "$@"
  respond_task "$id" failed failed fail
  info "已回報 task $id 失敗（failed）"
}

cmd_start() {
  (( $# == 1 )) || die "用法：agent-bridge start <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  acquire_lock "$id"
  local st; st="$(<"$dir/status")"
  if [[ "$st" != "delivered" ]]; then
    die "task 狀態為 $st，僅 delivered 可 start（queued 請先 receive）"
  fi
  update_meta_status "$dir" running
  log_event "$id" started
  release_lock
  info "task $id 開工（running）"
}

cmd_cancel() {
  (( $# == 1 )) || die "用法：agent-bridge cancel <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  acquire_lock "$id"
  local st; st="$(<"$dir/status")"
  case "$st" in
    queued|delivered|running) ;;
    *) die "task 狀態為 $st，無法 cancel（僅 queued/delivered/running 可）" ;;
  esac
  update_meta_status "$dir" cancelled
  log_event "$id" cancelled
  release_lock

  # 通知 worker 查狀態（會看到 cancelled）；通知失敗不影響取消本身
  local to; to="$(jq -r '.to' "$dir/metadata.json")"
  if [[ -f "$AGENTS_DIR/$to.json" ]]; then
    local pane; pane="$(jq -r '.pane_id' "$AGENTS_DIR/$to.json")"
    if notify_pane "$pane" "agent-bridge status $id"; then
      log_event "$id" notified "pane=$pane cmd=status"
    else
      log_event "$id" notify-failed "pane=$pane cmd=status"
      err "警告：無法通知 $to（pane $pane）；對方查 status $id 時會看到 cancelled"
    fi
  fi
  info "已取消 task $id（cancelled）"
}

cmd_status() {
  (( $# == 1 )) || die "用法：agent-bridge status <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"
  printf '%s\n' "$(<"$dir/status")"
}

cmd_read() {
  (( $# == 1 )) || die "用法：agent-bridge read <task-id>"
  local id="$1"
  check_task_id "$id"
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  local st; st="$(<"$dir/status")"
  case "$st" in
    completed|failed) ;;
    cancelled)
      die "task $id 已取消（cancelled），沒有回覆可讀"
      ;;
    *)
      die "task $id 尚未回覆（狀態：$st）；查詢進度請用 agent-bridge status $id"
      ;;
  esac

  local from to
  from="$(jq -r '.from' "$dir/metadata.json")"
  to="$(jq -r '.to' "$dir/metadata.json")"
  {
    printf 'task-id: %s\n' "$id"
    printf 'from: %s\n' "$from"
    printf 'to: %s\n' "$to"
  } >&2
  log_event "$id" read
  cat "$dir/response.md"
}

# await：sender 端的等待原語。唯讀輪詢 status 檔（不寫 events、不取鎖），
# 在只讀 sandbox 內也能用；設計給「送出後在背景等回覆」的用法。
cmd_await() {
  (( $# >= 1 )) || die "用法：agent-bridge await <task-id> [--timeout <secs>]"
  local id="$1"; shift
  check_task_id "$id"
  local timeout=0
  while (( $# > 0 )); do
    case "$1" in
      --timeout)
        shift; (( $# > 0 )) || die "--timeout 需要參數"
        # 10# 強制十進位：前導零（08）否則會被 Bash 算術當八進位而爆錯；
        # 位數上限同時擋掉 64 位算術溢位
        [[ "$1" =~ ^[0-9]{1,9}$ ]] || die "--timeout 需為非負整數（秒，至多 9 位），0＝不逾時：$1"
        timeout=$((10#$1)) ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  local dir="$TASKS_DIR/$id"
  [[ -d "$dir" ]] || die "找不到 task：$id"

  local interval="${AGENT_BRIDGE_POLL_INTERVAL:-1}" st
  SECONDS=0
  while :; do
    st="$(<"$dir/status")"
    case "$st" in
      completed|failed|cancelled)
        printf '%s\n' "$st"
        return 0
        ;;
    esac
    if (( timeout > 0 && SECONDS >= timeout )); then
      die "await 逾時（${timeout}s）：task $id 目前狀態 $st"
    fi
    sleep "$interval"
  done
}

# ---- spawn / despawn：worker pane 生命週期 ----

# 審計：$DATA_DIR/agents.log 追加 <ts> spawned|despawned|disposable <name> <pane> <runtime>
# disposable 也記一筆：它是回收決策的依據，日後若有「不該收的被收了」的爭議，
# 審計線要能還原「誰在什麼時候宣告自己可拋」
log_agent_event() {
  local action="$1" name="$2" pane="$3" runtime="$4"
  printf '%s %s %s %s %s\n' "$(now_iso)" "$action" "$name" "$pane" "$runtime" \
    >> "$DATA_DIR/agents.log"
}

# spawn 失敗回滾：EXIT trap 讀取。解除回滾靠單一旗標而非逐一清空三個變數——
# 訊號可能落在兩次賦值之間，讓 trap 看到「有 tag、沒有 registry 路徑」這種
# 半清空狀態，於是殺了 pane 卻留下 registry
SPAWN_DONE=0
SPAWN_RB_PANE=""
SPAWN_RB_REG=""
SPAWN_RB_TAG=""
# rb_kill_tagged <pane>：原子地「驗 tag 才殺」，並確認 pane 真的消失。
# 與 cmd_despawn 同一套理由——分成「查一次、再殺一次」的話，中間 tmux server
# 若被替換，第二次呼叫會殺到新 server 上同 id 的人工 pane。回傳 0＝已不存在
# shellcheck disable=SC2329  # 經 spawn_rollback 間接呼叫
rb_kill_tagged() {
  local p="$1" after
  [[ "$p" =~ $PANE_RE ]] || return 1
  tmux if-shell -t "$p" -F "#{m:\"$SPAWN_RB_TAG *,#{pane_start_command}}" \
    "kill-pane -t $p" 2>/dev/null || true
  # 查詢失敗要回報「無法確認」而不是「已消失」：把 tmux 掛掉當成 pane 不見了，
  # 正是 despawn 那條被揪出來的錯誤判斷方向
  after="$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null)" || return 1
  ! grep -Fx "$p" <<< "$after" >/dev/null
}

# shellcheck disable=SC2329  # 經 EXIT trap 間接呼叫
spawn_rollback() {
  # spawn 已完成：單一旗標，讀到就整個 no-op
  (( SPAWN_DONE == 1 )) && return 0
  # 全程容錯：本函式在 EXIT trap 的第一順位，任一步以非零收場都會在 set -e
  # 下吃掉後面的 release_lock，留下鎖殘留
  if [[ -n "$SPAWN_RB_TAG" ]]; then
    if [[ -n "$SPAWN_RB_PANE" ]]; then
      rb_kill_tagged "$SPAWN_RB_PANE" \
        || err "警告：回滾未能關閉 pane $SPAWN_RB_PANE，請手動確認後 tmux kill-pane -t $SPAWN_RB_PANE"
    else
      # pane 已建立但 pane id 沒回到手上（命令替換失敗、輸出遺失、中途被中斷）：
      # 靠啟動指令裡的一次性 tag 掃出孤兒 pane，否則它永遠沒人認領。
      # 比對必須錨在啟動指令**開頭**（tag 是我們自己加的 env 前綴）：無邊界的
      # 子字串比對會誤殺任何參數裡碰巧含這串的別人 pane
      # 查詢失敗不能吞：迴圈跑零次跟「沒有孤兒」長得一模一樣，
      # 靜默下去就是留一個沒人認領的 pane 卻宣稱回滾乾淨
      local pid cmd scan
      if scan="$(tmux list-panes -a -F '#{pane_id} #{pane_start_command}' 2>/dev/null)"; then
        while read -r pid cmd; do
          # tmux 會把整條啟動指令加雙引號存進 pane_start_command（實測 3.7b），
          # 先剝掉前導引號才錨得住開頭
          cmd="${cmd#\"}"
          if [[ "$cmd" == "$SPAWN_RB_TAG "* ]]; then
            rb_kill_tagged "$pid" \
              || err "警告：回滾未能關閉孤兒 pane $pid，請手動確認後 tmux kill-pane -t $pid"
          fi
        done <<< "$scan"
      else
        err "警告：回滾無法查詢 tmux pane，可能殘留一個啟動指令帶 $SPAWN_RB_TAG 的孤兒 pane，請手動確認並關閉"
      fi
    fi
  fi
  if [[ -n "$SPAWN_RB_REG" ]]; then
    # 刪不掉要講出來：靜默吞掉會留下一筆沒有 pane 的殭屍 registry，
    # 它照樣佔 cap、也擋住同名 spawn。不中止 trap（否則吃掉 release_lock）
    rm -f -- "$SPAWN_RB_REG" 2>/dev/null \
      || err "警告：回滾未能刪除 registry $SPAWN_RB_REG，請手動清除（它仍佔用 spawn 名額）"
  fi
  # 回滾只做一次：同樣用單一旗標，不逐一清空（理由同上）
  SPAWN_DONE=1
}

# 就緒自報到：間隔重送探針（agent-bridge ready <name>）直到 registry 翻
# ready 或逾時。REPL 啟動期吃掉的按鍵靠重送覆蓋；逾時不回滾、僅警告，
# pane 留用供人工診斷。
# validate_ready_opts：兩個 readiness 參數必須在建 pane 之前就驗。等到
# spawn_wait_ready 才 die 的話，pane 與 registry 都已落地、回滾也已解除，
# 呼叫端只看到非零退出，卻留下一個佔著 cap 的 worker
validate_ready_opts() {
  local t="${AGENT_BRIDGE_READY_TIMEOUT:-30}" i="${AGENT_BRIDGE_READY_PROBE_INTERVAL:-2}"
  [[ "$t" =~ ^[0-9]{1,9}$ ]] \
    || die "AGENT_BRIDGE_READY_TIMEOUT 需為非負整數（秒，至多 9 位；0＝不等待）：$t"
  [[ "$i" =~ ^([0-9]+|[0-9]*\.[0-9]+)$ ]] \
    || die "AGENT_BRIDGE_READY_PROBE_INTERVAL 需為正數（秒）：$i"
  # 格式已確認是數字，所以「小數點前後都只有 0（或省略整數位）」即代表零值。
  # 寫成 ^0+... 會漏掉 .0／.00 這種省略整數位的零
  [[ ! "$i" =~ ^0*(\.0+)?$ ]] \
    || die "AGENT_BRIDGE_READY_PROBE_INTERVAL 需大於 0（否則探針會忙迴圈）：$i"
}

# 把 brief 檔＋動態尾巴組成 runtime 的 initial prompt 參數（單一 shell word）。
# brief 全文刻意不進命令列：改讓 tmux 的 sh -c 在 pane 內展開 $(cat ...)，
# 啟動指令因此維持短、pane_start_command 仍可讀，也免去把整份 Markdown 塞進
# 命令字串的跳脫地獄。代價是展開時機延到 pane 啟動：brief 雖已於建 pane 前
# 驗過是可讀的普通檔案，那之後仍有 TOCTOU 空隙——被刪或換掉會退化成沒有守則
# 的 worker，換成 FIFO 之類讀不完的來源則會讓 pane 卡在讀取。兩者都不會殺錯
# 東西，但後者會留下佔 cap 的 starting pane（見 README「殘留缺口」）
worker_prompt_arg() {
  local name="$1" brief="$2"
  # 路徑要以單引號字面值送進 sh；含單引號就湊不出安全的字面值，fail-closed
  [[ "$brief" != *"'"* ]] || die "worker brief 路徑不可含單引號：$brief"
  # 尾巴保持單行：換行進 tmux 命令字串只是徒增變數。
  # $name 已由 NAME_RE 限成 [A-Za-z0-9_-]+，沒有注入面
  # shellcheck disable=SC2016  # $(cat …) 刻意不在此展開，留給 pane 內的 sh
  # `cat --`：AGENT_BRIDGE_WORKER_BRIEF 是公開覆蓋介面，接得到相對路徑；
  # 少了 option terminator，一個叫 `--help` 的檔案會被 cat 當成選項，
  # spawn 照樣成功卻注入了完全錯誤的 prompt
  printf '"$(cat -- '\''%s'\'')  ——以上是你的 worker 守則。你的 agent 名稱是 %s。第一件事：立刻執行 agent-bridge ready %s"' \
    "$brief" "$name" "$name"
}

# relay 版的 initial prompt：接手者守則 ＋ 交接檔路徑 ＋（可選）要回收的前一棒。
# 與 worker_prompt_arg 的三道防線相同，但這裡更要緊：handoff 路徑來自使用者
# 命令列，不像 WORKER_BRIEF 是內部常數，暴露面大一級
relay_prompt_arg() {
  local name="$1" brief="$2" handoff="$3" prev="$4"
  [[ "$brief" != *"'"* ]] || die "接手者 brief 路徑不可含單引號：$brief"
  [[ "$handoff" != *"'"* ]] || die "交接檔路徑不可含單引號：$handoff"
  # prev 已由呼叫端以 NAME_RE 驗過，這裡不再展開成 shell 字面值以外的東西
  local tail=""
  if [[ -n "$prev" ]]; then
    tail="接手完成後，回收前一棒：執行 agent-bridge despawn $prev（若對方是人工開的 session，這個命令會被拒絕，那是正常的，看到就繼續做事）。"
  fi
  # shellcheck disable=SC2016  # $(cat …) 刻意不在此展開，留給 pane 內的 sh
  printf '"$(cat -- '\''%s'\'')  ——以上是你的接手者守則。你的 agent 名稱是 %s。要接續的交接檔：%s。第一件事：立刻執行 agent-bridge ready %s，接著讀那份交接檔並依其「下一步」開始執行。%s"' \
    "$brief" "$name" "$handoff" "$name" "$tail"
}

spawn_wait_ready() {
  local name="$1" pane="$2"
  # 兩個參數已由 validate_ready_opts 在建 pane 前驗過
  local timeout="${AGENT_BRIDGE_READY_TIMEOUT:-30}"
  local interval="${AGENT_BRIDGE_READY_PROBE_INTERVAL:-2}"
  timeout=$((10#$timeout))
  if (( timeout == 0 )); then
    return 0
  fi
  local reg="$AGENTS_DIR/$name.json"
  SECONDS=0
  while :; do
    if jq -e '.ready == true' "$reg" >/dev/null 2>&1; then
      info "agent '$name' 已回報就緒（ready）"
      return 0
    fi
    if (( SECONDS >= timeout )); then
      err "警告：agent '$name' 於 ${timeout}s 內未回報就緒；pane $pane 留用供診斷，可於該 pane 手動執行：agent-bridge ready $name"
      return 0
    fi
    notify_pane "$pane" "agent-bridge ready $name" || true
    sleep "$interval"
  done
}

cmd_spawn() {
  (( $# >= 1 )) || die "用法：agent-bridge spawn <name> --runtime <codex|claude> [--window]"
  local name="$1"; shift
  local runtime="" use_window=0
  while (( $# > 0 )); do
    case "$1" in
      --runtime)
        shift; (( $# > 0 )) || die "--runtime 需要參數"
        runtime="$1" ;;
      --window) use_window=1 ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  [[ -n "$runtime" ]] || die "spawn 需要 --runtime <runtime>（支援 codex、claude）"

  # runtime 表：指令 ＋ 守則注入方式。目前每個 runtime 都走「initial prompt
  # 位置參數」（codex/claude/gemini 等 agent CLI 的共通形狀：`cmd [OPTIONS]
  # [PROMPT]`）。新增 runtime 前先實測該 CLI 的位置參數確實會被當第一則 user
  # message 執行；若某個 runtime 只吃 stdin 或需要別的旗標，這裡要一併長出
  # 對應的注入方式，不要硬套。
  #
  # claude 的取捨（實測 Claude Code，形狀 `claude [options] [command] [prompt]`）：
  #   - `--permission-mode auto`：worker 必須零人工介入執行探針命令。auto 雖已是
  #     此機器的預設，仍明寫——runtime 表不該依賴使用者哪天改掉 defaultMode。
  #     刻意不用 bypassPermissions。理由只取官方文件明載的部分，不臆測機制：
  #     官方把該模式定位為「Isolated containers and VMs only」，而 worker pane
  #     就跑在使用者本機、與主 session 共用檔案系統與憑證，不是隔離環境；
  #     auto 則是「Everything, with background safety checks」，保留那層背景
  #     檢查，且 protected paths 的寫入在除 bypass 外的所有模式都不會被自動
  #     核准。（注意：bypassPermissions 並不停用 hooks——停用 hooks 的是
  #     --bare；deny 與 explicit ask 規則在該模式下也仍然適用。早期版本的這段
  #     註解兩度寫錯這個因果，由獨立複核對照官方文件糾正）
  #   - 刻意不加 --settings/--setting-sources：worker 繼承使用者全域設定，
  #     與主 session 同一套安全規則。代價是 worker brief 與全域守則並存，
  #     可能被全域規則改寫命令形式（實測見過 echo 重導向被換成 Write 工具）；
  #     `agent-bridge` 是外部 CLI、沒有等價工具，故不受這條影響
  #   - 不可用 -p/--print：那是 headless，跑完即退出，pane 不會留下來收探針
  local runtime_cmd
  case "$runtime" in
    codex) runtime_cmd="codex --profile agent-worker" ;;
    claude) runtime_cmd="claude --permission-mode auto" ;;
    *) die "不支援的 runtime：$runtime（支援 codex、claude）" ;;
  esac
  command -v tmux >/dev/null 2>&1 || die "找不到 tmux，spawn 需要 tmux"
  command -v "${runtime_cmd%% *}" >/dev/null 2>&1 \
    || die "找不到 runtime 指令：${runtime_cmd%% *}"

  # brief 讀不到就不開 pane：沒有守則的 worker 收到探針只會當成對話回覆，
  # 開出來也是壞的（正是這條路徑當初讓 Phase 4 gate 失敗）。檢查必須在建
  # pane 之前，理由同 validate_ready_opts：pane 落地後才 die 會留下一個
  # 佔著 cap 的 worker
  # 要驗普通檔案，不能只驗可讀：`[[ -r ]]` 對目錄一樣成立，而 pane 內的
  # `cat` 讀目錄會失敗、命令替換卻仍返回空字串，runtime 照樣被 exec 起來——
  # 於是開出一個沒有守則的 worker，正好是這道檢查要擋的東西。-f 一併擋掉
  # FIFO 與裝置檔（cat 會卡住或讀出無關內容）
  # relay 模式注入接手者守則，其餘（cap、tag、回滾、夭折偵測、registry）完全
  # 共用——那條路徑的安全不變量經過九輪複核，不複製第二份
  local brief_path="$WORKER_BRIEF" brief_kind="worker brief" brief_env="AGENT_BRIDGE_WORKER_BRIEF"
  if [[ -n "$RELAY_HANDOFF" ]]; then
    brief_path="$SUCCESSOR_BRIEF"; brief_kind="接手者 brief"; brief_env="AGENT_BRIDGE_SUCCESSOR_BRIEF"
  fi
  [[ -f "$brief_path" && -r "$brief_path" ]] \
    || die "$brief_kind 不是可讀的普通檔案：$brief_path（可用 $brief_env 指定）"

  validate_ready_opts

  local max="${AGENT_BRIDGE_MAX_SPAWN:-4}"
  [[ "$max" =~ ^[0-9]{1,9}$ ]] || die "AGENT_BRIDGE_MAX_SPAWN 需為非負整數：$max"
  max=$((10#$max))

  # cap 檢查、建 pane、註冊全部包在 registry 鎖內，杜絕並行 spawn 繞過 cap；
  # 鎖內任一步失敗 → EXIT trap 回滾（kill 已建 pane＋刪 registry 檔）
  acquire_lock agents-registry
  trap 'spawn_rollback || true; release_lock' EXIT

  if [[ -e "$AGENTS_DIR/$name.json" ]]; then
    die "agent '$name' 已註冊，spawn 不覆蓋（人工註冊請先 unregister；spawned 請先 despawn）"
  fi

  # 無法解析的 registry 保守計入 cap：漏算會讓上限形同虛設，寧可少開一個
  local count=0 f sp_rc
  for f in "$AGENTS_DIR"/*.json; do
    [[ -e "$f" ]] || continue
    sp_rc=0
    is_spawned "$f" || sp_rc=$?
    case $sp_rc in
      0|2) count=$((count + 1)) ;;
    esac
  done
  (( count < max )) \
    || die "已達 spawn 上限（AGENT_BRIDGE_MAX_SPAWN=$max，現有 spawned agent $count 個）；先 despawn 閒置 worker"

  # 一次性 tag 先於建 pane 設好：pane 一旦誕生就認得出是誰的，即使 pane id
  # 沒能回到手上，回滾仍掃得到（見 spawn_rollback）
  # tag 是刪除的依據，熵不能省：PID 會重用，光靠 16 位隨機值在舊 pane 仍留著
  # 啟動指令的情況下有誤中風險，故取 48 位。agent 名字也編進去：registry 位在
  # worker 可寫的資料目錄，若 tag 與名字無關，被注入的 worker A 只要把 B 的
  # tag 抄進自己的 registry，就能讓 orchestrator 的 `despawn A` 殺掉 B 的 pane
  local tag tagged_cmd pane
  tag="ab-spawn-$name-$$-$(rand_suffix)$(rand_suffix)$(rand_suffix)"
  local prompt_arg
  if [[ -n "$RELAY_HANDOFF" ]]; then
    prompt_arg="$(relay_prompt_arg "$name" "$brief_path" "$RELAY_HANDOFF" "$RELAY_PREV")"
  else
    prompt_arg="$(worker_prompt_arg "$name" "$brief_path")"
  fi
  tagged_cmd="AGENT_BRIDGE_SPAWN_TAG=$tag exec $runtime_cmd $prompt_arg"
  # 回滾比對的是「env 前綴＋一個空白」，見 spawn_rollback
  SPAWN_RB_TAG="AGENT_BRIDGE_SPAWN_TAG=$tag"
  if (( use_window == 1 )); then
    pane="$(tmux new-window -dP -F '#{pane_id}' "$tagged_cmd")" \
      || die "tmux new-window 失敗"
  else
    pane="$(tmux split-window -dP -F '#{pane_id}' "$tagged_cmd")" \
      || die "tmux split-window 失敗"
  fi
  [[ -n "$pane" ]] || die "tmux 未回傳 pane id"
  SPAWN_RB_PANE="$pane"

  # 立刻夭折偵測：runtime 指令不存在／啟動即出錯時 pane 會瞬間消失
  sleep 0.3
  if ! tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -Fx "$pane" >/dev/null; then
    die "runtime 啟動即失敗（pane $pane 已消失）：$runtime_cmd"
  fi

  local ts doc
  ts="$(now_iso)"
  # spawn_tag 一併存進 registry：pane id 會被 tmux 重用（不同 server、server
  # 重啟後計數器歸零），光憑 id 無法證明「這個 pane 就是我 spawn 的那一個」。
  # despawn 殺之前用它跟 pane 的啟動指令對得上才動手
  doc="$(jq -n --arg name "$name" --arg pane "$pane" --arg ts "$ts" --arg rt "$runtime" \
              --arg tag "$SPAWN_RB_TAG" \
    '{name: $name, pane_id: $pane, registered_at: $ts,
      spawned: true, runtime: $rt, spawned_at: $ts, ready: false,
      spawn_tag: $tag}')"
  SPAWN_RB_REG="$AGENTS_DIR/$name.json"
  printf '%s\n' "$doc" | atomic_write "$AGENTS_DIR/$name.json"
  log_agent_event spawned "$name" "$pane" "$runtime"

  # 註冊完成即視為 spawn 成功：一次賦值解除回滾，之後就緒逾時只警告不回滾
  SPAWN_DONE=1
  release_lock || true

  # 這之後 worker 已經存在且註冊在案，任何失敗都不該讓呼叫端以為 spawn 失敗
  # ——它會照著「失敗」去重試或放棄，實際卻留著一個佔 cap 的 worker。
  # 輸出寫不出去（stdout/stderr 被關、EPIPE）是最實際的一種
  info "已 spawn agent '$name' → pane $pane（runtime：$runtime）" || true
  printf '%s\n' "$pane" || true
  spawn_wait_ready "$name" "$pane" || true
  return 0
}

# relay：把主導權交給一個新 session。與 spawn 的差別只有兩處——注入接手者
# 守則（而非 worker 守則）、以及把焦點切過去；cap／tag／回滾／夭折偵測／
# registry 全部共用 cmd_spawn。
#
# --self-exit <my-name> 不是「自殺」：它把回收工作寫進接手者的 prompt，由 B
# 在 ready 之後 `despawn A`。這樣做不是繞路，是因為既有 despawn 的順序是
# 「kill pane → 確認已死 → 清 registry → 寫審計」（見 cmd_despawn），A 若殺
# 自己的 pane，執行中的 process 會被 SIGHUP 帶走，永遠走不到後兩步——registry
# 殘留、審計線斷掉。交給活著的 B 執行，順序不變量原封不動。
# 附帶好處：接力鏈第一棒是人工 pane，B 去 despawn 它會被既有的「非 spawn 出身，
# despawn 拒絕」擋下，第一棒的人工閘門不需要另寫檢查就成立。
cmd_relay() {
  (( $# >= 1 )) || die "用法：agent-bridge relay <name> --runtime <codex|claude> --handoff <path> [--window] [--no-select] [--self-exit <my-name>]"
  local name="$1"; shift
  local runtime="" use_window=0 handoff="" prev="" no_select=0
  while (( $# > 0 )); do
    case "$1" in
      --runtime)
        shift; (( $# > 0 )) || die "--runtime 需要參數"
        runtime="$1" ;;
      --handoff)
        shift; (( $# > 0 )) || die "--handoff 需要參數"
        handoff="$1" ;;
      --self-exit)
        shift; (( $# > 0 )) || die "--self-exit 需要參數（你自己的 agent 名稱）"
        prev="$1" ;;
      --window) use_window=1 ;;
      --no-select) no_select=1 ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  [[ -n "$handoff" ]] || die "relay 需要 --handoff <path>（要交棒的交接檔）"
  [[ -z "$prev" || "$prev" =~ $NAME_RE ]] \
    || die "--self-exit 的 agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$prev"
  # 交接檔的兩道檢查都必須在建 pane 之前，理由同 brief：pane 落地後才 die 會
  # 留下佔 cap 的孤兒。-f 一併擋掉目錄與 FIFO（cat 讀目錄會失敗但命令替換仍
  # 回空字串，接手者會拿到一份沒有交接內容的 prompt；FIFO 則讓 pane 卡在讀取）
  [[ "$handoff" != *"'"* ]] || die "交接檔路徑不可含單引號：$handoff"
  [[ -f "$handoff" && -r "$handoff" ]] \
    || die "交接檔不是可讀的普通檔案：$handoff"

  RELAY_HANDOFF="$handoff"
  RELAY_PREV="$prev"

  # 直接呼叫而非命令替換：cmd_spawn 的 die 必須終止整個 relay，包進 $( ) 會被
  # subshell 吃掉、外層照常往下跑
  local args=("$name" --runtime "$runtime")
  (( use_window == 1 )) && args+=(--window)
  cmd_spawn "${args[@]}"

  # pane id 借自 cmd_spawn 的回滾變數（成功後仍保留），避免為了取值而開 subshell
  local pane="$SPAWN_RB_PANE"
  # 切焦點：orchestrator 驅動時沒有人在看畫面，--no-select 是那條路徑的常態。
  # 失敗不致命——relay 主體（pane＋registry＋審計）此時已經成功落地
  if (( no_select == 0 )); then
    tmux select-window -t "$pane" 2>/dev/null || true
    tmux select-pane -t "$pane" 2>/dev/null || true
  fi
  if [[ -n "$prev" ]]; then
    info "已交棒給 '$name'；'$prev' 將由對方在接手後回收" || true
  else
    info "已交棒給 '$name'（前一棒未指定自動回收，請自行收尾）" || true
  fi
}

cmd_despawn() {
  (( $# == 1 )) || die "用法：agent-bridge despawn <name>"
  local name="$1"
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  local f="$AGENTS_DIR/$name.json"
  # 出身檢查必須在鎖內：檢查與 kill-pane 之間若 registry 被同名 register 換掉，
  # 鎖外檢查會拿舊紀錄放行、卻殺到新的人工 pane（TOCTOU）
  acquire_lock agents-registry
  [[ -f "$f" ]] || die "未註冊的 agent：$name"
  local sp_rc=0
  is_spawned "$f" || sp_rc=$?
  case $sp_rc in
    1) die "agent '$name' 非 spawn 出身，despawn 拒絕（人工註冊請用 unregister）" ;;
    2) die "agent '$name' 的 registry 無法解析，出身不明，despawn 拒絕；請確認 $f 後手動處理" ;;
  esac

  local pane runtime tag
  pane="$(jq -r '.pane_id' "$f")"
  runtime="$(jq -r '.runtime // "-"' "$f")"
  tag="$(jq -r '.spawn_tag // ""' "$f")"

  # generation 綁定（evict 專用；比對必須在這把鎖內，鎖外驗完到 kill 之間仍可
  # 能被換掉）。evict 是三段式的：send → await → despawn。await 與 despawn 之間
  # 同名 agent 可能已經換了一代（另一次 evict、或 despawn＋重 spawn）。只憑名字
  # 就殺，會殺掉一個沒收過收尾任務、也沒宣告 disposable 的新 worker——那正是這
  # 一層唯一不可接受的失效（順帶讓審計說謊：despawned 記新 pane、evicted 記舊）。
  # 拒絕後 pane 留著，失效方向是多佔一個 cap。（獨立複核 2026-07-22 指出）
  if [[ -n "$DESPAWN_EXPECT_TAG" && "$tag" != "$DESPAWN_EXPECT_TAG" ]]; then
    die "agent '$name' 已不是 evict 當初鎖定的那一個（spawn tag 不符，期間被換過一代）；拒絕回收以免殺掉未收尾的 worker"
  fi
  # pane_id 會被展開進 tmux 命令字串（if-shell 的 kill-pane），而 `;` 在
  # tmux 命令中是分隔符——不驗格式的話 registry 就是一條命令注入通道
  [[ "$pane" =~ $PANE_RE ]] \
    || die "registry 的 pane_id 格式不合法（疑似遭竄改），拒絕操作：$pane"

  command -v tmux >/dev/null 2>&1 || die "找不到 tmux，despawn 無法確認 pane 是否回收"

  # 查詢失敗（tmux server 不可達、sandbox 擋 socket）與「pane 不存在」是兩件事：
  # 前者無從判斷，不能當成 pane 已死而逕自清 registry——那會留下沒人回收的孤兒
  local panes
  panes="$(tmux list-panes -a -F '#{pane_id} #{pane_start_command}' 2>&1)" \
    || die "無法查詢 tmux pane（registry 保留不動，請排除後重試）：$panes"

  local live_cmd=""  found=0
  local pid cmd
  while read -r pid cmd; do
    if [[ "$pid" == "$pane" ]]; then
      found=1
      live_cmd="${cmd#\"}"
      break
    fi
  done <<< "$panes"

  if (( found == 1 )); then
    # pane id 對得上還不夠：id 會被重用，registry 也可能被寫入資料目錄的 worker
    # 竄改。啟動指令帶不帶我們當初埋的 tag，才是這個 pane 的出身證據。
    # tag 本身也要驗格式：否則 registry 裡填個 spawn_tag="bash" 就成了萬用鑰匙，
    # 任何跑 bash 的人工 pane 都會被前綴比對命中。格式含本 agent 的名字，
    # 抄別人的 tag 也對不上
    local tag_re="^AGENT_BRIDGE_SPAWN_TAG=ab-spawn-${name}-[0-9]+-[0-9a-f]{12}\$"
    if [[ ! "$tag" =~ $tag_re || "$live_cmd" != "$tag "* ]]; then
      rm -f -- "$f" \
        || die "pane $pane 已非本 agent 所有，且 registry 刪除失敗，請手動清除 $f"
      log_agent_event despawn-stale "$name" "$pane" "$runtime"
      DESPAWN_RESULT=stale
      release_lock
      err "警告：pane $pane 目前的啟動指令不帶 '$name' 的 spawn tag（id 已被別的 pane 佔用，或 registry 遭竄改）；已清除註冊，未動該 pane"
      return 0
    fi
    # 驗證與 kill 分成兩次 tmux 呼叫，中間 server 若死掉重啟、新 server 把同一個
    # %N 發給人工 pane，第二次呼叫就會殺錯人。if-shell 讓「再驗一次 tag」與
    # kill 在同一次 client 連線內完成：換了 server 就判 false，不動手。
    # tmux 會把含空白的啟動指令加上雙引號存（實測 3.7b），故 pattern 帶前導引號；
    # 萬一未來版本改了存法，這裡會判 false → 不殺 → 被下面的存活檢查擋成
    # 「保留 registry 並報錯」，失效方向是漏殺而非誤殺
    tmux if-shell -t "$pane" -F "#{m:\"$tag *,#{pane_start_command}}" \
      "kill-pane -t $pane" 2>/dev/null || true
    local after
    after="$(tmux list-panes -a -F '#{pane_id}' 2>&1)" \
      || die "kill 後無法確認 pane $pane 狀態（registry 保留不動，請排除後重試）：$after"
    if grep -Fx "$pane" <<< "$after" >/dev/null; then
      die "無法關閉 pane $pane（kill 失敗，或 tmux server 在驗證後被替換）；registry 保留不動，請排除後重試"
    fi
  fi

  # 審計要看得出「這次回收有沒有丟掉東西」。despawn 是公開指令，任何人都能繞過
  # evict 直接收掉一個沒宣告 disposable、也就是仍被視為有殘值的 worker——機制上
  # 不擋（擋了會逼出 --force，而習慣性加旗標等於防線不存在），但不能讓審計線看
  # 起來跟一次乾淨的回收一模一樣。evict 走過收尾流程，筆記已經處理過，由它設
  # DESPAWN_NOTES_HANDLED 說明，不必記 unsaved。（獨立複核 2026-07-23 指出）
  local ev=despawned
  if [[ -z "$DESPAWN_NOTES_HANDLED" ]] && ! disposable_effective "$name" "$f"; then
    ev=despawned-unsaved
  fi
  rm -f -- "$f"
  log_agent_event "$ev" "$name" "$pane" "$runtime"
  if (( found == 1 )); then DESPAWN_RESULT=killed; else DESPAWN_RESULT=absent; fi
  release_lock
  if (( found == 1 )); then
    info "已 despawn agent '$name'（pane $pane）"
  else
    info "已 despawn agent '$name'（pane $pane 已不存在，僅清除註冊）"
  fi
}

cmd_ready() {
  (( $# == 1 )) || die "用法：agent-bridge ready <name>"
  local name="$1"
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  local f="$AGENTS_DIR/$name.json"
  # 同 despawn：出身檢查與寫入之間 registry 可能被換掉，故一律鎖內檢查
  acquire_lock agents-registry
  [[ -f "$f" ]] || die "未註冊的 agent：$name"
  local sp_rc=0
  is_spawned "$f" || sp_rc=$?
  case $sp_rc in
    1) die "agent '$name' 非 spawn 出身，ready 僅限 spawned agent" ;;
    2) die "agent '$name' 的 registry 無法解析，ready 拒絕；請確認 $f 後手動處理" ;;
  esac
  local updated
  updated="$(jq '.ready = true' "$f")"
  printf '%s\n' "$updated" | atomic_write "$f"
  release_lock
  info "agent '$name' 已回報就緒（ready）"
}

# disposable：worker 宣告「本輪脈絡已無殘值，做完可以直接收」。
#
# 語意刻意是單向宣告而非雙向旗標：**預設保留**。沒宣告過的 worker 一律當成
# 還有殘值，orchestrator 不該即時回收它。失效方向因此是安全的——worker 忘記
# 宣告＝留著，最壞是多佔一個 cap（可由 evict 騰出），而不是把還有用的脈絡殺掉。
#
# 這個欄位是給 orchestrator 看的**建議，不是保護**。registry 位在每個 worker
# 都可寫的資料目錄，worker 大可自己把它改掉賴著不走；但 despawn 認的是
# spawn_tag 而不是這個欄位，所以賴不掉。不要把它當成權限機制使用。
#
# 一併寫 disposable_at 時間戳，是為了讓宣告能「過期」：worker 宣告後若又被派
# 新任務，它就有了新脈絡，但標記還留著——此時 idle 比對「最後一個任務的時間
# 晚於宣告時間」即可判定宣告失效。這樣不必在 send/receive 裡加清除邏輯，
# 那兩條是核心路徑，能不動就不動。
cmd_disposable() {
  (( $# == 1 )) || die "用法：agent-bridge disposable <name>"
  local name="$1"
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  local f="$AGENTS_DIR/$name.json"
  # 同 ready：出身檢查與寫入之間 registry 可能被換掉，故一律鎖內檢查
  acquire_lock agents-registry
  [[ -f "$f" ]] || die "未註冊的 agent：$name"
  local sp_rc=0
  is_spawned "$f" || sp_rc=$?
  case $sp_rc in
    1) die "agent '$name' 非 spawn 出身，disposable 僅限 spawned agent（人工 pane 的生命週期不歸 bridge 管）" ;;
    2) die "agent '$name' 的 registry 無法解析，disposable 拒絕；請確認 $f 後手動處理" ;;
  esac
  # pane/runtime 在鎖內取：出鎖後 registry 可能已被換掉，審計就記到別人頭上了
  local pane runtime ts updated
  pane="$(jq -r '.pane_id // "-"' "$f")"
  runtime="$(jq -r '.runtime // "-"' "$f")"
  ts="$(now_iso)"
  updated="$(jq --arg ts "$ts" '.disposable = true | .disposable_at = $ts' "$f")"
  printf '%s\n' "$updated" | atomic_write "$f"
  release_lock
  log_agent_event disposable "$name" "$pane" "$runtime"
  info "agent '$name' 已宣告可回收（disposable）"
}

# idle：worker 池的回收決策視圖。**唯讀**——不取鎖、不寫任何檔案，理由同
# cmd_await：orchestrator 可能跑在只讀 sandbox 裡，一個查詢命令不該需要寫權限。
#
# 輸出四欄 TSV：name / ready / disposable / idle_secs
#
# disposable 欄的三種值就是回收決策本身：
#   yes      有效宣告 → 可即時回收
#   expired  宣告過，但之後又被派了新任務——worker 已累積新脈絡，宣告失效
#   -        沒宣告過（預設保留），或人工註冊（生命週期不歸 bridge 管）
#
# 「宣告會過期」刻意在**讀取端**判斷，而不是在 send/receive 裡清掉欄位：
# 那兩條是核心路徑，能不動就不動。讀取端判斷的代價只是這裡多一次比對。
#
# idle_secs 取「最後一個派給它的任務建立時間」與現在的差；從未被派工過就用
# registry 的登記時間。無法解析時間時印 `-` 而不是 0——0 會被誤讀成「剛剛才
# 用過」，正好是驅逐決策最不該搞錯的方向。
# gc：清掉夠舊的終態 task 目錄。tasks/ 原本只增不減，這不只是磁碟問題——
# idle 的回收決策直接吃 tasks/ 的內容（last_task_at 掃全目錄），資料越髒決策越
# 不可信，而且那是 O(task 數) 的掃描。名稱重用那個 bug 的根因就是這裡。
#
# 三道保留線，失效方向一律是「留著」而不是「刪掉」：
#   1. 非終態（queued/delivered/running）一律不動——那是還在進行的任務
#   2. pinned（evict 的收尾筆記）一律不動，除非明確 --include-notes
#   3. 預設 dry-run，要 --apply 才真的刪
# 刪除不可逆，而這個工具的整層語意都建立在「寧可多佔空間也不要弄丟脈絡」上。
cmd_gc() {
  local days=14 apply=0 include_notes=0
  while (( $# > 0 )); do
    case "$1" in
      --older-than)
        shift; (( $# > 0 )) || die "--older-than 需要參數"
        [[ "$1" =~ ^[0-9]{1,5}$ ]] || die "--older-than 需為 0-99999 的整數天：$1"
        days="$((10#$1))" ;;
      --apply) apply=1 ;;
      --include-notes) include_notes=1 ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done

  local now cutoff kept_live=0 kept_pin=0 kept_young=0 kept_proof=0 removed=0 failed=0
  now="$(date -u +%s)"
  cutoff=$(( now - days * 86400 ))

  # 「宣告已失效」的證據不能刪。idle 判斷一個 disposable 宣告是否被後續任務推翻，
  # 靠的是掃 tasks/ 找晚於 disposable_at 的任務；那個任務一旦被 gc 清掉，證據就
  # 消失，宣告會從 expired 復活成 yes，orchestrator 據此直接回收一個其實已有新
  # 脈絡的 worker。收集現存 registry 裡還掛著宣告的 agent 與其時間戳，晚於它的
  # 任務一律保留。（獨立複核 2026-07-23 以隔離實測抓出：GC 前 expired、GC 後 yes）
  declare -A pledge=()
  local af aname adisp
  shopt -s nullglob
  for af in "$AGENTS_DIR"/*.json; do
    jq -e 'type == "object" and .disposable == true' "$af" >/dev/null 2>&1 || continue
    aname="$(jq -r '.name // ""' "$af" 2>/dev/null)" || continue
    adisp="$(jq -r '.disposable_at // ""' "$af" 2>/dev/null)" || continue
    [[ -n "$aname" && -n "$adisp" ]] || continue
    pledge["$aname"]="$adisp"
  done

  local d id st pinned ts epoch
  shopt -s nullglob
  for d in "$TASKS_DIR"/*/; do
    id="$(basename "$d")"
    # 只碰 send 生出來的形狀（UTC 時間戳 ＋ 4 hex），不是寬鬆的 TASK_ID_RE。
    # 這裡是唯一會刪東西的地方：公開驗證用的 TASK_ID_RE 連 `foo` 都算合法，
    # 拿它當刪除門檻，等於把任何人放進 tasks/ 的目錄都納入清理範圍。
    # 寧可漏掉幾個手工目錄，也不要讓一個不是我們生成的名字走進 rm 的參數。
    # （獨立複核 2026-07-23 指出契約定義不一致）
    [[ "$id" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$ ]] || continue
    [[ -f "$d/metadata.json" && -f "$d/status" ]] || continue

    st="$(<"$d/status")"
    case "$st" in
      completed|failed|cancelled) ;;
      *) kept_live=$((kept_live + 1)); continue ;;
    esac

    if (( include_notes == 0 )); then
      pinned="$(jq -r '.pinned // false' "$d/metadata.json" 2>/dev/null)" || pinned=true
      if [[ "$pinned" == true ]]; then
        kept_pin=$((kept_pin + 1)); continue
      fi
    fi

    # 用 metadata 的 created_at 而不是目錄 mtime：mtime 會被備份、rsync、
    # 檔案系統操作改掉，created_at 是這個任務自己的事實
    # 這個任務是不是某個現存宣告的「已失效證據」？是的話留著（見上方 pledge）
    local to_who
    to_who="$(jq -r '.to // ""' "$d/metadata.json" 2>/dev/null)" || to_who=""
    if [[ -n "$to_who" && -n "${pledge[$to_who]:-}" ]]; then
      local tts
      tts="$(jq -r '.created_at // ""' "$d/metadata.json" 2>/dev/null)" || tts=""
      if [[ -n "$tts" ]] && ! [[ "$tts" < "${pledge[$to_who]}" ]]; then
        kept_proof=$((kept_proof + 1)); continue
      fi
    fi

    ts="$(jq -r '.created_at // ""' "$d/metadata.json" 2>/dev/null)" || ts=""
    # 讀不到時間就當它還年輕：判不出年紀的東西不刪
    if [[ -z "$ts" ]] || ! epoch="$(date -u -d "$ts" +%s 2>/dev/null)"; then
      kept_young=$((kept_young + 1)); continue
    fi
    if (( epoch >= cutoff )); then
      kept_young=$((kept_young + 1)); continue
    fi

    if (( apply == 0 )); then
      printf '%s\t%s\t%s\n' "$id" "$st" "$ts"
      removed=$((removed + 1))
      continue
    fi

    # 取這個 task 的鎖再刪：狀態轉換都在同一把鎖下，不取就可能在 reply 寫到一半
    # 時把目錄抽走。整段包 subshell 有兩個理由：acquire_lock 取不到鎖是 die，
    # 直接呼叫會讓 gc 整支退出、剩下的目錄全不處理；而 subshell 內的 EXIT trap
    # 會自動釋放它自己那把鎖，不碰外層的 LOCK_DIR（單值，見 acquire_lock）
    local rc2=0
    (
      acquire_lock "$id" 2>/dev/null
      # 拿到鎖後重驗狀態：等鎖那段時間裡它可能已經被 receive／reply 動過
      case "$(<"$d/status")" in
        completed|failed|cancelled) rm -rf -- "$d" ;;
        *) exit 2 ;;
      esac
    ) || rc2=$?
    case $rc2 in
      0) removed=$((removed + 1)) ;;
      2) kept_live=$((kept_live + 1)) ;;
      *) failed=$((failed + 1)) ;;
    esac
  done

  if (( apply == 0 )); then
    info "gc（試算）：可刪 $removed 個；保留 未完成 $kept_live／收尾筆記 $kept_pin／宣告失效證據 $kept_proof／未滿 ${days} 天 $kept_young"
    info "確認無誤後加 --apply 才會真的刪除"
  else
    info "gc：已刪 $removed 個；保留 未完成 $kept_live／收尾筆記 $kept_pin／宣告失效證據 $kept_proof／未滿 ${days} 天 $kept_young"
    (( failed == 0 )) || err "警告：$failed 個目錄未能刪除（鎖被佔用或權限問題），下次再試"
  fi
}

cmd_idle() {
  (( $# == 0 )) || die "用法：agent-bridge idle（不接參數）"
  local now f base_name name spawned ready disp disp_at last_at ref base secs base_epoch
  now="$(date -u +%s)"
  shopt -s nullglob
  for f in "$AGENTS_DIR"/*.json; do
    base_name="$(basename "$f" .json)"
    # 損壞的 registry 不讓整份報表掛掉，但也不能靜靜跳過：它照樣佔著 cap，
    # orchestrator 必須看得到「這裡有個判不出狀態的東西」
    if ! jq -e 'type == "object"' "$f" >/dev/null 2>&1; then
      printf '%s\t%s\t%s\t%s\n' "$base_name" '?' '?' '-'
      continue
    fi
    name="$(jq -r '.name // ""' "$f")"
    [[ -n "$name" ]] || name="$base_name"
    spawned="$(jq -r 'if .spawned == true then "y" else "n" end' "$f")"
    ready="$(jq -r 'if .spawned == true
                    then (if .ready == true then "ready" else "starting" end)
                    else "-" end' "$f")"
    disp_at="$(jq -r 'if .disposable == true then (.disposable_at // "?") else "" end' "$f")"
    ref="$(jq -r '.spawned_at // .registered_at // ""' "$f")"
    last_at="$(last_task_at "$name")"

    # 人工註冊的 pane 不歸 bridge 管生命週期，一律 `-`：即使有人手動塞了
    # disposable 欄位，也不該讓它看起來可回收
    if [[ "$spawned" != y || -z "$disp_at" ]]; then
      disp="-"
    elif disposable_effective "$name" "$f"; then
      disp="yes"
    else
      disp="expired"
    fi

    # 取「最後任務」與「這個 pane 誕生」兩者較晚者。agent 名稱可以重用，而
    # last_task_at 只認名字不認 pane 實例：tasks/ 裡若留著同名前一個 worker 的
    # 任務，剛 spawn 的 worker 會繼承那個時間，在 idle 報表上看起來閒置了好幾
    # 小時，於是 LRU 優先驅逐一個其實還沒做過事的新 pane。閒置時間不該早於
    # 誕生時間。（真鏈驗收 2026-07-22 實地踩到）
    base="$last_at"
    if [[ -z "$base" || ( -n "$ref" && "$ref" > "$base" ) ]]; then
      base="$ref"
    fi
    secs="-"
    if [[ -n "$base" ]] && base_epoch="$(date -u -d "$base" +%s 2>/dev/null)"; then
      secs=$(( now - base_epoch ))
      (( secs < 0 )) && secs=0
    fi
    printf '%s\t%s\t%s\t%s\n' "$name" "$ready" "$disp" "$secs"
  done
}

# evict：撞 cap 時的驅逐，但**不是直接殺**——先派一輪收尾任務，讓 worker 把
# 只存在於它 context 裡、response 之外的關鍵事實寫下來，落地之後才 despawn。
# 上下文不會憑空消失，這是「預設保留」語意在 cap 壓力下的補償機制。
#
# 三步（send → await → despawn）刻意**不包在一把鎖裡**：LOCK_DIR 是單值
# （見 acquire_lock），同時持有兩把鎖時 release_lock 只會放掉一把，留下一把
# 沒人知道存在的鎖擋住之後每一次同類操作。分段的代價是每段之間都可能被中斷，
# 失效方向分別是：
#   send 後中斷  → 多一個沒人收的收尾 task（status 看得見），pane 仍在
#   await 後中斷 → 筆記已落地、pane 沒收掉，最壞多佔一個 cap（可再 evict）
# 兩個方向都不會刪掉還沒落地的脈絡——這是分段時唯一不可接受的失效。
#
# **逾時仍然 despawn**：否則一個不回話的 worker 會把 cap 永久卡死，驅逐機制
# 直接失效。代價是筆記沒落地，所以審計線一定要看得出來（evicted-timeout），
# 而不是混在正常的 evicted 裡。
cmd_evict() {
  (( $# >= 1 )) || die "用法：agent-bridge evict <name> [--timeout <secs>] [--from <sender>]"
  local name="$1"; shift
  local timeout=300 from="orchestrator"
  while (( $# > 0 )); do
    case "$1" in
      --timeout)
        shift; (( $# > 0 )) || die "--timeout 需要參數"
        # 同 await：10# 強制十進位，位數上限擋 64 位算術溢位
        [[ "$1" =~ ^[0-9]{1,9}$ ]] || die "--timeout 需為非負整數（秒，至多 9 位），0＝不逾時：$1"
        timeout=$((10#$1)) ;;
      --from)
        shift; (( $# > 0 )) || die "--from 需要參數"
        from="$1" ;;
      *) die "未知參數：$1" ;;
    esac
    shift
  done
  [[ "$name" =~ $NAME_RE ]] || die "agent 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$name"
  [[ "$from" =~ $NAME_RE ]] || die "sender 名稱不合法（僅允許 [A-Za-z0-9_-]+）：$from"

  # 出身快檢（不取鎖）：純 fail-fast，避免對人工註冊的 agent 送出一個之後
  # 必定被 despawn 拒絕、沒人回收的孤兒收尾任務。權威判定仍在 cmd_despawn 的
  # 鎖內（TOCTOU 歸它負責）——這裡放行不代表最後一定收得掉
  local f="$AGENTS_DIR/$name.json"
  [[ -f "$f" ]] || die "未註冊的 agent：$name"
  local sp_rc=0
  is_spawned "$f" || sp_rc=$?
  case $sp_rc in
    1) die "agent '$name' 非 spawn 出身，evict 拒絕（人工 pane 的生命週期不歸 bridge 管，請用 unregister）" ;;
    2) die "agent '$name' 的 registry 無法解析，出身不明，evict 拒絕；請確認 $f 後手動處理" ;;
  esac

  # pane/runtime 在 despawn 前取：despawn 會刪掉 registry，之後就讀不到了
  local pane runtime
  pane="$(jq -r '.pane_id // "-"' "$f")"
  runtime="$(jq -r '.runtime // "-"' "$f")"
  # 記下這一代的 spawn_tag，最後 despawn 時綁定比對（見 cmd_despawn 的
  # DESPAWN_EXPECT_TAG 段）：收尾任務是派給「這一代」的，回收也只能收這一代
  # tag 空的話 despawn 那邊的 generation 比對會整條被跳過（見 DESPAWN_EXPECT_TAG），
  # 綁定等於沒有。正常 spawn 一定寫得出 tag，取不到代表 registry 被動過——這時
  # 拒絕動作，而不是帶著一個失效的綁定往下走。（獨立複核 2026-07-23 指出）
  local gen_tag
  gen_tag="$(jq -r '.spawn_tag // ""' "$f")"
  [[ -n "$gen_tag" ]] \
    || die "agent '$name' 的 registry 沒有 spawn_tag，無法鎖定世代，evict 拒絕；請確認 $f 後手動處理"

  # 收尾任務的文案硬編在這裡而不是抽到 share/：它是機制的一部分（「把只存在於
  # 你 context 裡的事實寫下來」），不是可調策略。抽成檔案會多一條「檔案不存在
  # 怎麼辦」的失敗路徑，而那條路徑一旦失敗，等於整個筆記機制悄悄消失
  local msg
  msg="$(cat <<'EOF'
【收尾任務 — 這是你在被回收前的最後一輪】

這個 pane 即將被回收，你的 context 會一併消失。請把「只存在於你 context 裡、
先前 response 沒寫進去」的關鍵事實，用 reply 寫成一份筆記交回來。

要寫的：
- 你查到但沒寫進之前回覆的事實（含 file:line、指令、實測數字）
- 走過的死路與原因（讓下一棒不必重走）
- 未解的疑問、你當時的假設，以及哪些結論其實只是推測

不要寫的：
- 覆述已經在 response 裡的內容
- 重新開工。這一輪只做整理，不要開始新的調查

寫完請執行 agent-bridge reply <task-id> --message-file <path>（或 --message）。
沒有值得留下的東西也請照樣 reply，寫一行「無殘值」即可——沒有回覆會被記成
筆記未落地。
EOF
)"

  # 收尾任務 pin 住：它裝的是「只存在 worker context 裡」的事實，被 gc 清掉的話
  # 這一層對「上下文不會憑空消失」的承諾就只是延後兌現
  local task_id
  SEND_PIN=1
  task_id="$(cmd_send "$name" --from "$from" --message "$msg")" \
    || { SEND_PIN=""; die "evict 中止：收尾任務送不出去，未動 pane（agent '$name' 仍在）"; }
  SEND_PIN=""
  info "evict：收尾任務 $task_id 已派給 '$name'，等待筆記落地（timeout ${timeout}s）"

  # cmd_await 逾時是 die。直接呼叫會讓 evict 整支跟著退出、跳過 despawn，
  # cap 就被一個不回話的 worker 永久卡死。包 subshell 讓 die 只殺得掉那一層
  local final_st=""
  final_st="$( cmd_await "$task_id" --timeout "$timeout" )" || final_st=""

  local outcome
  case "$final_st" in
    completed) outcome=evicted ;;
    # failed/cancelled 也是 await 的正常返回，不是逾時。全記成 evicted-timeout
    # 會讓審計線說謊——「筆記沒落地」的原因不同，追查方向也不同
    failed|cancelled) outcome=evicted-unfinished ;;
    *) outcome=evicted-timeout ;;
  esac

  DESPAWN_EXPECT_TAG="$gen_tag"
  DESPAWN_NOTES_HANDLED=1
  DESPAWN_RESULT=""
  cmd_despawn "$name"
  DESPAWN_EXPECT_TAG=""
  DESPAWN_NOTES_HANDLED=""

  # stale＝registry 清掉了，但那個 pane 還活著、已經不屬於這個 agent。它沒有被
  # 回收，所以不能記 evicted*——despawn 自己已經記過 despawn-stale，再補一筆
  # evicted 只會讓審計線宣稱發生過一次沒發生的回收。（獨立複核 2026-07-23 指出）
  if [[ "$DESPAWN_RESULT" == stale ]]; then
    err "警告：agent '$name' 的註冊已清除，但 pane $pane 已不屬於它、未被回收；收尾任務 $task_id（$final_st）請自行判讀"
    printf '%s\n' "$task_id"
    return 0
  fi
  # 記在 despawn 成功之後：despawn 失敗代表 pane 還在、根本沒被驅逐，
  # 這時寫一筆 evicted 進審計線就是假紀錄
  log_agent_event "$outcome" "$name" "$pane" "$runtime"
  case "$outcome" in
    evicted)
      info "已 evict agent '$name'；收尾筆記可用：agent-bridge read $task_id" ;;
    evicted-unfinished)
      err "警告：收尾任務 $task_id 以 $final_st 結束，筆記未落地；agent '$name' 仍已回收" ;;
    *)
      err "警告：收尾任務 $task_id 逾時（${timeout}s）未回覆，筆記未落地；agent '$name' 仍已回收（避免 cap 卡死）" ;;
  esac
  printf '%s\n' "$task_id"
}

main() {
  if (( $# == 0 )); then
    usage
    exit 1
  fi
  local cmd="$1"; shift
  case "$cmd" in
    -h|--help|help)
      usage
      return 0
      ;;
  esac
  require_jq
  ensure_dirs
  case "$cmd" in
    register)   cmd_register "$@" ;;
    unregister) cmd_unregister "$@" ;;
    list)       cmd_list "$@" ;;
    send)       cmd_send "$@" ;;
    receive)    cmd_receive "$@" ;;
    start)      cmd_start "$@" ;;
    reply)      cmd_reply "$@" ;;
    fail)       cmd_fail "$@" ;;
    cancel)     cmd_cancel "$@" ;;
    status)     cmd_status "$@" ;;
    read)       cmd_read "$@" ;;
    await)      cmd_await "$@" ;;
    spawn)      cmd_spawn "$@" ;;
    relay)      cmd_relay "$@" ;;
    despawn)    cmd_despawn "$@" ;;
    ready)      cmd_ready "$@" ;;
    disposable) cmd_disposable "$@" ;;
    idle)       cmd_idle "$@" ;;
    evict)      cmd_evict "$@" ;;
    gc)         cmd_gc "$@" ;;
    *)
      usage
      die "未知指令：$cmd"
      ;;
  esac
}

main "$@"
