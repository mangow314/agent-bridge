#!/usr/bin/env bash
# agent-bridge — 指向 Rust 實作的 exec shim（M4 cutover）。
#
# 為什麼是 shim 而不是把執行檔本身放進 bin/：執行檔是 build 產物、不進版控，
# 而 `bin/agent-bridge` 這個路徑是對外契約（~/.local/bin/agent-bridge 是它的
# symlink，spawn 出去的 pane 也照這個名字呼叫）。shim 讓路徑穩定、產物可換。
#
# 執行檔必須落在 `bin/`：Rust 側 repo_root 取 `dirname(dirname(current_exe))`
# （對齊 bash 的 REPO_ROOT 推導），share/ 的預設 brief 路徑由它反推。exec 之後
# /proc/self/exe 就是 bin/ab，祖父層＝repo 根，share/ 才找得到。
# 從 target/release/ 直接跑會把 root 算成 target/——M3 的 .gate/ staging 正是
# 為了繞開這件事，cutover 後那層可以退場。
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
REPO_ROOT="$(dirname "$(dirname "$SCRIPT_PATH")")"
AB="$REPO_ROOT/bin/ab"

# 缺產物時大聲失敗（exit 127＋建置提示），不靜默降級：入口沉默地做別的事，
# 比直接壞掉更難查。
if [[ ! -x "$AB" ]]; then
  printf 'agent-bridge: 找不到執行檔 %s\n' "$AB" >&2
  printf '  先建置：cargo build --release && cp -f target/release/ab bin/ab\n' >&2
  exit 127
fi

exec "$AB" "$@"
